@page "/audio-processing-settings"
@inject AudioProcessingSettingsService SettingsService
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5">
    <MudText Typo="Typo.h4">Audio Processing</MudText>
</MudStack>

<MudCard Outlined="true" Class="mb-5">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">ffmpeg</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Path to the ffmpeg executable used by the audio post-processing pipeline.
            Leave blank to rely on the system PATH.
        </MudText>
        <MudTextField @bind-Value="_ffmpegPathDraft"
                      Label="ffmpeg path" Variant="Variant.Outlined"
                      Immediate="true" Placeholder="(blank = rely on PATH)" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveFfmpegPathAsync">Save</MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Check"
                   Disabled="@_testing"
                   OnClick="TestFfmpegAsync">
            @(_testing ? "Testing…" : "Test ffmpeg")
        </MudButton>
        @if (_testing)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
        }
    </MudCardActions>
</MudCard>

<MudCard Outlined="true" Class="mb-5">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Chunk pause</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Silence inserted between stitched audio chunks of a paragraph.
        </MudText>
        <MudNumericField @bind-Value="_chunkPauseMsDraft"
                         Label="Pause between chunks (ms)" Variant="Variant.Outlined"
                         Min="0" Step="50" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveChunkPauseAsync">Save</MudButton>
    </MudCardActions>
</MudCard>

<MudCard Outlined="true" Class="mb-5">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Pause durations</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Silence inserted between sections during audiobook assembly. Each kind maps to a
            millisecond duration.
        </MudText>
        <MudNumericField @bind-Value="_volumePauseMsDraft"
                         Label="Volume pause (ms)" Variant="Variant.Outlined"
                         Min="0" Step="100" Class="mb-3" />
        <MudNumericField @bind-Value="_partPauseMsDraft"
                         Label="Part pause (ms)" Variant="Variant.Outlined"
                         Min="0" Step="100" Class="mb-3" />
        <MudNumericField @bind-Value="_chapterPauseMsDraft"
                         Label="Chapter pause (ms)" Variant="Variant.Outlined"
                         Min="0" Step="100" Class="mb-3" />
        <MudNumericField @bind-Value="_paragraphPauseMsDraft"
                         Label="Paragraph pause (ms)" Variant="Variant.Outlined"
                         Min="0" Step="50" Class="mb-3" />
        <MudNumericField @bind-Value="_pauseMsDraft"
                         Label="Pause (ms)" Variant="Variant.Outlined"
                         Min="0" Step="50" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SavePauseDurationsAsync">Save</MudButton>
    </MudCardActions>
</MudCard>

<MudCard Outlined="true" Class="mb-5">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Transcript verification</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Word-error-rate threshold below which a generated clip passes verification.
        </MudText>
        <MudNumericField @bind-Value="_werThresholdDraft"
                         Label="WER threshold" Variant="Variant.Outlined"
                         Min="0" Max="1" Step="0.01" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveWerThresholdAsync">Save</MudButton>
    </MudCardActions>
</MudCard>

<MudCard Outlined="true" Class="mb-5">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Max audio attempts</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Total generation attempts per item, including the first. 1 = no retry.
        </MudText>
        <MudNumericField @bind-Value="_audioMaxAttemptsDraft"
                         Label="Max audio attempts" Variant="Variant.Outlined"
                         Min="1" Step="1" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAudioMaxAttemptsAsync">Save</MudButton>
    </MudCardActions>
</MudCard>

@code {
    string _ffmpegPathDraft = "";
    double _werThresholdDraft = AudioProcessingSettingsService.DefaultWerThreshold;
    int _chunkPauseMsDraft = AudioProcessingSettingsService.DefaultChunkPauseMs;
    int _volumePauseMsDraft = AudioProcessingSettingsService.DefaultVolumePauseMs;
    int _partPauseMsDraft = AudioProcessingSettingsService.DefaultPartPauseMs;
    int _chapterPauseMsDraft = AudioProcessingSettingsService.DefaultChapterPauseMs;
    int _paragraphPauseMsDraft = AudioProcessingSettingsService.DefaultParagraphPauseMs;
    int _pauseMsDraft = AudioProcessingSettingsService.DefaultPauseMs;
    int _audioMaxAttemptsDraft = AudioProcessingSettingsService.DefaultAudioMaxAttempts;
    bool _testing;

    protected override async Task OnInitializedAsync()
    {
        SettingsService.OnChanged += HandleChanged;
        await LoadAsync();
    }

    void HandleChanged() => InvokeAsync(LoadAsync);

    async Task LoadAsync()
    {
        var settings = await SettingsService.GetAsync();
        _ffmpegPathDraft = settings.FfmpegPath ?? "";
        _werThresholdDraft = settings.WerThreshold;
        _chunkPauseMsDraft = settings.ChunkPauseMs;
        _volumePauseMsDraft = settings.VolumePauseMs;
        _partPauseMsDraft = settings.PartPauseMs;
        _chapterPauseMsDraft = settings.ChapterPauseMs;
        _paragraphPauseMsDraft = settings.ParagraphPauseMs;
        _pauseMsDraft = settings.PauseMs;
        _audioMaxAttemptsDraft = settings.AudioMaxAttempts;
        StateHasChanged();
    }

    async Task SaveFfmpegPathAsync()
    {
        await SettingsService.SetFfmpegPathAsync(_ffmpegPathDraft);
        Snackbar.Add("ffmpeg path saved.", Severity.Success);
    }

    async Task SaveWerThresholdAsync()
    {
        if (_werThresholdDraft < 0 || _werThresholdDraft > 1)
        {
            Snackbar.Add("WER threshold must be between 0 and 1.", Severity.Error);
            return;
        }
        await SettingsService.SetWerThresholdAsync(_werThresholdDraft);
        Snackbar.Add("WER threshold saved.", Severity.Success);
    }

    async Task SaveChunkPauseAsync()
    {
        if (_chunkPauseMsDraft < 0)
        {
            Snackbar.Add("Pause must be zero or greater.", Severity.Error);
            return;
        }
        await SettingsService.SetChunkPauseAsync(_chunkPauseMsDraft);
        Snackbar.Add("Chunk pause saved.", Severity.Success);
    }

    async Task SavePauseDurationsAsync()
    {
        await SettingsService.SetPauseDurationsAsync(
            _volumePauseMsDraft, _partPauseMsDraft, _chapterPauseMsDraft,
            _paragraphPauseMsDraft, _pauseMsDraft);
        Snackbar.Add("Pause durations saved.", Severity.Success);
    }

    async Task SaveAudioMaxAttemptsAsync()
    {
        await SettingsService.SetAudioMaxAttemptsAsync(_audioMaxAttemptsDraft);
        Snackbar.Add("Max audio attempts saved.", Severity.Success);
    }

    async Task TestFfmpegAsync()
    {
        _testing = true;
        StateHasChanged();
        try
        {
            // Probe the path currently in the field, persisting it first so the probe matches the UI.
            await SettingsService.SetFfmpegPathAsync(_ffmpegPathDraft);
            var result = await SettingsService.TestFfmpegAsync();
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        }
        finally
        {
            _testing = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        SettingsService.OnChanged -= HandleChanged;
    }
}
