@page "/llm-settings"
@using System.Threading
@inject LlmSettingsService SettingsService
@inject ILlmCompletionRunner CompletionRunner
@inject Read2Me.Services.Events.EventBroadcaster<LlmStreamEvent> LlmEvents
@inject ThroughputAggregator Throughput
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5">
    <MudText Typo="Typo.h4">LLM Settings</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog">
        New Configuration
    </MudButton>
</MudStack>

@if (_configs == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_configs.Count == 0)
{
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        No LLM configurations yet. Create one to get started.
    </MudText>
}
else
{
    <MudGrid>
        @foreach (var config in _configs)
        {
            var c = config;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true">
                    <MudCardContent Class="pb-0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@c.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@c.ApiType</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@c.BaseUrl</MudText>
                        @if (!string.IsNullOrWhiteSpace(c.Model))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Model: @c.Model</MudText>
                        }
                        <DockerServiceControls BaseUrl="@c.BaseUrl" />
                    </MudCardContent>
                    <MudCardActions>
                        @if (_activeConfigId == c.Id)
                        {
                            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle"
                                     Size="Size.Small" Variant="Variant.Filled">Default</MudChip>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       OnClick="() => SelectConfigAsync(c.Id)">Make default</MudButton>
                        }
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenEditDialog(c)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="() => DeleteConfigAsync(c.Id)" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@if (_configs is { Count: > 0 })
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-6">
        The <b>default</b> configuration is used for voice prompts, AI book edits and character discovery.
        Character attribution uses the attribution chain below instead.
    </MudText>
    <AttributionEscalationPanel />
}

@if (_activeConfig != null)
{
    <MudPaper Class="pa-4 mt-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-3">Test "@_activeConfig.Name"</MudText>
        <MudTextField @bind-Value="_prompt" Label="Prompt" Variant="Variant.Outlined"
                      Lines="3" Class="mb-3" Disabled="_streaming" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="SendAsync"
                       Disabled="@(_streaming || string.IsNullOrWhiteSpace(_prompt))">
                Send
            </MudButton>
            @if (_streaming)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Stop" OnClick="Stop">
                    Stop
                </MudButton>
            }
        </MudStack>

        @* One pull per paint, shared by the headline, the subscript and the table, so the three
           can never report different moments of the same run. *@
        @{
            var throughput = Throughput.Snapshot;
        }
        @* Run Throughput is the headline here exactly as everywhere else. A test send is a
           Throughput Run of one, so it restates the request's own rate — that redundancy is kept
           deliberately: special-casing it would make this page the one surface displaying a
           different figure from the rest of the app (decision 04). *@
        <MudText Typo="Typo.h5" Style="@ThroughputText.StyleFor(throughput.RunThroughput)">
            @ThroughputText.Rate(throughput.RunThroughput)
        </MudText>
        <MudText Typo="Typo.caption" Style="opacity:0.6;">
            <GenerationRateSubscript Snapshot="throughput" />
        </MudText>
        <ThroughputByConfigTable Snapshot="throughput" />

        <div style="height:40vh;" class="mt-3">
            <LlmStreamView ShowThroughput="false" />
        </div>
    </MudPaper>
}

@code {
    List<LlmServerConfig>? _configs;
    int? _activeConfigId;
    LlmServerConfig? _activeConfig;

    string _prompt = "";
    bool _streaming;
    CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        SettingsService.OnChanged += HandleChanged;
        // This page's paint cadence for the throughput figures, and the one it had before it moved
        // onto the completion runner. The aggregator raises no event and is never subscribed to —
        // the figures are pulled from the snapshot during a repaint the stream already drives.
        LlmEvents.Event += HandleStreamEvent;
        await LoadAsync();
    }

    void HandleChanged() => InvokeAsync(LoadAsync);

    void HandleStreamEvent(LlmStreamEvent e) => InvokeAsync(StateHasChanged);

    async Task LoadAsync()
    {
        _configs = await SettingsService.GetAllConfigsAsync();
        _activeConfigId = await SettingsService.GetActiveConfigIdAsync();
        _activeConfig = _activeConfigId is { } id ? _configs.FirstOrDefault(c => c.Id == id) : null;
        StateHasChanged();
    }

    async Task SelectConfigAsync(int configId)
    {
        await SettingsService.SetActiveConfigAsync(configId);
        await LoadAsync();
        Snackbar.Add("Configuration applied", Severity.Success);
    }

    static readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    async Task OpenAddDialog()
    {
        var dialog = await DialogService.ShowAsync<LlmServerConfigDialog>("New Configuration", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: LlmServerConfig saved })
        {
            await SettingsService.CreateConfigAsync(saved);
            await LoadAsync();
            Snackbar.Add("Configuration created", Severity.Success);
        }
    }

    async Task OpenEditDialog(LlmServerConfig config)
    {
        var dialog = await DialogService.ShowAsync<LlmServerConfigDialog>(
            "Edit Configuration",
            new DialogParameters<LlmServerConfigDialog> { { x => x.Config, config } },
            _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: LlmServerConfig saved })
        {
            await SettingsService.UpdateConfigAsync(saved);
            await LoadAsync();
            Snackbar.Add("Configuration updated", Severity.Success);
        }
    }

    async Task DeleteConfigAsync(int configId)
    {
        await SettingsService.DeleteConfigAsync(configId);
        await LoadAsync();
        Snackbar.Add("Configuration deleted", Severity.Info);
    }

    async Task SendAsync()
    {
        if (_activeConfig == null) return;

        _streaming = true;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        // A test send is a Throughput Run of one — deliberately, so this page shows the same
        // headline as every other surface rather than a figure of its own.
        LlmEvents.Publish(new RunStarted());
        try
        {
            // Streaming text, thinking and per-request stats all render from the LLM event
            // bus via LlmStreamView — the runner publishes them; this page only starts the run.
            var result = await CompletionRunner.RunAsync(
                new LlmRunRequest(_activeConfig, _prompt, $"Test send — {_activeConfig.Name}",
                    Shape: CompletionShape.None),
                _cts.Token);

            if (result.Outcome != LlmRunOutcome.Completed)
                Snackbar.Add($"Request failed: {result.Error}", Severity.Error);
        }
        catch (OperationCanceledException)
        {
            // User stopped the stream — keep whatever was received.
        }
        finally
        {
            LlmEvents.Publish(new RunEnded());
            _streaming = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    void Stop() => _cts?.Cancel();

    public void Dispose()
    {
        SettingsService.OnChanged -= HandleChanged;
        LlmEvents.Event -= HandleStreamEvent;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
