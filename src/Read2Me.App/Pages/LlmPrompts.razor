@page "/llm-prompts"
@using Read2Me.Services.Characters
@inject LlmPromptService PromptService
@inject ISnackbar Snackbar
@implements IDisposable

<MudText Typo="Typo.h4" Class="mb-6">LLM Prompts</MudText>

@if (_characterPrompt == null || _batchCharacterPrompt == null || _simpleCharacterPrompt == null || _simpleBatchCharacterPrompt == null || _voicePrompt == null || _voicePlanPrompt == null || _narratorVoicePlanPrompt == null || _discoverCharactersPrompt == null || _attributionCompatibility == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* Book Character Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Book Character Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Sent to the LLM to identify which character speaks each item of a paragraph, and how the line should be voiced.
        </MudText>

        @if (_attributionCompatibility.CharacterPromptMissingNarratorIdentity)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.Warning" Class="mb-3">
                @("Stored override missing {{" + PromptTemplates.NarratorIdentity + "}}")
            </MudChip>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _fullCharacterTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_characterPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            <code>{{narrator_identity}}</code> renders empty unless the book has a narrator link.
        </MudText>

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@ItemAttributionSchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderCharacterPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveCharacterPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetCharacterPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Batch Character Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Batch Character Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Used instead of the single-paragraph prompt when the active LLM server's "Paragraphs per request" is greater than 1.
            Attributes several indexed paragraphs in one request.
        </MudText>

        @if (_attributionCompatibility.BatchCharacterPromptMissingNarratorIdentity)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.Warning" Class="mb-3">
                @("Stored override missing {{" + PromptTemplates.NarratorIdentity + "}}")
            </MudChip>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _fullCharacterTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_batchCharacterPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            <code>{{narrator_identity}}</code> renders empty unless the book has a narrator link.
        </MudText>

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@ItemBatchAttributionSchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderBatchCharacterPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveBatchCharacterPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetBatchCharacterPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Simple Character Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Simple Character Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Used instead of the Book Character Prompt when the LLM server's prompt style is "Simple". Assigns a speaker
            only when the text explicitly names one, so small models answer "unknown" instead of guessing and the
            escalation chain hands the paragraph to a larger model.
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _characterTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_simpleCharacterPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@ItemAttributionSchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderSimpleCharacterPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveSimpleCharacterPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetSimpleCharacterPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Simple Batch Character Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Simple Batch Character Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            The batch form of the Simple Character Prompt. Used when a "Simple" LLM server's
            "Paragraphs per request" is greater than 1.
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _characterTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_simpleBatchCharacterPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@ItemBatchAttributionSchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderSimpleBatchCharacterPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveSimpleBatchCharacterPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetSimpleBatchCharacterPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Character Voice Plan Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Character Voice Plan Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Sent to the LLM by "Generate voice prompts" for each character without voices. Expects a JSON array of all
            the voices the character needs — each with a name, a description (including where in the book it applies)
            and a voice-design prompt.
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _characterVoicePlanTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_voicePlanPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            <code>{{also_narrates}}</code> renders empty unless this character has the book's narrator link.
        </MudText>

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@VoicePlanSchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderVoicePlanPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveVoicePlanPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetVoicePlanPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Narrator Voice Plan Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Narrator Voice Plan Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Used instead of the character voice-plan prompt when "Generate voice prompts" runs for the narrator.
            Asks for one steady narration voice, never a set of per-character voices. Expects the same JSON array shape.
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _voicePlanTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_narratorVoicePlanPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@VoicePlanSchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderNarratorVoicePlanPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveNarratorVoicePlanPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetNarratorVoicePlanPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Discover Characters Prompt *@
    <MudPaper Class="pa-5 mb-6" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Discover Characters Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Sent to the default LLM by "Discover characters" on the Characters tab. Asks for the book's notable
            characters and their aliases as a JSON list, using the title, author and chapter outline.
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _discoverCharactersTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_discoverCharactersPrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="14" Class="mb-3" />

        <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Expected response (JSON) — displayed for reference, not editable:</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@CharacterDiscoverySchema.JsonExample</MudText>
        </MudPaper>

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderDiscoverCharactersPreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveDiscoverCharactersPromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetDiscoverCharactersPromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Character Voice Prompt *@
    <MudPaper Class="pa-5" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Character Voice Prompt</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Sent to the LLM to generate a voice-design prompt for a single existing voice (per-voice regenerate on the
            character detail panel). Expects a single plain-text response.
        </MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Available tokens:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var token in _voiceTokens)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@("{{" + token + "}}")</MudChip>
            }
        </MudStack>

        <MudTextField @bind-Value="_voicePrompt" Label="Prompt template" Variant="Variant.Outlined"
                      Lines="10" Class="mb-3" />

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Preview with sample values">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace;">@RenderVoicePreview()</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveVoicePromptAsync">
                Save
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetVoicePromptAsync">
                Reset to default
            </MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    string? _characterPrompt;
    string? _batchCharacterPrompt;
    string? _simpleCharacterPrompt;
    string? _simpleBatchCharacterPrompt;
    string? _voicePrompt;
    string? _voicePlanPrompt;
    string? _narratorVoicePlanPrompt;
    string? _discoverCharactersPrompt;
    AttributionPromptCompatibility? _attributionCompatibility;

    static readonly string[] _characterTokens =
    [
        PromptTemplates.BookTitle,
        PromptTemplates.BookAuthor,
        PromptTemplates.KnownCharacters,
        PromptTemplates.ContextJson,
        PromptTemplates.ResponseFormat,
    ];

    static readonly string[] _fullCharacterTokens =
    [
        .. _characterTokens,
        PromptTemplates.NarratorIdentity,
    ];

    static readonly string[] _voiceTokens =
    [
        PromptTemplates.BookTitle,
        PromptTemplates.BookAuthor,
        PromptTemplates.CharacterName,
    ];

    static readonly string[] _voicePlanTokens =
    [
        PromptTemplates.BookTitle,
        PromptTemplates.BookAuthor,
        PromptTemplates.CharacterName,
        PromptTemplates.ResponseFormat,
    ];

    static readonly string[] _characterVoicePlanTokens =
    [
        .. _voicePlanTokens,
        PromptTemplates.AlsoNarrates,
    ];

    static readonly string[] _discoverCharactersTokens =
    [
        PromptTemplates.BookTitle,
        PromptTemplates.BookAuthor,
        PromptTemplates.BookOutline,
        PromptTemplates.KnownCharacters,
        PromptTemplates.ResponseFormat,
    ];

    // Same rule as the context samples below: the roster is serialized by the real projection, so
    // the preview cannot show a shape the request does not send (a bare name array, as it once did).
    static readonly string _sampleRoster = PromptTemplates.BuildKnownCharactersJson([
        new PromptTemplates.RosterCharacter("Bilbo", ["Mr. Baggins", "the hobbit"]),
        new PromptTemplates.RosterCharacter("Gandalf", ["the wizard"]),
        new PromptTemplates.RosterCharacter("Thorin", []),
    ]);

    // The {{context_json}} previews are serialized by the same builders the real request uses, so a
    // change to the wire shape cannot leave a stale example on this page. Only the book text here is
    // invented; item ids are irrelevant to the rendering and never reach the model.
    static ContextItem Narration(string text) =>
        new(Guid.Empty, text, AttributionWire.Narration, AttributionWire.Narrator);

    static ContextItem Dialog(string text, string speaker) =>
        new(Guid.Empty, text, AttributionWire.Dialog, speaker);

    static ContextParagraph Paragraph(params ContextItem[] items) =>
        new(string.Concat(items.Select(i => i.Text)), items);

    static readonly ContextParagraph _sampleRoad =
        Paragraph(Narration("The road goes ever on and on, down from the door where it began."));

    static readonly ContextParagraph _sampleGandalf =
        Paragraph(Dialog("\"You are a very fine person, Mr. Baggins,\"", "Gandalf"),
                  Narration(" said Gandalf."));

    static readonly ContextParagraph _sampleQuery =
        Paragraph(Dialog("\"I'm going on an adventure!\"", AttributionWire.Unknown),
                  Narration(" he cried."));

    static readonly ContextParagraph _sampleWestering =
        Paragraph(Narration("He paused and looked back. The sun was already westering."));

    static readonly ContextParagraph _sampleSettled =
        Paragraph(Dialog("\"Then it is settled,\"", AttributionWire.Unknown),
                  Narration(" said the dwarf."));

    static readonly ParagraphContext _sampleContext =
        new(_sampleQuery, [_sampleRoad, _sampleGandalf], [_sampleWestering]);

    static readonly ParagraphBatchContext _sampleBatchContext =
        new([
            new BatchContextEntry(_sampleRoad.Text, _sampleRoad.Items, null),
            new BatchContextEntry(_sampleGandalf.Text, _sampleGandalf.Items, null),
            new BatchContextEntry(_sampleQuery.Text, _sampleQuery.Items, 0),
            new BatchContextEntry(_sampleWestering.Text, _sampleWestering.Items, null),
            new BatchContextEntry(_sampleSettled.Text, _sampleSettled.Items, 1),
        ], [], []);

    static readonly IReadOnlyDictionary<string, string> _sampleValues =
        new Dictionary<string, string>
        {
            [PromptTemplates.BookTitle]       = "The Hobbit",
            [PromptTemplates.BookAuthor]      = "J.R.R. Tolkien",
            [PromptTemplates.KnownCharacters] = _sampleRoster,
            [PromptTemplates.ContextJson]     = PromptTemplates.BuildContextJson(_sampleContext),
            [PromptTemplates.CharacterName]   = "Gandalf",
            [PromptTemplates.ResponseFormat]  = ItemAttributionSchema.JsonExample,
            [PromptTemplates.NarratorIdentity] =
                NarratorPromptText.IdentityParagraph("Bilbo"),
        };

    static readonly IReadOnlyDictionary<string, string> _batchSampleValues =
        new Dictionary<string, string>(_sampleValues)
        {
            [PromptTemplates.ContextJson]     = PromptTemplates.BuildBatchContextJson(_sampleBatchContext),
            [PromptTemplates.ResponseFormat]  = ItemBatchAttributionSchema.JsonExample,
        };

    protected override async Task OnInitializedAsync()
    {
        PromptService.OnChanged += HandleChanged;
        await LoadAsync();
    }

    void HandleChanged() => InvokeAsync(LoadAsync);

    async Task LoadAsync()
    {
        _characterPrompt = await PromptService.GetCharacterPromptAsync(AttributionPromptStyle.Full);
        _batchCharacterPrompt = await PromptService.GetBatchCharacterPromptAsync(AttributionPromptStyle.Full);
        _simpleCharacterPrompt = await PromptService.GetCharacterPromptAsync(AttributionPromptStyle.Simple);
        _simpleBatchCharacterPrompt = await PromptService.GetBatchCharacterPromptAsync(AttributionPromptStyle.Simple);
        _voicePrompt = await PromptService.GetVoicePromptAsync();
        _voicePlanPrompt = await PromptService.GetVoicePlanPromptAsync();
        _narratorVoicePlanPrompt = await PromptService.GetNarratorVoicePlanPromptAsync();
        _discoverCharactersPrompt = await PromptService.GetDiscoverCharactersPromptAsync();
        _attributionCompatibility = await PromptService.GetAttributionPromptCompatibilityAsync();
        StateHasChanged();
    }

    string RenderCharacterPreview() =>
        _characterPrompt is null ? string.Empty : PromptTemplates.Render(_characterPrompt, _sampleValues);

    string RenderBatchCharacterPreview() =>
        _batchCharacterPrompt is null ? string.Empty : PromptTemplates.Render(_batchCharacterPrompt, _batchSampleValues);

    string RenderSimpleCharacterPreview() =>
        _simpleCharacterPrompt is null ? string.Empty : PromptTemplates.Render(_simpleCharacterPrompt, _sampleValues);

    string RenderSimpleBatchCharacterPreview() =>
        _simpleBatchCharacterPrompt is null ? string.Empty : PromptTemplates.Render(_simpleBatchCharacterPrompt, _batchSampleValues);

