@code {
    string? _characterPrompt;
    string? _batchCharacterPrompt;
    string? _simpleCharacterPrompt;
    string? _simpleBatchCharacterPrompt;
    string? _voicePrompt;
    string? _voicePlanPrompt;
    string? _narratorVoicePlanPrompt;
    string? _discoverCharactersPrompt;
    AttributionPromptCompatibility? _attributionCompatibility;

    // Tokens and sample values are the catalog's (PromptCatalog / PromptPreviewSamples), shared
    // with the Angular page and the agent API, so both UIs preview the same book.
    static IReadOnlyList<string> TokensOf(string kind) => PromptCatalog.Find(kind)!.Tokens;


    static readonly IReadOnlyDictionary<string, string> _sampleValues = PromptPreviewSamples.Character;
    static readonly IReadOnlyDictionary<string, string> _batchSampleValues = PromptPreviewSamples.BatchCharacter;
    static readonly IReadOnlyDictionary<string, string> _voicePlanSampleValues = PromptPreviewSamples.VoicePlan;
    static readonly IReadOnlyDictionary<string, string> _narratorVoicePlanSampleValues = PromptPreviewSamples.NarratorVoicePlan;
    static readonly IReadOnlyDictionary<string, string> _discoverCharactersSampleValues = PromptPreviewSamples.DiscoverCharacters;

    protected override async Task OnInitializedAsync()
    {
        PromptService.OnChanged += HandleChanged;
        await LoadAsync();
    }

    void HandleChanged() => InvokeAsync(LoadAsync);

    async Task LoadAsync()
    {
        _characterPrompt = await PromptService.GetCharacterPromptAsync(AttributionPromptStyle.Full);
        _batchCharacterPrompt = await PromptService.GetBatchCharacterPromptAsync(AttributionPromptStyle.Full);
        _simpleCharacterPrompt = await PromptService.GetCharacterPromptAsync(AttributionPromptStyle.Simple);
        _simpleBatchCharacterPrompt = await PromptService.GetBatchCharacterPromptAsync(AttributionPromptStyle.Simple);
        _voicePrompt = await PromptService.GetVoicePromptAsync();
        _voicePlanPrompt = await PromptService.GetVoicePlanPromptAsync();
        _narratorVoicePlanPrompt = await PromptService.GetNarratorVoicePlanPromptAsync();
        _discoverCharactersPrompt = await PromptService.GetDiscoverCharactersPromptAsync();
        _attributionCompatibility = await PromptService.GetAttributionPromptCompatibilityAsync();
        StateHasChanged();
    }

    string RenderCharacterPreview() =>
        _characterPrompt is null ? string.Empty : PromptTemplates.Render(_characterPrompt, _sampleValues);

    string RenderBatchCharacterPreview() =>
        _batchCharacterPrompt is null ? string.Empty : PromptTemplates.Render(_batchCharacterPrompt, _batchSampleValues);

    string RenderSimpleCharacterPreview() =>
        _simpleCharacterPrompt is null ? string.Empty : PromptTemplates.Render(_simpleCharacterPrompt, _sampleValues);

    string RenderSimpleBatchCharacterPreview() =>
        _simpleBatchCharacterPrompt is null ? string.Empty : PromptTemplates.Render(_simpleBatchCharacterPrompt, _batchSampleValues);

    string RenderVoicePreview() =>
        _voicePrompt is null ? string.Empty : PromptTemplates.Render(_voicePrompt, _sampleValues);

    string RenderVoicePlanPreview() =>
        _voicePlanPrompt is null ? string.Empty : PromptTemplates.Render(_voicePlanPrompt, _voicePlanSampleValues);

    string RenderNarratorVoicePlanPreview() =>
        _narratorVoicePlanPrompt is null ? string.Empty : PromptTemplates.Render(_narratorVoicePlanPrompt, _narratorVoicePlanSampleValues);

    string RenderDiscoverCharactersPreview() =>
        _discoverCharactersPrompt is null ? string.Empty : PromptTemplates.Render(_discoverCharactersPrompt, _discoverCharactersSampleValues);

    async Task SaveCharacterPromptAsync()
    {
        await PromptService.SetCharacterPromptAsync(_characterPrompt ?? string.Empty);
        Snackbar.Add("Character prompt saved", Severity.Success);
    }

    async Task ResetCharacterPromptAsync()
    {
        await PromptService.ResetCharacterPromptAsync();
        await LoadAsync();
        Snackbar.Add("Character prompt reset to default", Severity.Info);
    }

    async Task SaveBatchCharacterPromptAsync()
    {
        await PromptService.SetBatchCharacterPromptAsync(_batchCharacterPrompt ?? string.Empty);
        Snackbar.Add("Batch character prompt saved", Severity.Success);
    }

    async Task ResetBatchCharacterPromptAsync()
    {
        await PromptService.ResetBatchCharacterPromptAsync();
        await LoadAsync();
        Snackbar.Add("Batch character prompt reset to default", Severity.Info);
    }

    async Task SaveSimpleCharacterPromptAsync()
    {
        await PromptService.SetSimpleCharacterPromptAsync(_simpleCharacterPrompt ?? string.Empty);
        Snackbar.Add("Simple character prompt saved", Severity.Success);
    }

    async Task ResetSimpleCharacterPromptAsync()
    {
        await PromptService.ResetSimpleCharacterPromptAsync();
        await LoadAsync();
        Snackbar.Add("Simple character prompt reset to default", Severity.Info);
    }

    async Task SaveSimpleBatchCharacterPromptAsync()
    {
        await PromptService.SetSimpleBatchCharacterPromptAsync(_simpleBatchCharacterPrompt ?? string.Empty);
        Snackbar.Add("Simple batch character prompt saved", Severity.Success);
    }

    async Task ResetSimpleBatchCharacterPromptAsync()
    {
        await PromptService.ResetSimpleBatchCharacterPromptAsync();
        await LoadAsync();
        Snackbar.Add("Simple batch character prompt reset to default", Severity.Info);
    }

    async Task SaveVoicePromptAsync()
    {
        await PromptService.SetVoicePromptAsync(_voicePrompt ?? string.Empty);
        Snackbar.Add("Voice prompt saved", Severity.Success);
    }

    async Task ResetVoicePromptAsync()
    {
        await PromptService.ResetVoicePromptAsync();
        await LoadAsync();
        Snackbar.Add("Voice prompt reset to default", Severity.Info);
    }

    async Task SaveVoicePlanPromptAsync()
    {
        await PromptService.SetVoicePlanPromptAsync(_voicePlanPrompt ?? string.Empty);
        Snackbar.Add("Voice plan prompt saved", Severity.Success);
    }

    async Task ResetVoicePlanPromptAsync()
    {
        await PromptService.ResetVoicePlanPromptAsync();
        await LoadAsync();
        Snackbar.Add("Voice plan prompt reset to default", Severity.Info);
    }

    async Task SaveNarratorVoicePlanPromptAsync()
    {
        await PromptService.SetNarratorVoicePlanPromptAsync(_narratorVoicePlanPrompt ?? string.Empty);
        Snackbar.Add("Narrator voice plan prompt saved", Severity.Success);
    }

    async Task ResetNarratorVoicePlanPromptAsync()
    {
        await PromptService.ResetNarratorVoicePlanPromptAsync();
        await LoadAsync();
        Snackbar.Add("Narrator voice plan prompt reset to default", Severity.Info);
    }

    async Task SaveDiscoverCharactersPromptAsync()
    {
        await PromptService.SetDiscoverCharactersPromptAsync(_discoverCharactersPrompt ?? string.Empty);
        Snackbar.Add("Discover characters prompt saved", Severity.Success);
    }

    async Task ResetDiscoverCharactersPromptAsync()
    {
        await PromptService.ResetDiscoverCharactersPromptAsync();
        await LoadAsync();
        Snackbar.Add("Discover characters prompt reset to default", Severity.Info);
    }

    public void Dispose()
    {
        PromptService.OnChanged -= HandleChanged;
    }
}
