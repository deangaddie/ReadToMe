@page "/"
@namespace Read2Me.App.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Read2Me</title>
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
</head>
<body style="margin: 0; padding: 0;">
    <app>
        <component type="typeof(App)" render-mode="ServerPrerendered" />
    </app>

    <div id="blazor-error-ui"
         style="display:none; position:fixed; bottom:0; left:0; width:100%; z-index:2000;
                background:#fff3cd; color:#664d03; padding:0.6rem 1.25rem; box-shadow:0 -1px 2px rgba(0,0,0,0.2);">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Follows the bottom of a streaming log, but only while the user is
        // already there: scrolling up unpins, scrolling back down re-pins.
        window.read2meAutoScroll = function (el) {
            if (!el) { return; }
            if (!el._r2mAutoScroll) {
                el._r2mAutoScroll = { pinned: true };
                el.addEventListener('scroll', function () {
                    el._r2mAutoScroll.pinned =
                        el.scrollHeight - el.scrollTop - el.clientHeight < 40;
                });
            }
            if (el._r2mAutoScroll.pinned) { el.scrollTop = el.scrollHeight; }
        };
    </script>
</body>
</html>
