@page "/transcription-settings"
@using System.IO
@using System.Text.Json
@using Read2Me.Services.Audio.Transcription
@using Read2Me.Services.Audio.Transcription.Settings
@inject TranscriptionSettingsService SettingsService
@inject ITranscriptionClientResolver ClientResolver
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5">
    <MudText Typo="Typo.h4">Transcription Settings</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog">
        New Configuration
    </MudButton>
</MudStack>

@if (_configs == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_configs.Count == 0)
{
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        No transcription configurations yet. Create one to get started.
    </MudText>
}
else
{
    <MudGrid>
        @foreach (var config in _configs)
        {
            var c = config;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true">
                    <MudCardContent Class="pb-0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@c.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@c.Type</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@DescribeUrl(c)</MudText>
                        <DockerServiceControls BaseUrl="@DescribeUrl(c)" />

                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3" Spacing="2">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Mic"
                                       HtmlTag="label" for="@($"transcription-test-{c.Id}")"
                                       Disabled="@(_testingConfigId == c.Id)"
                                       Style="cursor:pointer">
                                Test with audio
                            </MudButton>
                            <InputFile id="@($"transcription-test-{c.Id}")"
                                       OnChange="@(e => TestConfigAsync(c, e))"
                                       accept=".wav,.mp3,.aac" style="display:none" />
                            @if (_testingConfigId == c.Id)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                            }
                        </MudStack>

                        @if (_testResults.TryGetValue(c.Id, out var result))
                        {
                            <MudAlert Severity="@(result.Success ? Severity.Success : Severity.Error)"
                                      Dense="true" Class="mt-2" ShowCloseIcon="true"
                                      CloseIconClicked="() => _testResults.Remove(c.Id)">
                                @result.Message
                            </MudAlert>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        @if (_activeConfigId == c.Id)
                        {
                            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle"
                                     Size="Size.Small" Variant="Variant.Filled">Active</MudChip>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       OnClick="() => SelectConfigAsync(c.Id)">Apply</MudButton>
                        }
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenEditDialog(c)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="() => DeleteConfigAsync(c.Id)" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    List<TranscriptionServiceConfig>? _configs;
    int? _activeConfigId;

    int? _testingConfigId;
    readonly Dictionary<int, TestResult> _testResults = new();

    const long MaxTestFileBytes = 50 * 1024 * 1024;

    record TestResult(bool Success, string Message);

    async Task TestConfigAsync(TranscriptionServiceConfig config, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        _testResults.Remove(config.Id);
        _testingConfigId = config.Id;
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(MaxTestFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var client = ClientResolver.Resolve(config.Type);
            var transcript = await client.TranscribeAsync(config, buffer, file.Name);

            var preview = string.IsNullOrWhiteSpace(transcript)
                ? "(empty transcript returned)"
                : transcript.Trim();
            _testResults[config.Id] = new TestResult(true, $"Transcript: {preview}");
        }
        catch (Exception ex)
        {
            _testResults[config.Id] = new TestResult(false, $"Test failed: {ex.Message}");
        }
        finally
        {
            _testingConfigId = null;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SettingsService.OnChanged += HandleChanged;
        await LoadAsync();
    }

    void HandleChanged() => InvokeAsync(LoadAsync);

    async Task LoadAsync()
    {
        _configs = await SettingsService.GetAllConfigsAsync();
        _activeConfigId = await SettingsService.GetActiveConfigIdAsync();
        StateHasChanged();
    }

    static string DescribeUrl(TranscriptionServiceConfig c)
    {
        try
        {
            return c.Type switch
            {
                TranscriptionServiceType.LocalWhisper =>
                    JsonSerializer.Deserialize<LocalWhisperSettings>(c.SettingsJson)?.BaseUrl ?? "",
                _ => "",
            };
        }
        catch
        {
            return "";
        }
    }

    async Task SelectConfigAsync(int configId)
    {
        await SettingsService.SetActiveConfigAsync(configId);
        await LoadAsync();
        Snackbar.Add("Configuration applied", Severity.Success);
    }

    static readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    async Task OpenAddDialog()
    {
        var dialog = await DialogService.ShowAsync<TranscriptionServiceConfigDialog>("New Configuration", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TranscriptionServiceConfig saved })
        {
            await SettingsService.CreateConfigAsync(saved);
            await LoadAsync();
            Snackbar.Add("Configuration created", Severity.Success);
        }
    }

    async Task OpenEditDialog(TranscriptionServiceConfig config)
    {
        var dialog = await DialogService.ShowAsync<TranscriptionServiceConfigDialog>(
            "Edit Configuration",
            new DialogParameters<TranscriptionServiceConfigDialog> { { x => x.Config, config } },
            _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TranscriptionServiceConfig saved })
        {
            await SettingsService.UpdateConfigAsync(saved);
            await LoadAsync();
            Snackbar.Add("Configuration updated", Severity.Success);
        }
    }

    async Task DeleteConfigAsync(int configId)
    {
        await SettingsService.DeleteConfigAsync(configId);
        await LoadAsync();
        Snackbar.Add("Configuration deleted", Severity.Info);
    }

    public void Dispose()
    {
        SettingsService.OnChanged -= HandleChanged;
    }
}
