@page "/project/{FolderName}"
@using Read2Me.Services
@inject IProjectReader ProjectReader

<PageTitle>@_title | Read2Me</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@_title</MudText>

<ProjectDetailsPanel FolderName="@FolderName" Project="@_project" OnProjectChanged="ReloadProjectAsync" />

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
    <MudTabPanel Text="Book" Class="pa-4">
        <BookTab FolderName="@FolderName" />
    </MudTabPanel>
    <MudTabPanel Text="Test" Class="pa-4">
        <TestTab FolderName="@FolderName" />
    </MudTabPanel>
</MudTabs>

<BookSelectionFooter />

@code {
    [Parameter] public string FolderName { get; set; } = "";

    string _title = "";
    Read2Me.Data.Entities.Project? _project;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadProjectAsync();
    }

    async Task ReloadProjectAsync()
    {
        _project = await ProjectReader.GetProjectAsync(FolderName);
        _title = _project?.Title ?? FolderName;
        StateHasChanged();
    }
}
