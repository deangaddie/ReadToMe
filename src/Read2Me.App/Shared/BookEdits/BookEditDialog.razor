@using Read2Me.Services.BookEdits
@using Read2Me.App.Services.Preflight
@using Read2Me.App.State
@inject IAiPreflight Preflight
@inject IDialogService Dialogs
@inject BookEditPlanner Planner
@inject ScopeResolver Resolver
@inject BookEditProposalService Proposals
@inject IBookCommandHandler CommandHandler
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit with AI</MudText>
    </TitleContent>
    <DialogContent>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
        }

        @switch (_phase)
        {
            case Phase.Instruct:
                <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">
                    Describe the change in plain language — e.g. "the first letter of the first paragraph
                    of every chapter is missing, restore it" or "rename every chapter to 'Chapter {n}'".
                    Only titles and paragraph text can be edited.
                </MudText>
                <MudTextField T="string" @bind-Value="_instruction" Label="Instruction" Lines="4"
                              Variant="Variant.Outlined" AutoFocus="true" Disabled="_busy" />
                break;

            case Phase.PlanReady:
                <MudText Typo="Typo.body1" Class="mb-2">@_planSummary</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_targets.Count matching item(s) found.
                    @if (_isLlmTransform)
                    {
                        <text> Each item is edited by the AI — this sends @BatchCountText request(s) to the LLM.</text>
                    }
                </MudText>
                @if (_targets.Count > LlmTargetWarnThreshold && _isLlmTransform)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        This is a large AI job (@_targets.Count items). It may take a long time.
                    </MudAlert>
                }
                break;

            case Phase.Proposing:
                <MudText Typo="Typo.body1" Class="mb-2">@_planSummary</MudText>
                <MudProgressLinear Color="Color.Primary" Value="@_progressPercent" Class="my-3" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_progressDone of @_targets.Count computed…</MudText>
                break;

            case Phase.Review:
                <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">@_planSummary</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAll">Select all</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectNone">Select none</MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_selection.Count of @_selection.SelectableCount selected</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                    Click a row to read it in full and correct the AI's suggestion by hand.
                </MudText>
                <div style="max-height: 55vh; overflow-y: auto;">
                    <MudTable T="BookEditReviewRow" Items="_selection.Rows" Dense="true" Hover="true"
                              Bordered="false" Striped="true" OnRowClick="@(a => ToggleOpen(a.Item))">
                        <HeaderContent>
                            <MudTh Style="width:36px" />
                            <MudTh>Where</MudTh>
                            <MudTh>Current</MudTh>
                            <MudTh>Proposed</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @* The checkbox lives inside the clickable row, so its click must not
                                   also toggle the detail panel open. *@
                                <span @onclick:stopPropagation="true">
                                    <MudCheckBox T="bool" Size="Size.Small" Dense="true"
                                                 Value="@_selection.IsSelected(context)"
                                                 ValueChanged="@(v => _selection.Set(context, v))"
                                                 Disabled="@(!context.IsAppliable)" />
                                </span>
                            </MudTd>
                            <MudTd><MudText Typo="Typo.caption">@context.Proposal.DisplayPath</MudText></MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2"
                                         Style="@(context.IsAppliable ? "text-decoration: line-through; opacity: 0.7;" : null)">
                                    @Truncate(context.Proposal.OldValue)
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    @switch (context.State)
                                    {
                                        case ReviewRowState.Failed:
                                            <MudText Typo="Typo.body2" Color="Color.Error">@context.Proposal.FailureReason</MudText>
                                            break;
                                        case ReviewRowState.NoChange:
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">(no change)</MudText>
                                            break;
                                        case ReviewRowState.Invalid:
                                            <MudText Typo="Typo.body2" Color="Color.Error">Can't be empty</MudText>
                                            break;
                                        default:
                                            <MudText Typo="Typo.body2" Color="Color.Success">@Truncate(context.EffectiveValue)</MudText>
                                            break;
                                    }
                                    @if (context.IsUserEdited)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                            Edited
                                        </MudChip>
                                    }
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            @if (_openRowId == context.Proposal.Id)
                            {
                                <MudTr>
                                    <MudTd colspan="4">
                                        @* MudTable raises OnRowClick for this row too, so without
                                           stopping the click here, clicking into the textarea
                                           collapses the panel out from under the cursor. *@
                                        <div @onclick:stopPropagation="true">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Current</MudText>
                                            <div style="max-height:18vh; overflow-y:auto; white-space:pre-wrap;" class="mb-2">
                                                <MudText Typo="Typo.body2">@context.Proposal.OldValue</MudText>
                                            </div>
                                            <MudTextField T="string" Label="Proposed" Lines="5" Immediate="true"
                                                          Variant="Variant.Outlined"
                                                          Value="@context.EffectiveValue"
                                                          ValueChanged="@(v => _selection.SetValue(context, v))"
                                                          Error="@(context.State == ReviewRowState.Invalid)"
                                                          ErrorText="This can't be empty — AI edits never delete text." />
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                                           OnClick="@(() => _selection.Revert(context))"
                                                           Disabled="@(!context.IsUserEdited)">
                                                    Revert to AI
                                                </MudButton>
                                                @* Slice 04 adds "Ask AI again" + the sticky hint field here. *@
                                                <MudSpacer />
                                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                                           OnClick="@(() => _openRowId = null)">
                                                    Done
                                                </MudButton>
                                            </MudStack>
                                        </div>
                                    </MudTd>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                </div>
                break;
        }

        @* Optional live view of the LLM's thinking + responses, to debug or refine the
           instruction when a result isn't what was expected. Always mounted so it captures
           every request made while the dialog is open, not just the one in flight when opened. *@
        <div style="border-top:1px solid var(--mud-palette-divider); margin-top:12px; padding-top:4px;">
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                       StartIcon="@(_showStream ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowUp)"
                       OnClick="@(() => _showStream = !_showStream)">
                @(_showStream ? "Hide AI activity" : "Show AI activity")
            </MudButton>
            <div style="@(_showStream ? "height:32vh;" : "height:0;") overflow:hidden; transition:height 0.15s ease;">
                <LlmStreamView />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        @switch (_phase)
        {
            case Phase.Instruct:
                <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AnalyzeAsync"
                           Disabled="@(_busy || string.IsNullOrWhiteSpace(_instruction))">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Analyze
                </MudButton>
                break;
            case Phase.PlanReady:
                <MudButton OnClick="BackToInstruct">Back</MudButton>
                <MudButton OnClick="Cancel">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateAsync">
                    Generate proposals
                </MudButton>
                break;
            case Phase.Proposing:
                <MudButton Color="Color.Error" OnClick="CancelProposing">Cancel</MudButton>
                break;
            case Phase.Review:
                <MudButton OnClick="StartOverAsync" Disabled="_busy">Start over</MudButton>
                <MudButton OnClick="CloseReviewAsync" Disabled="_busy">Close</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplyAsync"
                           Disabled="@(_busy || _selection.Count == 0)">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Apply @_selection.Count selected
                </MudButton>
                break;
        }
    </DialogActions>
</MudDialog>

@code {
    const int LlmTargetWarnThreshold = 300;
    const int BatchSize = 8;

    enum Phase { Instruct, PlanReady, Proposing, Review }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }

    Phase _phase = Phase.Instruct;
    bool _showStream;
    string _instruction = "";
    string? _error;
    bool _busy;
    string _planSummary = "";
    EditProgram? _program;
    IReadOnlyList<EditTarget> _targets = [];
    BookEditReviewSelection _selection = new([]);
    Guid? _openRowId;
    int _progressDone;
    CancellationTokenSource? _cts;

    bool _isLlmTransform => _program?.Transform.Kind == TransformKind.Llm;
    string BatchCountText => ((_targets.Count + BatchSize - 1) / BatchSize).ToString();
    double _progressPercent => _targets.Count == 0 ? 0 : 100.0 * _progressDone / _targets.Count;

    static string Truncate(string? s) =>
        s == null ? "" : s.Length <= 160 ? s : s[..160] + "…";

    async Task AnalyzeAsync()
    {
        _error = null;
        _busy = true;
        _cts = new CancellationTokenSource();
        try
        {
            // Same gate every other AI action goes through — offers to start/free the LLM
            // container instead of failing with a raw "service unavailable".
            if (!await Preflight.EnsureReadyAsync(AiTaskKind.BookEdit, _cts.Token))
                return;

            var outcome = await Planner.PlanAsync(FolderId, _instruction, _cts.Token);
            if (outcome.Status != EditPlanStatus.Ok)
            {
                _error = outcome.Status switch
                {
                    EditPlanStatus.NoLlmConfigured => "No LLM server is configured. Set one up under Settings → LLM.",
                    EditPlanStatus.Unsupported => $"This instruction can't be applied: {outcome.Reason} " +
                        "AI edits can change titles and paragraph text only.",
                    EditPlanStatus.ServiceUnavailable => $"The LLM service is unavailable: {outcome.Reason}",
                    _ => $"Could not understand the instruction: {outcome.Reason}",
                };
                return;
            }

            _program = outcome.Program!;
            _planSummary = EditProgramDescriber.Describe(_program);
            _targets = await Resolver.ResolveAsync(FolderId, _program, _cts.Token);
            if (_targets.Count == 0)
            {
                _error = "No items in the book match this instruction's scope. Try rephrasing.";
                return;
            }
            _phase = Phase.PlanReady;
        }
        catch (OperationCanceledException)
        {
            // dialog closed mid-analyze
        }
        finally
        {
            _busy = false;
        }
    }

    async Task GenerateAsync()
    {
        _error = null;
        _cts = new CancellationTokenSource();

        // Re-gate: the plan phase may have been minutes ago, and a GPU sweep for another task
        // can have stopped llama since. Deterministic transforms need no LLM at all.
        if (_isLlmTransform && !await Preflight.EnsureReadyAsync(AiTaskKind.BookEdit, _cts.Token))
            return;

        _phase = Phase.Proposing;
        _progressDone = 0;
        var progress = new SyncProgress(this);
        IReadOnlyList<ProposedEdit> proposals = [];
        try
        {
            proposals = await Proposals.ProposeAsync(FolderId, _program!, _targets, progress, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Cancel returns partial proposals from the service; a hard cancel here means none.
        }
        // New rows, so new selection: every appliable row starts ticked.
        _selection = new BookEditReviewSelection([.. proposals.Select(p => new BookEditReviewRow(p))]);
        _openRowId = null;
        _phase = Phase.Review;
    }

    async Task ApplyAsync()
    {
        _busy = true;
        try
        {
            await CommandHandler.ExecuteAsync(
                new ApplyBookEditsCommand(FolderId, _selection.ToEditItems()));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = $"Applying edits failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    void SelectAll() => _selection.SelectAll();

    void SelectNone() => _selection.Clear();

    void ToggleOpen(BookEditReviewRow? row) =>
        _openRowId = row == null || _openRowId == row.Proposal.Id ? null : row.Proposal.Id;

    async Task StartOverAsync()
    {
        if (!await ConfirmDiscardEditsAsync("Start over")) return;
        BackToInstruct();
    }

    async Task CloseReviewAsync()
    {
        if (!await ConfirmDiscardEditsAsync("Close")) return;
        Cancel();
    }

    /// <summary>
    /// Hand edits live in the open dialog only — nothing is stored — so leaving the review
    /// screen throws them away. Ask first when there are any.
    /// </summary>
    async Task<bool> ConfirmDiscardEditsAsync(string action)
    {
        var edited = _selection.HandEditedCount;
        return edited == 0 || await Dialogs.ConfirmAsync(
            $"{action}?",
            $"Discard {edited} hand-edited proposal{(edited == 1 ? "" : "s")}?",
            "Discard");
    }

    void BackToInstruct()
    {
        _phase = Phase.Instruct;
        _error = null;
        _selection = new BookEditReviewSelection([]);
        _openRowId = null;
    }

    void CancelProposing() => _cts?.Cancel();

    void Cancel()
    {
        _cts?.Cancel();
        MudDialog.Cancel();
    }

    void ReportProgress(int done)
    {
        _progressDone = done;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    sealed class SyncProgress(BookEditDialog owner) : IProgress<(int Done, int Total)>
    {
        public void Report((int Done, int Total) value) => owner.ReportProgress(value.Done);
    }
}
