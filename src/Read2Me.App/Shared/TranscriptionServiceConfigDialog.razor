<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined"
                          Required="true" Immediate="true" />

            <MudSelect T="TranscriptionServiceType" @bind-Value="_form.Type" Label="Type" Variant="Variant.Outlined">
                @foreach (var type in Enum.GetValues<TranscriptionServiceType>())
                {
                    <MudSelectItem Value="@type">@type</MudSelectItem>
                }
            </MudSelect>

            @if (_form.Type == TranscriptionServiceType.LocalWhisper)
            {
                <MudTextField @bind-Value="_form.BaseUrl" Label="Base URL" Variant="Variant.Outlined"
                              Placeholder="http://localhost:9000" Required="true" Immediate="true"
                              UserAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "off" })" />
            }

            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Existing config to edit; null for a new one.</summary>
    [Parameter] public TranscriptionServiceConfig? Config { get; set; }

    TranscriptionServiceConfigForm _form = new();
    string? _error;

    protected override void OnInitialized()
    {
        _form = Config != null
            ? TranscriptionServiceConfigForm.FromConfig(Config)
            : new TranscriptionServiceConfigForm();
    }

    void Submit()
    {
        _error = _form.Validate();
        if (_error != null) return;
        MudDialog.Close(DialogResult.Ok(_form.BuildConfig()));
    }

    void Cancel() => MudDialog.Cancel();
}
