@using System.IO
@inject Read2Me.Services.UseCases.ProjectUseCases ProjectUseCases

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Project</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_bookTitle" Label="Book Title" Variant="Variant.Outlined"
                          Required="true" Immediate="true"
                          OnBlur="OnBookTitleBlur" />
            <MudTextField @bind-Value="_title" Label="Project Title" Variant="Variant.Outlined"
                          Required="true" Immediate="true" />
            <MudTextField @bind-Value="_author" Label="Author" Variant="Variant.Outlined"
                          Required="true" Immediate="true" />

            <div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile"
                           HtmlTag="label" for="add-project-book-file" Style="cursor:pointer">
                    @(_file == null ? "Choose Book File" : _file.Name)
                </MudButton>
                <InputFile id="add-project-book-file" OnChange="OnFileChanged"
                           accept=".epub,.txt" style="display:none" />

                @if (_file != null)
                {
                    <div class="mt-1">
                        @if (_detectedType != null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Success">@_detectedType.Value</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Error">Unsupported type. Use .epub or .txt</MudText>
                            </MudStack>
                        }
                    </div>
                }
            </div>

            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(!IsValid || _busy)" OnClick="Submit">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    readonly AddProjectForm _form = new();
    IBrowserFile? _file;
    string? _error;
    bool _busy;

    string _title { get => _form.Title; set => _form.Title = value; }
    string _bookTitle { get => _form.BookTitle; set => _form.BookTitle = value; }
    string _author { get => _form.Author; set => _form.Author = value; }
    BookFileType? _detectedType => _form.DetectedType;

    bool IsValid => _form.IsValid;

    void OnBookTitleBlur(FocusEventArgs _) => _form.OnBookTitleBlur();

    void OnFileChanged(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _error = null;
        _form.SetFile(e.File.Name);
    }

    async Task Submit()
    {
        if (!IsValid) return;
        _busy = true;
        _error = null;
        await using var stream = _file!.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
        var result = await ProjectUseCases.CreateAsync(
            _form.Title, _form.BookTitle, _form.Author,
            _file.Name, stream, _form.DetectedType!.Value);
        _busy = false;
        if (result.IsSuccess)
            MudDialog.Close();
        else
            _error = result.Error;
    }
}
