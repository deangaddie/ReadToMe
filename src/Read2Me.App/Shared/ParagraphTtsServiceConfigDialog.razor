@using Read2Me.AppData.Entities

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined"
                          Required="true" Immediate="true" />

            <MudSelect T="ParagraphTtsServiceType" @bind-Value="_form.Type" Label="Type" Variant="Variant.Outlined">
                @foreach (var type in Enum.GetValues<ParagraphTtsServiceType>())
                {
                    <MudSelectItem Value="@type">@type</MudSelectItem>
                }
            </MudSelect>

            @if (_form.Type == ParagraphTtsServiceType.VoxCpm2)
            {
                <MudTextField @bind-Value="_form.BaseUrl" Label="Base URL" Variant="Variant.Outlined"
                              Placeholder="http://localhost:8000" Required="true" Immediate="true"
                              UserAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "off" })" />

                <MudNumericField @bind-Value="_form.MaxLen" Label="Max Len" Variant="Variant.Outlined"
                                 Min="1" Max="8192" Immediate="true"
                                 HelperText="Max output length in tokens (server caps at 8192)." />
            }

            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ParagraphTtsServiceConfig? Config { get; set; }

    ParagraphTtsServiceConfigForm _form = new();
    string? _error;

    protected override void OnInitialized()
    {
        _form = Config != null
            ? ParagraphTtsServiceConfigForm.FromConfig(Config)
            : new ParagraphTtsServiceConfigForm();
    }

    void Submit()
    {
        _error = _form.Validate();
        if (_error != null) return;
        MudDialog.Close(DialogResult.Ok(_form.BuildConfig()));
    }

    void Cancel() => MudDialog.Cancel();
}
