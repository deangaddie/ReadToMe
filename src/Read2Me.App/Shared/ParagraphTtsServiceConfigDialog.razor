@using Read2Me.Services.Text
@inject ITextProcessingStepCatalog StepCatalog

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined"
                          Required="true" Immediate="true" />

            <MudSelect T="ParagraphTtsServiceType" @bind-Value="_form.Type" Label="Type" Variant="Variant.Outlined">
                @foreach (var type in Enum.GetValues<ParagraphTtsServiceType>())
                {
                    <MudSelectItem Value="@type">@type</MudSelectItem>
                }
            </MudSelect>

            @if (_form.Type == ParagraphTtsServiceType.VoxCpm2)
            {
                <MudTextField @bind-Value="_form.BaseUrl" Label="Base URL" Variant="Variant.Outlined"
                              Placeholder="http://localhost:8000" Required="true" Immediate="true"
                              UserAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "off" })" />

                <MudNumericField @bind-Value="_form.MaxChunkChars" Label="Max Chunk Chars" Variant="Variant.Outlined"
                                 Min="1" Immediate="true"
                                 HelperText="Soft cap on characters per TTS chunk. Larger = more coherent but heavier for the provider." />

                <ParagraphTtsSettingsEditor @bind-Value="_form.SettingsJson"
                                            ProviderType="ParagraphTtsServiceType.VoxCpm2"
                                            Mode="TtsSettingsEditorMode.ProviderDefaults" />
            }

            <MudText Typo="Typo.subtitle2">Text processing</MudText>
            @foreach (var step in StepCatalog.GetAll(Config?.Id ?? 0))
            {
                var s = step;
                <MudTooltip Text="@s.Description" Placement="Placement.Right">
                    <MudCheckBox T="bool"
                                 Value="@_form.IsStepEnabled(s.Id)"
                                 ValueChanged="@((bool v) => _form.SetStepEnabled(s.Id, v))"
                                 Label="@s.DisplayName" />
                </MudTooltip>
            }

            <MudText Typo="Typo.subtitle2">Substitutions</MudText>
            @foreach (var item in _form.SubstitutionSteps)
            {
                var row = item;
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudTextField @bind-Value="row.FromText" Label="From" Variant="Variant.Outlined"
                                  Immediate="true" Style="max-width:140px" />
                    <MudTextField @bind-Value="row.ToText" Label="To" Variant="Variant.Outlined"
                                  Immediate="true" Style="max-width:140px" />
                    <MudCheckBox T="bool"
                                 Value="@_form.IsStepEnabled(row.Id)"
                                 ValueChanged="@((bool v) => _form.SetStepEnabled(row.Id, v))"
                                 Label="Enabled" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   OnClick="@(() => _form.RemoveSubstitution(row.Id))" />
                </MudStack>
            }
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                       OnClick="@(() => _form.AddSubstitution())">Add substitution</MudButton>

            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ParagraphTtsServiceConfig? Config { get; set; }

    ParagraphTtsServiceConfigForm _form = new();
    string? _error;

    protected override void OnInitialized()
    {
        _form = Config != null
            ? ParagraphTtsServiceConfigForm.FromConfig(Config)
            : new ParagraphTtsServiceConfigForm();
    }

    void Submit()
    {
        _error = _form.Validate();
        if (_error != null) return;
        MudDialog.Close(DialogResult.Ok(_form.BuildConfig()));
    }

    void Cancel() => MudDialog.Cancel();
}
