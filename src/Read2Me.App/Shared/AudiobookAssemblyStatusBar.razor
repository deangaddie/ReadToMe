@using Read2Me.Services.Audio
@using Read2Me.Services.Audio.Assembly
@using Read2Me.App.State
@inject AudiobookAssemblyService Assembly
@inject AudioQueueService AudioQueue
@implements IDisposable

@{
    var isRunning = Assembly.IsRunning;
    var lastError = Assembly.LastError;
    var isVisible = isRunning || lastError != null;

    var audioSnap = AudioQueue.Snapshot();
    var audioBarActive = audioSnap.QueuedCount > 0 || audioSnap.ProcessingCount > 0;

    // Stack above both fixed status bars (each is ~38px tall)
    var bottomPx = audioBarActive ? "76px" : "38px";

    var vm = AssemblyButtonViewModel.For(
        audioRemaining: 0,
        audioQueueBusy: false,
        isRunning: isRunning,
        currentPhase: Assembly.CurrentPhase,
        encodePercent: Assembly.EncodePercent);
}

@if (isVisible)
{
    <div style="position:fixed; bottom:@bottomPx; left:0; right:0; z-index:1290;
                background:@(lastError != null ? "var(--mud-palette-error-dark)" : "var(--mud-palette-dark)");
                color:var(--mud-palette-dark-text);
                border-top:1px solid var(--mud-palette-divider);
                padding:6px 16px;
                display:flex; align-items:center; gap:16px; flex-wrap:wrap; font-size:0.8rem;">

        <MudIcon Icon="@Icons.Material.Filled.LibraryMusic" Size="Size.Small" Style="opacity:0.7;" />

        @if (lastError != null)
        {
            <span style="color:var(--mud-palette-error-text);">
                <strong>Assembly failed:</strong> @lastError
            </span>
        }
        else if (isRunning)
        {
            <span>
                <strong>Assembling audiobook</strong>
            </span>

            @if (!string.IsNullOrEmpty(vm.PhaseLabel))
            {
                <span style="opacity:0.7;">@vm.PhaseLabel</span>
            }

            @if (!string.IsNullOrEmpty(vm.EncodePercentText))
            {
                <span style="opacity:0.9; font-weight:600;">@vm.EncodePercentText</span>
            }
        }

        <MudSpacer />

        @if (isRunning)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                 Style="color:var(--mud-palette-dark-text); opacity:0.7; width:16px; height:16px;" />
            <MudTooltip Text="Cancel assembly">
                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                               Size="Size.Small"
                               Style="color:var(--mud-palette-dark-text); opacity:0.7;"
                               OnClick="Cancel" />
            </MudTooltip>
        }
    </div>
}

@code {
    private System.Threading.Timer? _ticker;

    protected override void OnInitialized()
    {
        AudioQueue.Changed += Refresh;
        _ticker = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    void Cancel() => Assembly.Cancel();

    public void Dispose()
    {
        AudioQueue.Changed -= Refresh;
        _ticker?.Dispose();
    }
}
