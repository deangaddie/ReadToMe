@using Read2Me.Services.Audio
@using Read2Me.Services.Characters
@using Read2Me.App.State
@inject CharacterQueueService Queue
@inject AudioQueueService AudioQueue
@implements IDisposable

@{
    var snap = Queue.Snapshot();
    var vm = QueueStatusViewModel.For(
        snap.QueuedCount, snap.ProcessingCount, snap.AverageSecondsPerParagraph,
        snap.EstimatedSecondsRemaining, snap.CompletedCount, snap.CurrentItemElapsedSeconds,
        averageUnit: "para");
    var isActive = vm.IsActive;
    var audioSnap = AudioQueue.Snapshot();
    var audioBarActive = audioSnap.QueuedCount > 0 || audioSnap.ProcessingCount > 0;
    var bottomPx = audioBarActive ? "38px" : "0";
}

@if (isActive || _expanded)
{
    @if (_expanded)
    {
        <div style="position:fixed; inset:0; z-index:1289; background:rgba(0,0,0,0.5);"
             @onclick="ToggleExpanded"></div>
    }

    <div style="position:fixed; bottom:@bottomPx; left:0; right:0; z-index:1290;
                display:flex; flex-direction:column;
                @(_expanded ? "height:50vh;" : "")">

        <div style="background:var(--mud-palette-dark);
                    color:var(--mud-palette-dark-text);
                    border-top:1px solid var(--mud-palette-divider);
                    padding:6px 16px;
                    display:flex; align-items:center; gap:16px; flex-wrap:wrap; font-size:0.8rem;">

            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Style="opacity:0.7;" />

            @if (vm.ShowProcessing)
            {
                <span>
                    <strong>Processing</strong>
                    <span style="opacity:0.6;"> @vm.ElapsedText</span>
                </span>
            }
            else
            {
                <span style="opacity:0.6;">Idle</span>
            }

            @if (vm.ShowQueued)
            {
                <span style="opacity:0.7;">@vm.QueuedText</span>
            }

            @if (vm.ShowAverage)
            {
                <span style="opacity:0.7;">@vm.AverageText</span>
            }

            <span style="opacity:0.7;">tok/s —</span>

            @if (vm.ShowEta)
            {
                <span style="opacity:0.7;">@vm.EtaText</span>
            }

            @if (vm.ShowCompleted)
            {
                <span style="opacity:0.5;">@vm.CompletedText</span>
            }

            <MudSpacer />

            <MudTooltip Text="@(_expanded ? "Hide live stream" : "Show live stream")">
                <MudIconButton Icon="@(_expanded ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowUp)"
                               Size="Size.Small"
                               Style="color:var(--mud-palette-dark-text); opacity:0.7;"
                               OnClick="ToggleExpanded" />
            </MudTooltip>

            @if (isActive)
            {
                <MudTooltip Text="Cancel all">
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                   Size="Size.Small"
                                   Style="color:var(--mud-palette-dark-text); opacity:0.7;"
                                   OnClick="CancelAll" />
                </MudTooltip>
            }
        </div>

        @if (_expanded)
        {
            <div style="flex:1; min-height:0; overflow:hidden; background:var(--mud-palette-surface);
                        border-top:1px solid var(--mud-palette-divider);">
                <LlmStreamView />
            </div>
        }
    </div>
}

@code {
    private System.Threading.Timer? _ticker;
    private bool _expanded;

    protected override void OnInitialized()
    {
        Queue.Changed += Refresh;
        AudioQueue.Changed += Refresh;
        _ticker = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    void CancelAll() => Queue.CancelAll();

    void ToggleExpanded()
    {
        _expanded = !_expanded;
        StateHasChanged();
    }

    public void Dispose()
    {
        Queue.Changed -= Refresh;
        AudioQueue.Changed -= Refresh;
        _ticker?.Dispose();
    }
}
