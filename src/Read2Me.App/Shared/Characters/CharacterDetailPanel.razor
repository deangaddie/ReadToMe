@using Read2Me.App.State

<MudStack Spacing="3">
    @if (IsLinkedNarrator)
    {
        <NarratorSignpost Narrator="Narrator"
                          UnusedVoices="Presenter.Voices"
                          GoToLinkedCharacter="GoToLinkedCharacterAsync" />
    }
    else
    {
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween">
        @if (_renamingCharacter)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudTextField @bind-Value="_renameCharacterValue" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Style="width:220px;" Immediate="true"
                              OnKeyDown="OnRenameCharacterKeyDownAsync" AutoFocus="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                               OnClick="CommitRenameCharacterAsync" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelRenameCharacter" />
            </MudStack>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h6">@Character.Name</MudText>
                @if (!Character.IsNarrator)
                {
                    <MudTooltip Text="Rename">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="BeginRenameCharacter" />
                    </MudTooltip>
                }
            </MudStack>
        }
        <MudStack Row="true" Spacing="1">
            @if (!Character.IsNarrator)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="OpenMergeAsync">Merge
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="ConfirmDeleteAsync">
                    Delete</MudButton>
                }
            </MudStack>
        </MudStack>

        @if (_showAiActivity)
        {
            <MudPaper Outlined="true" Class="pa-2">
                <MudText Typo="Typo.subtitle2" Class="mb-2">AI activity</MudText>
                <div style="height:32vh; min-height:220px;">
                    <LlmStreamView />
                </div>
            </MudPaper>
        }

        @if (!Character.IsNarrator)
        {
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">Aliases</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var alias in Character.Aliases)
                    {
                        var a = alias;
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                 CloseIcon="@Icons.Material.Filled.Close" OnClose="@(() => RemoveAliasAsync(a.Id))">
                            @a.Name
                        </MudChip>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (_addingAlias)
                        {
                            <MudTextField @bind-Value="_newAlias" Placeholder="Alias name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="width:160px;" Immediate="true" OnKeyDown="OnAliasKeyDownAsync" />
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                                           OnClick="CommitAliasAsync" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelAlias" />
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => _addingAlias = true)">Add alias</MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudStack>

            <MudDivider />
        }

        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Voices (@Presenter.Voices.Count)</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddVoiceAsync">Add voice</MudButton>
            </MudStack>

            <MudExpansionPanels MultiExpansion="true">
                @foreach (var voice in Presenter.Voices)
                {
                    var v = voice;
                    <MudExpansionPanel @key="v.Id">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @if (Presenter.DefaultVoiceId == v.Id)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning"
                                             Title="Default voice" />
                                }
                                else
                                {
                                    <MudTooltip Text="Set as default">
                                        <MudIconButton Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small"
                                                       OnClick="@(() => Presenter.SetVoiceDefaultAsync(v.Id))" />
                                    </MudTooltip>
                                }
                                @if (_renamingVoice == v.Id)
                                {
                                    <span @onclick:stopPropagation="true" style="display:contents">
                                        <MudTextField @bind-Value="_renameValue" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" Style="width:180px;" Immediate="true"
                                                      OnKeyDown="@(e => OnRenameKeyDownAsync(e, v))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                                                       OnClick="@(() => CommitRenameAsync(v))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       OnClick="@CancelRename" />
                                    </span>
                                }
                                else
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body1">@v.Name</MudText>
                                        @if (!string.IsNullOrWhiteSpace(v.Description))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@v.Description</MudText>
                                        }
                                    </MudStack>
                                    <span @onclick:stopPropagation="true">
                                        <MudTooltip Text="Rename">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                           OnClick="@(() => BeginRename(v))" />
                                        </MudTooltip>
                                    </span>
                                }
                                <MudSpacer />
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(v.Source == VoiceSource.Uploaded ? Color.Info : Color.Secondary)"
                                         Variant="Variant.Outlined">
                                    @(v.Source == VoiceSource.Uploaded ? "Reference" : "Prompt")
                                </MudChip>
                                @if (IsEdited(v))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                             data-testid="@($"voice-edited-chip-{v.Id}")">Edited</MudChip>
                                }
                                @* No audio, nothing to edit — the icon is absent, not disabled. *@
                                @if (v.AudioFileName != null)
                                {
                                    <span @onclick:stopPropagation="true">
                                        <MudTooltip Text="Edit audio">
                                            <MudIconButton Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small"
                                                           Href="@($"/project/{FolderName}/voice/{v.Id}/audio")"
                                                           data-testid="@($"voice-edit-audio-{v.Id}")" />
                                        </MudTooltip>
                                    </span>
                                }
                                <span @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => ConfirmDeleteVoiceAsync(v))" />
                                </span>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="3" Class="pt-2">

                                <MudStack Spacing="1">
                                    <MudTextField Value="@GetDescriptionDraft(v)"
                                                  ValueChanged="@((string s) => _drafts.Set(v.Id, VoiceDraftField.Description, s))"
                                                  Label="Voice description (where in the book this voice applies)"
                                                  Variant="Variant.Outlined" Lines="2" Immediate="true" />
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Save" Disabled="@(!HasDescriptionDraft(v))"
                                               OnClick="@(() => SaveDescriptionAsync(v))" Style="align-self:flex-start">
                                        Save description
                                    </MudButton>
                                </MudStack>

                                <MudToggleGroup T="VoiceSource" Value="@v.Source"
                                                ValueChanged="@(s => SwitchVoiceSourceAsync(v, s))"
                                                SelectionMode="SelectionMode.SingleSelection">
                                    <MudToggleItem Value="VoiceSource.Uploaded" Text="Reference Audio" />
                                    <MudToggleItem Value="VoiceSource.Generated" Text="Prompt" />
                                </MudToggleGroup>

                                @if (v.Source == VoiceSource.Uploaded)
                                {
                                    @if (v.AudioFileName != null && !_reloadingAudio.Contains(v.Id))
                                    {
                                        <audio controls style="width:100%;">
                                            <source src="@AudioUrl(v)" />
                                            Audio not supported.
                                        </audio>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No audio uploaded yet.</MudText>
                                    }

                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile" HtmlTag="label"
                                                   for="@($"voice-upload-{v.Id}")" Style="cursor:pointer">
                                            @(v.AudioFileName != null ? "Replace audio" : "Upload audio")
                                        </MudButton>
                                        <InputFile id="@($"voice-upload-{v.Id}")" OnChange="@(e => OnReplaceAudioAsync(e, v))"
                                                   style="display:none" />
                                    </MudStack>
                                }
                                else
                                {
                                    <MudTextField Value="@GetPromptDraft(v)" ValueChanged="@((string s) => _drafts.Set(v.Id, VoiceDraftField.Prompt, s))"
                                                  Label="Voice description prompt" Variant="Variant.Outlined" Lines="4" Immediate="true" />
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Save" Disabled="@(!HasPromptDraft(v))"
                                                   OnClick="@(() => SavePromptAsync(v))">
                                            Save prompt
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.AutoFixHigh" Disabled="@(_regeneratingPrompt == v.Id)"
                                                   OnClick="@(() => RegeneratePromptAsync(v))">
                                            @(_regeneratingPrompt == v.Id ? "Generating…" : "Regenerate with AI")
                                        </MudButton>
                                        @if (v.AudioFileName != null)
                                        {
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.VolumeUp" Disabled="@(_generatingAudio == v.Id)"
                                                       OnClick="@(() => GenerateAudioAsync(v))">
                                                @(_generatingAudio == v.Id ? "Generating…" : "Regenerate audio")
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.VolumeUp"
                                                       Disabled="@(_generatingAudio == v.Id || string.IsNullOrWhiteSpace(v.DesignPrompt))"
                                                       OnClick="@(() => GenerateAudioAsync(v))">
                                                @(_generatingAudio == v.Id ? "Generating…" : "Generate audio")
                                            </MudButton>
                                        }
                                    </MudStack>
                                    @if (v.AudioFileName != null && !_reloadingAudio.Contains(v.Id))
                                    {
                                        <audio controls style="width:100%;">
                                            <source src="@AudioUrl(v)" />
                                            Audio not supported.
                                        </audio>
                                    }
                                }

                                <MudExpansionPanel Text="Advanced settings" Dense="true">
                                    <MudTabs Elevation="0" Rounded="false">
                                        <MudTabPanel Text="Voice Design">
                                            <MudStack Spacing="2">
                                                <TtsSettingsEditor Value="@GetOverrideDraft(v)"
                                                                   ValueChanged="@((string? s) => _drafts.Set(v.Id, VoiceDraftField.Override, s ?? ""))"
                                                                   ProviderType="@(_activeVoiceDesignConfig?.Type ?? VoiceDesignServiceType.VoxCpm2)"
                                                                   Mode="TtsSettingsEditorMode.VoiceOverride"
                                                                   ProviderDefaultsJson="@ActiveProviderDefaultsJson" />
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Save"
                                                           OnClick="@(() => SaveOverrideAsync(v))">Save</MudButton>
                                            </MudStack>
                                        </MudTabPanel>
                                        <MudTabPanel Text="Text-to-Speech">
                                            <MudStack Spacing="2">
                                                <ParagraphTtsSettingsEditor Value="@GetTtsOverrideDraft(v)"
                                                                            ValueChanged="@((string? s) => _drafts.Set(v.Id, VoiceDraftField.TtsOverride, s ?? ""))"
                                                                            ProviderType="@ActiveTtsProviderType"
                                                                            Mode="TtsSettingsEditorMode.VoiceOverride"
                                                                            ProviderDefaultsJson="@ActiveTtsProviderDefaultsJson" />
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Save"
                                                           OnClick="@(() => SaveTtsOverrideAsync(v))">Save</MudButton>
                                            </MudStack>
                                        </MudTabPanel>
                                    </MudTabs>
                                </MudExpansionPanel>

                                <MudExpansionPanel Text="Transcript" Dense="true">
                                    <MudStack Spacing="2">
                                        <MudTextField Value="@(GetTranscriptDraft(v))"
                                                      ValueChanged="@((string s) => _drafts.Set(v.Id, VoiceDraftField.Transcript, s))" Label="Transcript"
                                                      Variant="Variant.Outlined" Lines="3" Immediate="true" />
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Save" Disabled="@(!HasTranscriptDraft(v))"
                                                       OnClick="@(() => SaveTranscriptAsync(v))">
                                                Save
                                            </MudButton>
                                            @if (v.AudioFileName != null)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.RecordVoiceOver"
                                                           Disabled="@(_transcribing == v.Id)" OnClick="@(() => TranscribeAsync(v))">
                                                    @(_transcribing == v.Id ? "Transcribing…" : "Send to AI")
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudExpansionPanel>

                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudStack>
    }

        @if (Presenter.VoiceRules.Count > 0)
        {
            <MudDivider />
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Voice Rules</MudText>
                    @if (!Character.IsNarrator)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddRuleDialogAsync">Add rule</MudButton>
                    }
                </MudStack>

                @{ var nonDefaultRules = Presenter.VoiceRules.Where(r => !r.IsDefault).ToList(); }

                @foreach (var rule in Presenter.VoiceRules)
                {
                    var r = rule;
                    var nonDefaultIdx = nonDefaultRules.IndexOf(r);
                    var isFirst = nonDefaultIdx == 0;
                    var isLast  = nonDefaultIdx == nonDefaultRules.Count - 1;
                    var isDangling = r.FromDangling || r.ToDangling;

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                              data-testid="voice-rule-row" data-rule-id="@r.Id">
                        @if (isDangling)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small"
                                     Title="One or more anchor nodes no longer exist" />
                        }
                        <MudText Typo="Typo.body2" Style="flex:1">@RuleDescription(r)</MudText>
                        @if (!IsLinkedNarrator && !r.IsDefault)
                        {
                            <MudTooltip Text="Move up">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                               Disabled="@isFirst"
                                               OnClick="@(() => Presenter.MoveVoiceRuleUpAsync(r.Id))"
                                               data-testid="rule-move-up" />
                            </MudTooltip>
                            <MudTooltip Text="Move down">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                               Disabled="@isLast"
                                               OnClick="@(() => Presenter.MoveVoiceRuleDownAsync(r.Id))"
                                               data-testid="rule-move-down" />
                            </MudTooltip>
                            @if (isDangling)
                            {
                                <MudTooltip Text="Re-anchor (delete and recreate via book selection)">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditLocation" Size="Size.Small"
                                                   Color="Color.Warning"
                                                   data-testid="rule-reanchor" />
                                </MudTooltip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => Presenter.DeleteVoiceRuleAsync(r.Id))"
                                           data-testid="rule-delete" />
                        }
                    </MudStack>
                }
            </MudStack>
        }

        @if (!Character.IsNarrator)
        {
            <MudDivider />
            <MudText Typo="Typo.subtitle2">Lines (@Lines.Count)</MudText>
            <CharacterLinesViewer Lines="Lines" />
        }
    </MudStack>
