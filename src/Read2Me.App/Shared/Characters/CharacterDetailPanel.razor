@using System.IO
@using Read2Me.App.State
@using Read2Me.Data.Entities
@using Read2Me.Data.Enums
@inject CharacterPresenter Presenter
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">@Character.Name</MudText>
        <MudStack Row="true" Spacing="1">
            @if (!Character.IsNarrator)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="OpenMergeAsync">Merge
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="ConfirmDeleteAsync">
                    Delete</MudButton>
                }
            </MudStack>
        </MudStack>

        @if (!Character.IsNarrator)
        {
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">Aliases</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var alias in Character.Aliases)
                    {
                        var a = alias;
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                 CloseIcon="@Icons.Material.Filled.Close" OnClose="@(() => RemoveAliasAsync(a.Id))">
                            @a.Name
                        </MudChip>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (_addingAlias)
                        {
                            <MudTextField @bind-Value="_newAlias" Placeholder="Alias name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="width:160px;" Immediate="true" OnKeyDown="OnAliasKeyDownAsync" />
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                                           OnClick="CommitAliasAsync" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelAlias" />
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => _addingAlias = true)">Add alias</MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudStack>

            <MudDivider />
        }

        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Voices (@Presenter.Voices.Count)</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddVoiceAsync">Add voice</MudButton>
            </MudStack>

            <MudExpansionPanels MultiExpansion="true">
                @foreach (var voice in Presenter.Voices)
                {
                    var v = voice;
                    <MudExpansionPanel @key="v.Id">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @if (v.IsDefault)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning"
                                             Title="Default voice" />
                                }
                                else
                                {
                                    <MudTooltip Text="Set as default">
                                        <MudIconButton Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small"
                                                       OnClick="@(() => Presenter.SetVoiceDefaultAsync(v.Id))" />
                                    </MudTooltip>
                                }
                                <MudText Typo="Typo.body1">@v.Name</MudText>
                                <MudSpacer />
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(v.Source == VoiceSource.Uploaded ? Color.Info : Color.Secondary)"
                                         Variant="Variant.Outlined">
                                    @(v.Source == VoiceSource.Uploaded ? "Reference" : "Prompt")
                                </MudChip>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => ConfirmDeleteVoiceAsync(v))" />
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="3" Class="pt-2">

                                <MudToggleGroup T="VoiceSource" Value="@v.Source"
                                                ValueChanged="@(s => SwitchVoiceSourceAsync(v, s))"
                                                SelectionMode="SelectionMode.SingleSelection">
                                    <MudToggleItem Value="VoiceSource.Uploaded" Text="Reference Audio" />
                                    <MudToggleItem Value="VoiceSource.Generated" Text="Prompt" />
                                </MudToggleGroup>

                                @if (v.Source == VoiceSource.Uploaded)
                                {
                                    @if (v.AudioFileName != null && !_reloadingAudio.Contains(v.Id))
                                    {
                                        <audio controls style="width:100%;">
                                            <source src="@AudioUrl(v)" />
                                            Audio not supported.
                                        </audio>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No audio uploaded yet.</MudText>
                                    }

                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile" HtmlTag="label"
                                                   for="@($"voice-upload-{v.Id}")" Style="cursor:pointer">
                                            @(v.AudioFileName != null ? "Replace audio" : "Upload audio")
                                        </MudButton>
                                        <InputFile id="@($"voice-upload-{v.Id}")" OnChange="@(e => OnReplaceAudioAsync(e, v))"
                                                   accept=".wav,.aac" style="display:none" />
                                    </MudStack>
                                }
                                else
                                {
                                    <MudTextField Value="@GetPromptDraft(v)" ValueChanged="@((string s) => _drafts.Set(v.Id, VoiceDraftField.Prompt, s))"
                                                  Label="Voice description prompt" Variant="Variant.Outlined" Lines="4" Immediate="true" />
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Save" Disabled="@(!HasPromptDraft(v))"
                                                   OnClick="@(() => SavePromptAsync(v))">
                                            Save prompt
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.AutoFixHigh" Disabled="@(_regeneratingPrompt == v.Id)"
                                                   OnClick="@(() => RegeneratePromptAsync(v))">
                                            @(_regeneratingPrompt == v.Id ? "Generating…" : "Regenerate with AI")
                                        </MudButton>
                                        @if (v.AudioFileName != null)
                                        {
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.VolumeUp" Disabled="@(_generatingAudio == v.Id)"
                                                       OnClick="@(() => GenerateAudioAsync(v))">
                                                @(_generatingAudio == v.Id ? "Generating…" : "Regenerate audio")
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.VolumeUp"
                                                       Disabled="@(_generatingAudio == v.Id || string.IsNullOrWhiteSpace(v.DesignPrompt))"
                                                       OnClick="@(() => GenerateAudioAsync(v))">
                                                @(_generatingAudio == v.Id ? "Generating…" : "Generate audio")
                                            </MudButton>
                                        }
                                    </MudStack>
                                    @if (v.AudioFileName != null && !_reloadingAudio.Contains(v.Id))
                                    {
                                        <audio controls style="width:100%;">
                                            <source src="@AudioUrl(v)" />
                                            Audio not supported.
                                        </audio>
                                    }
                                }

                                <MudExpansionPanel Text="Advanced settings" Dense="true">
                                    <MudStack Spacing="2">
                                        <MudTextField Value="@GetOverrideDraft(v)"
                                                      ValueChanged="@((string s) => _drafts.Set(v.Id, VoiceDraftField.Override, s))"
                                                      Label="Settings override (JSON)" Variant="Variant.Outlined"
                                                      Lines="3" Immediate="true"
                                                      HelperText="Only the keys you set override the active provider's defaults. Leave blank for none." />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Save"
                                                   OnClick="@(() => SaveOverrideAsync(v))">Save</MudButton>
                                    </MudStack>
                                </MudExpansionPanel>

                                <MudExpansionPanel Text="Transcript" Dense="true">
                                    <MudStack Spacing="2">
                                        <MudTextField Value="@(GetTranscriptDraft(v))"
                                                      ValueChanged="@((string s) => _drafts.Set(v.Id, VoiceDraftField.Transcript, s))" Label="Transcript"
                                                      Variant="Variant.Outlined" Lines="3" Immediate="true" />
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Save" Disabled="@(!HasTranscriptDraft(v))"
                                                       OnClick="@(() => SaveTranscriptAsync(v))">
                                                Save
                                            </MudButton>
                                            @if (v.AudioFileName != null)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.RecordVoiceOver"
                                                           Disabled="@(_transcribing == v.Id)" OnClick="@(() => TranscribeAsync(v))">
                                                    @(_transcribing == v.Id ? "Transcribing…" : "Send to AI")
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudExpansionPanel>

                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudStack>

        @if (!Character.IsNarrator)
        {
            <MudDivider />
            <MudText Typo="Typo.subtitle2">Lines (@Lines.Count)</MudText>
            <CharacterLinesViewer Lines="Lines" />
        }
    </MudStack>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<Read2Me.Core.Models.CharacterLine> Lines { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<Character> AllCharacters { get; set; } = [];
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";

    bool _addingAlias;
    string _newAlias = "";
    Guid? _regeneratingPrompt;
    Guid? _generatingAudio;
    Guid? _transcribing;

    readonly VoiceDraftBuffer _drafts = new();
    readonly HashSet<Guid> _reloadingAudio = new();

    string AudioUrl(Voice v) =>
        $"/workspace/{FolderName}/{v.AudioFileName?.Replace('\\', '/')}?v={Presenter.AudioToken(v.Id)}";

    async Task CycleAudioPlayerAsync(Guid voiceId)
    {
        _reloadingAudio.Add(voiceId);
        StateHasChanged();
        await Task.Yield();
        _reloadingAudio.Remove(voiceId);
        StateHasChanged();
    }

    bool HasPromptDraft(Voice v) => _drafts.IsDirty(v.Id, VoiceDraftField.Prompt, v.DesignPrompt);
    bool HasTranscriptDraft(Voice v) => _drafts.IsDirty(v.Id, VoiceDraftField.Transcript, v.Transcript);

    string GetPromptDraft(Voice v) => _drafts.Current(v.Id, VoiceDraftField.Prompt, v.DesignPrompt);
    string GetTranscriptDraft(Voice v) => _drafts.Current(v.Id, VoiceDraftField.Transcript, v.Transcript);
    string GetOverrideDraft(Voice v) => _drafts.Current(v.Id, VoiceDraftField.Override, v.SettingsOverrideJson);

    async Task SaveOverrideAsync(Voice v)
    {
        var raw = _drafts.Current(v.Id, VoiceDraftField.Override, v.SettingsOverrideJson);
        string? json = string.IsNullOrWhiteSpace(raw) ? null : raw;
        if (json is not null)
        {
            try { System.Text.Json.JsonDocument.Parse(json); }
            catch { Snackbar.Add("Override is not valid JSON.", Severity.Error); return; }
        }
        await Presenter.SetVoiceSettingsOverrideAsync(v.Id, json);
        _drafts.Clear(v.Id, VoiceDraftField.Override);
        Snackbar.Add("Settings override saved.", Severity.Success);
    }

    // ── Alias ─────────────────────────────────────────────────────────────────

    async Task CommitAliasAsync()
    {
        var name = _newAlias.Trim();
        if (!string.IsNullOrEmpty(name))
            await Presenter.AddAliasAsync(Character.Id, name);
        CancelAlias();
    }

    async Task OnAliasKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitAliasAsync();
        else if (e.Key == "Escape") CancelAlias();
    }

    void CancelAlias() { _addingAlias = false; _newAlias = ""; }

    async Task RemoveAliasAsync(Guid aliasId) => await Presenter.RemoveAliasAsync(aliasId);

    // ── Add voice ─────────────────────────────────────────────────────────────

    async Task AddVoiceAsync()
    {
        var parameters = new DialogParameters<AddVoiceDialog>
        {
            { d => d.Character, Character },
        };
        var dialog = await DialogService.ShowAsync<AddVoiceDialog>("Add Voice", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        if (result.Data is not AddVoiceDialog.VoiceDialogResult r) return;

        await Presenter.AddVoiceAndGetIdAsync(Character.Id, r.Name, r.IsGenerated);
    }

    // ── Voice source switch ───────────────────────────────────────────────────

    async Task SwitchVoiceSourceAsync(Voice voice, VoiceSource newSource)
    {
        if (voice.Source == newSource) return;
        await Presenter.SetVoiceSourceAsync(voice.Id, newSource == VoiceSource.Generated);
    }

    // ── Reference audio upload ────────────────────────────────────────────────

    async Task OnReplaceAudioAsync(InputFileChangeEventArgs e, Voice voice)
    {
        var ext = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (ext is not (".wav" or ".aac")) return;
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
        await Presenter.ReplaceVoiceAudioAsync(Character.Id, voice.Id, voice.Name, stream, ext);
        await CycleAudioPlayerAsync(voice.Id);
    }

    // ── Prompt editing ────────────────────────────────────────────────────────

    async Task SavePromptAsync(Voice voice)
    {
        if (!HasPromptDraft(voice)) return;
        var prompt = _drafts.Current(voice.Id, VoiceDraftField.Prompt, voice.DesignPrompt);
        await Presenter.SetVoiceDesignPromptDirectAsync(voice.Id, prompt);
        _drafts.Clear(voice.Id, VoiceDraftField.Prompt);
    }

    async Task RegeneratePromptAsync(Voice voice)
    {
        _regeneratingPrompt = voice.Id;
        StateHasChanged();
        var prompt = await Presenter.GenerateDesignPromptTextAsync(Character.Id);
        _regeneratingPrompt = null;
        if (prompt != null)
            _drafts.Set(voice.Id, VoiceDraftField.Prompt, prompt);
        StateHasChanged();
    }

    async Task GenerateAudioAsync(Voice voice)
    {
        var prompt = _drafts.Current(voice.Id, VoiceDraftField.Prompt, voice.DesignPrompt);
        if (string.IsNullOrWhiteSpace(prompt)) return;
        _generatingAudio = voice.Id;
        StateHasChanged();
        await Presenter.GenerateVoiceAudioAsync(Character.Id, voice.Id, voice.Name, prompt);
        _generatingAudio = null;
        _drafts.Clear(voice.Id, VoiceDraftField.Prompt);
        await CycleAudioPlayerAsync(voice.Id);
    }

    // ── Transcript ────────────────────────────────────────────────────────────

    async Task SaveTranscriptAsync(Voice voice)
    {
        if (!HasTranscriptDraft(voice)) return;
        var t = _drafts.Current(voice.Id, VoiceDraftField.Transcript, voice.Transcript);
        await Presenter.SetVoiceTranscriptDirectAsync(voice.Id, t);
        _drafts.Clear(voice.Id, VoiceDraftField.Transcript);
    }

    async Task TranscribeAsync(Voice voice)
    {
        if (voice.AudioFileName == null) return;

        _transcribing = voice.Id;
        StateHasChanged();
        var fileName = Path.GetFileName(voice.AudioFileName);
        using var stream = Presenter.OpenVoiceAudioStream(voice);
        if (stream == null)
        {
            _transcribing = null;
            Snackbar.Add("Could not open the voice audio file.", Severity.Error);
            return;
        }

        await Presenter.TranscribeVoiceAsync(voice.Id, stream, fileName);
        _transcribing = null;
        _drafts.Clear(voice.Id, VoiceDraftField.Transcript);

        if (Presenter.Error != null)
            Snackbar.Add(Presenter.Error, Severity.Error);
        else
            Snackbar.Add("Transcript generated.", Severity.Success);
    }

    // ── Delete ────────────────────────────────────────────────────────────────

    async Task ConfirmDeleteVoiceAsync(Voice voice)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { d => d.ItemType, "Voice" },
            { d => d.ItemName, voice.Name },
            { d => d.HasChildren, false }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Voice", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        await Presenter.DeleteVoiceAsync(voice.Id);
    }

    async Task OpenMergeAsync()
    {
        var others = AllCharacters.Where(c => c.Id != Character.Id && !c.IsNarrator).ToList();
        if (others.Count == 0) return;

        var parameters = new DialogParameters<MergeCharacterDialog>
        {
            { d => d.MergedCharacter, Character },
            { d => d.OtherCharacters, others }
        };
        var dialog = await DialogService.ShowAsync<MergeCharacterDialog>("Merge Character", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        if (result.Data is MergeCharacterDialog.MergeResult m)
            await Presenter.MergeAsync(m.SurvivorId, Character.Id, m.AddNameAsAlias);
    }

    async Task ConfirmDeleteAsync()
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { d => d.ItemType, "Character" },
            { d => d.ItemName, Character.Name },
            { d => d.HasChildren, false }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Character", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        await Presenter.DeleteCharacterAsync(Character.Id);
    }
}
