<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Generate voice prompt with AI</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Review or edit the prompt before sending to the LLM.
            </MudText>
            <MudTextField @bind-Value="Prompt" Label="Prompt" Variant="Variant.Outlined"
                          Lines="10" Immediate="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(Prompt)"
                   OnClick="Submit">
            Send to AI
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Prompt { get; set; } = "";

    void Cancel() => MudDialog.Cancel();
    void Submit() => MudDialog.Close(DialogResult.Ok(Prompt));
}
