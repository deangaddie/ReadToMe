@using Read2Me.App.State
@using Read2Me.App.Characters
@using Read2Me.App.Services.Preflight
@using Read2Me.Services.Events
@inject CharacterPresenter Presenter
@inject VoiceBatchRunner BatchService
@inject EventBroadcaster<VoiceBatchEvent> BatchEvents
@inject IDialogService DialogService
@inject IAiPreflight Preflight
@implements IDisposable

@if (!Presenter.IsLoading)
{
    <NarratorLinkBanner Narrator="Presenter.Narrator"
                        Characters="Presenter.Characters"
                        NarratorChanged="SetNarratorAsync" />
}

@if (Presenter.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (Presenter.Characters.Count == 0)
{
    <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="pa-8">
        <MudText Typo="Typo.body1" Color="Color.Secondary">No characters yet.</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="AddCharacterAsync">Add Character</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.TravelExplore"
                       Disabled="@_discovering"
                       OnClick="DiscoverCharactersAsync">Discover characters</MudButton>
        </MudStack>
    </MudStack>
}
else
{
    <MudStack Row="true" Spacing="2" Class="pa-4 pb-0">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.TravelExplore"
                   Disabled="@(BatchService.IsRunning || _discovering)"
                   OnClick="DiscoverCharactersAsync">Discover characters</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Disabled="@BatchService.IsRunning"
                   OnClick="GenerateVoicePromptsAsync">Generate voice prompts</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.VolumeUp"
                   Disabled="@BatchService.IsRunning"
                   OnClick="GenerateAudioAsync">Generate audio</MudButton>
    </MudStack>

    <MudGrid Spacing="2" Class="pa-4">
        <MudItem xs="12" sm="4" md="3">
            <MudStack Spacing="1">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="AddCharacterAsync">Add Character</MudButton>
                <MudList T="Character" @bind-SelectedValue="_selectedCharacter" SelectionMode="SelectionMode.SingleSelection"
                         Dense="true" Class="mt-1">
                    @foreach (var character in Presenter.Characters)
                    {
                        var c = character;
                        <MudListItem T="Character" Value="c" OnClick="@(() => SelectAsync(c))">
                            <CharacterListRowContent Character="c" Narrator="Presenter.Narrator" />
                        </MudListItem>
                    }
                </MudList>
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="8" md="9">
            @if (Presenter.SelectedCharacter is { } sel)
            {
                <CharacterDetailPanel Character="sel"
                                      Lines="Presenter.Lines"
                                      AllCharacters="Presenter.Characters"
                                      Narrator="Presenter.Narrator"
                                      SelectCharacter="SelectAsync"
                                      FolderName="@FolderName" />
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Select a character.</MudText>
            }
        </MudItem>
    </MudGrid>
}

@if (Presenter.Error is { } err)
{
    <MudAlert Severity="Severity.Error" Class="mt-2">@err</MudAlert>
}

@code {
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";

    Character? _selectedCharacter;

    protected override async Task OnParametersSetAsync()
    {
        Presenter.StateChanged += Refresh;
        BatchEvents.Event += OnBatchEvent;
        await Presenter.LoadAsync(new Core.Models.ProjectFolderId(FolderName));
        _selectedCharacter = Presenter.SelectedCharacter;
    }

    async Task SelectAsync(Character c)
    {
        _selectedCharacter = c;
        await Presenter.SelectCharacterAsync(c);
    }

    async Task SetNarratorAsync(Guid? characterId)
    {
        await Presenter.SetNarratorCharacterAsync(characterId);
        _selectedCharacter = Presenter.SelectedCharacter;
    }

    async Task AddCharacterAsync()
    {
        var dialog = await DialogService.ShowAsync<AddCharacterDialog>("Add Character");
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        if (result.Data is string name && !string.IsNullOrWhiteSpace(name))
            await Presenter.AddCharacterAsync(name);
    }

    bool _discovering;

    async Task DiscoverCharactersAsync()
    {
        // Preflight lives here, not in the dialog: same reasoning as the voice-prompt batch —
        // keep the "start the container?" prompt outside the per-circuit dialog service.
        if (!await Preflight.EnsureReadyAsync(AiTaskKind.CharacterDiscovery)) return;

        _discovering = true;
        try
        {
            var parameters = new DialogParameters<DiscoverCharactersDialog>
            {
                { d => d.FolderId, new Core.Models.ProjectFolderId(FolderName) },
            };
            var dialog = await DialogService.ShowAsync<DiscoverCharactersDialog>("Discover characters", parameters);
            var result = await dialog.Result;
            if (result?.Canceled != false) return;
            if (result.Data is List<DiscoveredCharacterRow> rows)
                await Presenter.ApplyDiscoveredCharactersAsync(rows);
        }
        finally
        {
            _discovering = false;
        }
    }

    async Task GenerateVoicePromptsAsync()
    {
        // Preflight lives here, not in the runner: VoiceBatchRunner is a singleton and the
        // dialog service is per-circuit.
        if (!await Preflight.EnsureReadyAsync(AiTaskKind.VoicePromptGeneration)) return;

        var regenerateAll = false;
        if (Presenter.Characters.Any(c => c.Voices.Count > 0))
        {
            var dialog = await DialogService.ShowAsync<GenerateVoicesScopeDialog>("Generate voice prompts");
            var result = await dialog.Result;
            if (result?.Canceled != false) return;
            if (result.Data is bool clearAll) regenerateAll = clearAll;
        }

        if (!BatchService.StartGeneratePrompts(new Core.Models.ProjectFolderId(FolderName), regenerateAll)) return;

        var progress = await DialogService.ShowAsync<VoiceBatchProgressDialog>("Generate voice prompts");
        await progress.Result;
    }

    async Task GenerateAudioAsync()
    {
        if (!await Preflight.EnsureReadyAsync(AiTaskKind.VoiceDesignAudio)) return;
        BatchService.StartGenerateAudio(new Core.Models.ProjectFolderId(FolderName));
    }

    void OnBatchEvent(VoiceBatchEvent e)
    {
        switch (e)
        {
            case VoiceUpdated u:
                InvokeAsync(() =>
                {
                    Presenter.ApplyVoiceUpdate(u.VoiceId, u.DesignPrompt, u.AudioFileName, u.Transcript);
                    StateHasChanged();
                });
                break;
            case BatchCompleted:
                InvokeAsync(async () =>
                {
                    await Presenter.LoadAsync(Presenter._folderId!.Value);
                    StateHasChanged();
                });
                break;
            default:
                InvokeAsync(StateHasChanged);
                break;
        }
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Presenter.StateChanged -= Refresh;
        BatchEvents.Event -= OnBatchEvent;
    }
}
