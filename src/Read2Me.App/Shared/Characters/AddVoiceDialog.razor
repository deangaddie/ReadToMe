@using Read2Me.App.State
@using Read2Me.Data.Entities
@inject CharacterPresenter Presenter

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Voice</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Voice name" Variant="Variant.Outlined"
                          Placeholder="@Character.Name" Immediate="true" />

            <MudToggleGroup T="bool" @bind-Value="_isGenerated" SelectionMode="SelectionMode.SingleSelection">
                <MudToggleItem Value="false" Text="Reference Audio" />
                <MudToggleItem Value="true" Text="Prompt" />
            </MudToggleGroup>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Character Character { get; set; } = null!;

    string _name = "";
    bool _isGenerated = false;

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        var name = string.IsNullOrWhiteSpace(_name) ? Character.Name : _name.Trim();
        MudDialog.Close(DialogResult.Ok(new VoiceDialogResult(name, _isGenerated)));
    }

    public sealed record VoiceDialogResult(string Name, bool IsGenerated);
}
