@using System.IO
@inject Read2Me.Services.UseCases.ProjectUseCases ProjectUseCases

<style>
    .cover-container {
        position: relative;
        display: inline-block;
        line-height: 0;
    }

    .cover-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        opacity: 0;
        transition: opacity 0.15s ease;
        border-radius: 4px;
    }

    .cover-container:hover .cover-overlay {
        opacity: 1;
    }
</style>

<MudExpansionPanels Class="mb-6">
    <MudExpansionPanel Text="Project Details">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="9">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Title</MudText>
                        <MudText Typo="Typo.body1">@Project?.Title</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Author</MudText>
                        <MudText Typo="Typo.body1">@Project?.Author</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Filename</MudText>
                        <MudText Typo="Typo.body1">@Project?.Filename</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Type</MudText>
                        <MudText Typo="Typo.body1">@Project?.Type</MudText>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" sm="3" Style="display:flex; flex-direction:column; align-items:flex-end">
                @if (Project?.CoverImage != null)
                {
                    <div class="cover-container">
                        <img src="/workspace/@FolderName/@Project!.CoverImage"
                             alt="Cover" style="height:200px; border-radius:4px" />
                        <div class="cover-overlay">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Style="color:white" Size="Size.Medium"
                                           HtmlTag="label" for="cover-image-input" title="Change cover" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Medium"
                                           OnClick="DeleteCoverAsync" title="Remove cover" />
                        </div>
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                               HtmlTag="label" for="cover-image-input" Style="cursor:pointer">
                        Add Cover Image
                    </MudButton>
                }
                <InputFile id="cover-image-input" OnChange="OnCoverImageChangedAsync"
                           accept=".jpg,.jpeg,.png,.webp" style="display:none" />
                @if (_coverError != null)
                {
                    <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-1 d-block">@_coverError</MudText>
                }
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";
    [Parameter, EditorRequired] public Read2Me.Data.Entities.Project? Project { get; set; }
    [Parameter] public EventCallback OnProjectChanged { get; set; }

    string? _coverError;

    async Task OnCoverImageChangedAsync(InputFileChangeEventArgs e)
    {
        _coverError = null;
        var ext = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp"))
        {
            _coverError = "Unsupported format. Use .jpg, .png, or .webp.";
            return;
        }
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var result = await ProjectUseCases.SaveCoverImageAsync(FolderName, e.File.Name, stream);
        if (!result.IsSuccess)
            _coverError = result.Error;
        else
            await OnProjectChanged.InvokeAsync();
    }

    async Task DeleteCoverAsync()
    {
        _coverError = null;
        var result = await ProjectUseCases.DeleteCoverImageAsync(FolderName);
        if (!result.IsSuccess)
            _coverError = result.Error;
        else
            await OnProjectChanged.InvokeAsync();
    }
}
