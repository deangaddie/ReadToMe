@using Read2Me.App.State
@using Read2Me.App.Shared.BookMenus
@using Read2Me.Core.Models
@using Read2Me.Data.Entities
@using Read2Me.Data.Enums
@inject BookHierarchyPresenter Presenter

@if (Presenter.IsLoading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (!Presenter.HasContent)
{
    <div style="display:flex; align-items:center; justify-content:center; min-height:300px">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:4rem; opacity:0.3" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Book has not been read in yet.</MudText>
            @if (Presenter.Filename != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Presenter.Filename</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoStories"
                       OnClick="@(() => Presenter.ReadBookAsync(_folderId))" Disabled="Presenter.IsBusy">
                @if (Presenter.IsBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Read Book
            </MudButton>
            @if (Presenter.Error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@Presenter.Error</MudText>
            }
        </MudStack>
    </div>
}
else
{
    <MudStack Spacing="3" Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
            @if (Presenter.Error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@Presenter.Error</MudText>
            }
            <MudToggleIconButton Toggled="Presenter.SplitView" ToggledChanged="@((v) => { Presenter.SplitView = v; StateHasChanged(); })"
                                 Icon="@Icons.Material.Filled.ViewStream"
                                 ToggledIcon="@Icons.Material.Filled.Subject"
                                 title="Show split items"
                                 toggledTitle="Show original paragraphs"
                                 Size="Size.Small" />
            @if (Presenter.ConfirmReread)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">Delete all book data and reprocess?</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => Presenter.ConfirmRereadAsync(_folderId))" Disabled="Presenter.IsBusy">
                    @if (Presenter.IsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Confirm
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(() => Presenter.CancelConfirmReread())">
                    Cancel
                </MudButton>
            }
            else
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Warning"
                                 OnClick="@(() => Presenter.RequestConfirmReread())" Disabled="Presenter.IsBusy">
                        Reread Book
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.EditNote" IconColor="Color.Info"
                                 OnClick="@(() => Presenter.ManualRereadAsync(_folderId))" Disabled="Presenter.IsBusy">
                        Manual Reread Book
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Title" IconColor="Color.Secondary"
                                 OnClick="@(() => Presenter.AddBookTitleAsync(_folderId))" Disabled="Presenter.IsBusy">
                        Add book title
                    </MudMenuItem>
                    @if (Presenter.Volumes.Count > 1)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.LibraryBooks" IconColor="Color.Secondary"
                                     OnClick="@(() => Presenter.AddVolumeTitlesAsync(_folderId))" Disabled="Presenter.IsBusy">
                            Add volume titles
                        </MudMenuItem>
                    }
                    @if (Presenter.TotalParts > Presenter.Volumes.Count)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.BookmarkBorder" IconColor="Color.Secondary"
                                     OnClick="@(() => Presenter.AddPartTitlesAsync(_folderId))" Disabled="Presenter.IsBusy">
                            Add part titles
                        </MudMenuItem>
                    }
                    @if (Presenter.TotalChapters > Presenter.TotalParts)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.MenuBook" IconColor="Color.Secondary"
                                     OnClick="@(() => Presenter.AddChapterTitlesAsync(_folderId))" Disabled="Presenter.IsBusy">
                            Add chapter titles
                        </MudMenuItem>
                    }
                </MudMenu>
            }
        </MudStack>

        @if (Presenter.Volumes.Count == 1)
        {
            @RenderVolumeBody(Presenter.Volumes[0])
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var volume in Presenter.Volumes)
                {
                    var vol = volume;
                    <MudExpansionPanel Expanded="@Presenter.Tree.ExpandedVolumeIds.Contains(vol.Id)"
                                      ExpandedChanged="@VolumeExpandCb(vol)">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudText Style="flex:1">@vol.Title</MudText>
                                <BookNodeMenu Spec="@BookNodeMenuSpecs.ForVolume(_folderId, vol)"
                                             IsFirst="@(Presenter.Volumes[0].Id == vol.Id)"
                                             IsLast="@(Presenter.Volumes[^1].Id == vol.Id)"
                                             PreviousSiblingId="@(Presenter.Volumes.TakeWhile(v => v.Id != vol.Id).LastOrDefault()?.Id)"
                                             NextSiblingId="@(Presenter.Volumes.SkipWhile(v => v.Id != vol.Id).Skip(1).FirstOrDefault()?.Id)"
                                             OnChanged="StateHasChanged"
                                             OnMerged="MergeAndResetAsync"
                                             OnReset="@(() => Presenter.ResetAndLoadAsync(_folderId))" />
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @RenderVolumeBody(vol)
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";

    ProjectFolderId _folderId;

    RenderFragment RenderVolumeBody(Volume vol) =>
        @<text>
            @if (Presenter.Tree.LoadingIds.Contains(vol.Id))
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
            }
            else if (Presenter.Tree.GetParts(vol.Id) is { } parts)
            {
                @RenderParts(parts)
            }
        </text>;

    RenderFragment RenderParts(System.Collections.Generic.List<Part> parts) =>
        @<text>
            @if (parts.Count == 1)
            {
                var p = parts[0];
                @if (Presenter.Tree.LoadingIds.Contains(p.Id))
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                }
                else if (Presenter.Tree.GetChapters(p.Id) is { } singlePartChapters)
                {
                    @RenderChapters(singlePartChapters)
                }
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true">
                    @foreach (var part in parts)
                    {
                        var p = part;
                        <MudExpansionPanel Expanded="@Presenter.Tree.ExpandedPartIds.Contains(p.Id)"
                                          ExpandedChanged="@PartExpandCb(p)">
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                                    <MudText Style="flex:1">@(p.Title ?? "Part")</MudText>
                                    <BookNodeMenu Spec="@BookNodeMenuSpecs.ForPart(_folderId, p)"
                                                 IsFirst="@(parts[0].Id == p.Id)"
                                                 IsLast="@(parts[^1].Id == p.Id)"
                                                 PreviousSiblingId="@(parts.IndexOf(p) is var pi && pi > 0 ? parts[pi - 1].Id : null)"
                                                 NextSiblingId="@(parts.IndexOf(p) is var pj && pj < parts.Count - 1 ? parts[pj + 1].Id : null)"
                                                 OnChanged="StateHasChanged"
                                                 OnMerged="MergeAndResetAsync"
                                                 OnSplit="SplitVolumeAsync"
                                                 OnReset="@(() => Presenter.ResetAndLoadAsync(_folderId))" />
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                @if (Presenter.Tree.LoadingIds.Contains(p.Id))
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                }
                                else if (Presenter.Tree.GetChapters(p.Id) is { } multiPartChapters)
                                {
                                    @RenderChapters(multiPartChapters)
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </text>;

    RenderFragment RenderChapters(System.Collections.Generic.List<Read2Me.Data.Entities.Chapter> chapters) =>
        @<MudExpansionPanels MultiExpansion="true">
            @foreach (var chapter in chapters)
            {
                var ch = chapter;
                <MudExpansionPanel Expanded="@Presenter.Tree.ExpandedChapterIds.Contains(ch.Id)"
                                  ExpandedChanged="@ChapterExpandCb(ch)">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                            <MudText Style="flex:1">@(ch.Title ?? "Chapter")</MudText>
                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForChapter(_folderId, ch)"
                                         IsFirst="@(chapters[0].Id == ch.Id)"
                                         IsLast="@(chapters[^1].Id == ch.Id)"
                                         PreviousSiblingId="@(chapters.IndexOf(ch) is var ci && ci > 0 ? chapters[ci - 1].Id : null)"
                                         NextSiblingId="@(chapters.IndexOf(ch) is var cj && cj < chapters.Count - 1 ? chapters[cj + 1].Id : null)"
                                         OnChanged="StateHasChanged"
                                         OnMerged="MergeAndResetAsync"
                                         OnSplit="SplitPartAsync"
                                         OnReset="@(() => Presenter.ResetAndLoadAsync(_folderId))" />
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @if (Presenter.Tree.LoadingIds.Contains(ch.Id))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                        }
                        else if (Presenter.Tree.GetParagraphs(ch.Id) is { } paragraphs)
                        {
                            <MudStack Spacing="2" Class="py-1">
                                @foreach (var para in paragraphs)
                                {
                                    var p = para;
                                    var hasUnknown = Presenter.SplitView && p.Items.Any(i =>
                                        i.ItemType == ParagraphItemType.Character && i.Character == null);
                                    @if (Presenter.SplitView)
                                    {
                                        var firstItem = p.Items.FirstOrDefault();
                                        var isPauseParagraph = ParagraphItemDisplay.IsPauseParagraph(p);
                                        @if (isPauseParagraph)
                                        {
                                            var pauseLabel = ParagraphItemDisplay.GetPauseLabel(firstItem?.ItemType);
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                                                      Style="opacity:0.45;">
                                                <MudText Typo="Typo.caption" Style="flex:1; font-style:italic;">@pauseLabel</MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            var items = p.Items.ToList();
                                            <MudStack Spacing="1" Class="pl-2 pr-1 py-1 rounded"
                                                      Style="@($"border-left: 2px solid {(hasUnknown ? "var(--mud-palette-warning)" : "var(--mud-palette-divider)")};{(hasUnknown ? " background: rgba(var(--mud-palette-warning-rgb), 0.06);" : "")}")">
                                                @foreach (var item in items)
                                                {
                                                    var it = item;
                                                    @if (it.ItemType == ParagraphItemType.Character)
                                                    {
                                                        <div style="display:grid; grid-template-columns:120px 1fr auto; align-items:start; gap:8px;">
                                                            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                                                                <ActivatorContent>
                                                                    <MudChip T="string" Size="Size.Small"
                                                                             Color="@(it.Character == null ? Color.Warning : Color.Primary)"
                                                                             Variant="Variant.Filled" Class="mt-0"
                                                                             Style="width:100%; justify-content:center;"
                                                                             OnClick="@(() => {})">
                                                                        @(it.Character?.Name ?? "Unknown")
                                                                    </MudChip>
                                                                </ActivatorContent>
                                                                <ChildContent>
                                                                    <MudMenuItem OnClick="@(() => Presenter.SetItemCharacterAsync(_folderId, it, null))">Unknown</MudMenuItem>
                                                                    @foreach (var ch2 in Presenter.Characters)
                                                                    {
                                                                        var c = ch2;
                                                                        <MudMenuItem OnClick="@(() => Presenter.SetItemCharacterAsync(_folderId, it, c.Id))">@c.Name</MudMenuItem>
                                                                    }
                                                                </ChildContent>
                                                            </MudMenu>
                                                            <MudText Typo="Typo.body2">@it.Text</MudText>
                                                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraphItem(_folderId, it)"
                                                                               IsFirst="@(items[0].Id == it.Id)"
                                                                               IsLast="@(items[^1].Id == it.Id)"
                                                                               OnChanged="StateHasChanged"
                                                                               OnReset="@(() => Presenter.ResetAndLoadAsync(_folderId))" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var (pauseIcon, pauseColor, pauseLabel2) = ParagraphItemDisplay.GetItemDisplay(it.ItemType);
                                                        <div style="@($"display:grid; grid-template-columns:120px 1fr auto; align-items:center; gap:8px; opacity:{(it.ItemType is ParagraphItemType.Narration ? "1" : "0.6")}; font-style:{(it.ItemType is ParagraphItemType.Narration ? "normal" : "italic")};")">
                                                            <MudChip T="string" Size="Size.Small" Color="@pauseColor" Variant="Variant.Outlined"
                                                                     Icon="@pauseIcon" Class="mt-0"
                                                                     Style="width:100%; justify-content:center;">
                                                                @pauseLabel2
                                                            </MudChip>
                                                            @if (!string.IsNullOrWhiteSpace(it.Text))
                                                            {
                                                                <MudText Typo="Typo.body2">@it.Text</MudText>
                                                            }
                                                            else
                                                            {
                                                                <span></span>
                                                            }
                                                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraphItem(_folderId, it)"
                                                                               IsFirst="@(items[0].Id == it.Id)"
                                                                               IsLast="@(items[^1].Id == it.Id)"
                                                                               OnChanged="StateHasChanged"
                                                                               OnReset="@(() => Presenter.ResetAndLoadAsync(_folderId))" />
                                                        </div>
                                                    }
                                                }
                                            </MudStack>
                                        }
                                    }
                                    else
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body2" Style="flex:1">@string.Join(" ", p.Items.Select(i => i.Text))</MudText>
                                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraph(_folderId, p)"
                                                           IsFirst="@(paragraphs[0].Id == p.Id)"
                                                           IsLast="@(paragraphs[^1].Id == p.Id)"
                                                           OnChanged="@(() => { Presenter.Tree.RemoveParagraph(p.Id); StateHasChanged(); })"
                                                           OnSplit="SplitChapterAsync"
                                                           OnReset="@(() => Presenter.ResetAndLoadAsync(_folderId))" />
                                        </MudStack>
                                    }
                                }
                            </MudStack>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>;

    async Task MergeAndResetAsync((Guid survivorId, Guid deletedId) merge)
    {
        Presenter.Tree.FixMergeExpansion(merge.survivorId, merge.deletedId);
        await Presenter.ResetAndLoadAsync(_folderId);
    }

    Task SplitVolumeAsync((BookCommand command, Guid sourceParentId) split) =>
        Presenter.SplitAndReloadAsync(_folderId, split.command, BookHierarchyPresenter.SplitLevel.Volume, split.sourceParentId);

    Task SplitPartAsync((BookCommand command, Guid sourceParentId) split) =>
        Presenter.SplitAndReloadAsync(_folderId, split.command, BookHierarchyPresenter.SplitLevel.Part, split.sourceParentId);

    Task SplitChapterAsync((BookCommand command, Guid sourceParentId) split) =>
        Presenter.SplitAndReloadAsync(_folderId, split.command, BookHierarchyPresenter.SplitLevel.Chapter, split.sourceParentId);

    EventCallback<bool> VolumeExpandCb(Read2Me.Data.Entities.Volume v) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => Presenter.Tree.OnVolumeExpandedAsync(v, b, StateHasChanged));

    EventCallback<bool> PartExpandCb(Read2Me.Data.Entities.Part p) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => Presenter.Tree.OnPartExpandedAsync(p, b, StateHasChanged));

    EventCallback<bool> ChapterExpandCb(Read2Me.Data.Entities.Chapter c) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => Presenter.Tree.OnChapterExpandedAsync(c, b, StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        _folderId = new ProjectFolderId(FolderName);
        Presenter.StateChanged += StateHasChanged;
        await Presenter.LoadAsync(_folderId);
    }
}
