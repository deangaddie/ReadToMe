@using Read2Me.App.State
@using Read2Me.App.Shared.BookEdits
@using Read2Me.App.Shared.BookMenus
@using Read2Me.App.Shared.BookTree
@using Read2Me.Services.Audio
@using Read2Me.Services.Audio.Assembly
@using Read2Me.Services.NodeStatus
@inject BookHierarchyPresenter Presenter
@inject IDialogService DialogService
@inject AudiobookAssemblyService AssemblyService
@inject AudioQueueService AudioQueue
@inject NodeStatusService NodeStatus
@implements IDisposable

@if (Presenter.IsLoading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (!Presenter.HasContent)
{
    <div style="display:flex; align-items:center; justify-content:center; min-height:300px">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:4rem; opacity:0.3" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Book has not been read in yet.</MudText>
            @if (Presenter.Filename != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Presenter.Filename</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoStories"
                       OnClick="ReadBookAsync" Disabled="Presenter.IsBusy">
                @if (Presenter.IsBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Read Book
            </MudButton>
            @if (Presenter.Error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@Presenter.Error</MudText>
            }
        </MudStack>
    </div>
}
else
{
    @* Bottom padding reserves space so the fixed selection footer never hides content. *@
    <MudStack Spacing="3" Class="pa-3" Style="@($"padding-bottom:{(Presenter.SelectedParagraphCount > 0 || Presenter.SelectedAudioItemCount > 0 ? "72px" : "0")};")">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
            @{
                var audioRemaining = NodeStatus.AudioRemainingForFolder(_folderId);
                var audioSnap = AudioQueue.Snapshot();
                var audioQueueBusy = audioSnap.QueuedCount > 0 || audioSnap.ProcessingCount > 0;
                var assemblyVm = AssemblyButtonViewModel.For(
                    audioRemaining, audioQueueBusy, AssemblyService.IsRunning,
                    AssemblyService.CurrentPhase, AssemblyService.EncodePercent);
                var assembleTooltip = AssemblyService.IsRunning
                    ? "Assembly in progress"
                    : audioRemaining > 0
                        ? $"{audioRemaining} paragraphs missing audio — click to assemble partial"
                        : assemblyVm.DisabledReason ?? "Assemble audiobook";
            }
            <MudTooltip Text="Describe a change in plain language and review the AI's proposed edits">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AutoFixHigh"
                           Disabled="Presenter.IsBusy"
                           OnClick="OpenAiEditDialogAsync">
                    Edit with AI
                </MudButton>
            </MudTooltip>
            <MudTooltip Text="@assembleTooltip">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@(AssemblyService.IsRunning ? null : Icons.Material.Filled.LibraryMusic)"
                           Disabled="@(!assemblyVm.IsEnabled)"
                           OnClick="HandleAssembleClick">
                    @if (AssemblyService.IsRunning)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1"
                                             Style="width:14px; height:14px;" />
                    }
                    Assemble audiobook
                </MudButton>
            </MudTooltip>

            <MudMessageBox @ref="_partialDialog" Title="Assemble partial audiobook" CancelText="Cancel">
                <MessageContent>
                    <MudText>@_partialDialogCount paragraphs are missing audio. The partial audiobook will only include items that have been generated so far. Continue?</MudText>
                </MessageContent>
                <YesButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary">Assemble partial</MudButton>
                </YesButton>
            </MudMessageBox>
            @if (Presenter.Error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@Presenter.Error</MudText>
            }
            <MudToggleGroup T="BookViewMode" Value="Presenter.ViewMode" ValueChanged="@(v => Presenter.SetViewModeAsync(v))"
                            Color="Color.Primary" Size="Size.Small" CheckMark="false" SelectionMode="SelectionMode.SingleSelection">
                <MudToggleItem Value="BookViewMode.Combined">
                    <MudIcon Icon="@Icons.Material.Filled.ViewStream" Size="Size.Small" Class="mr-1" /> Combined
                </MudToggleItem>
                <MudToggleItem Value="BookViewMode.SplitAttribution">
                    <MudIcon Icon="@Icons.Material.Filled.Subject" Size="Size.Small" Class="mr-1" /> Split: Attribution
                </MudToggleItem>
                <MudToggleItem Value="BookViewMode.SplitAudio">
                    <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" Class="mr-1" /> Split: Audio
                </MudToggleItem>
            </MudToggleGroup>
            <MudMessageBox @ref="_rereadDialog" Title="Reread book" CancelText="Cancel">
                <MessageContent>
                    <MudText>This deletes all book data — attribution, generated audio, and edits — and reprocesses the source file from scratch. This cannot be undone. Continue?</MudText>
                </MessageContent>
                <YesButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error">Delete and reread</MudButton>
                </YesButton>
            </MudMessageBox>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Warning"
                                 OnClick="HandleRereadClickAsync" Disabled="Presenter.IsBusy">
                        Reread Book
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.EditNote" IconColor="Color.Info"
                                 OnClick="@(() => Presenter.ManualRereadAsync(_folderId))" Disabled="Presenter.IsBusy">
                        Manual Reread Book
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Title" IconColor="Color.Secondary"
                                 OnClick="@(() => Presenter.AddBookTitleAsync(_folderId))" Disabled="Presenter.IsBusy">
                        Add book title
                    </MudMenuItem>
                    @if (Presenter.Volumes.Count > 1)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.LibraryBooks" IconColor="Color.Secondary"
                                     OnClick="@(() => Presenter.AddVolumeTitlesAsync(_folderId))" Disabled="Presenter.IsBusy">
                            Add volume titles
                        </MudMenuItem>
                    }
                    @if (Presenter.TotalParts > Presenter.Volumes.Count)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.BookmarkBorder" IconColor="Color.Secondary"
                                     OnClick="@(() => Presenter.AddPartTitlesAsync(_folderId))" Disabled="Presenter.IsBusy">
                            Add part titles
                        </MudMenuItem>
                    }
                    @if (Presenter.TotalChapters > Presenter.TotalParts)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.MenuBook" IconColor="Color.Secondary"
                                     OnClick="@(() => Presenter.AddChapterTitlesAsync(_folderId))" Disabled="Presenter.IsBusy">
                            Add chapter titles
                        </MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Pause" IconColor="Color.Secondary"
                                 OnClick="@(() => Presenter.AddPausesAsync(_folderId))" Disabled="Presenter.IsBusy">
                        Add pauses
                    </MudMenuItem>
                </MudMenu>
        </MudStack>

        @if (Presenter.Volumes.Count == 1)
        {
            <VolumePanel Volume="@Presenter.Volumes[0]"
                         FolderId="@_folderId"
                         IsSingleVolume="true"
                         IsFirst="true"
                         IsLast="true"
                         OnChanged="StateHasChanged"
                         OnMerged="MergeAndResetAsync" />
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @for (int i = 0; i < Presenter.Volumes.Count; i++)
                {
                    var vol = Presenter.Volumes[i];
                    var idx = i;
                    <VolumePanel Volume="@vol"
                                 FolderId="@_folderId"
                                 IsSingleVolume="false"
                                 IsFirst="@(idx == 0)"
                                 IsLast="@(idx == Presenter.Volumes.Count - 1)"
                                 PreviousSiblingId="@(idx > 0 ? Presenter.Volumes[idx - 1].Id : null)"
                                 NextSiblingId="@(idx < Presenter.Volumes.Count - 1 ? Presenter.Volumes[idx + 1].Id : null)"
                                 OnChanged="StateHasChanged"
                                 OnMerged="MergeAndResetAsync" />
                }
            </MudExpansionPanels>
        }

    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";
    [Parameter] public EventCallback OnBookImported { get; set; }

    ProjectFolderId _folderId;
    int _partialDialogCount;
    MudMessageBox? _partialDialog;
    MudMessageBox? _rereadDialog;

    async Task HandleRereadClickAsync()
    {
        var confirmed = await _rereadDialog!.ShowAsync();
        if (confirmed == true)
            await Presenter.ConfirmRereadAsync(_folderId);
    }

    async Task HandleAssembleClick()
    {
        var audioRemaining = NodeStatus.AudioRemainingForFolder(_folderId);
        if (audioRemaining > 0)
        {
            _partialDialogCount = audioRemaining;
            var confirmed = await _partialDialog!.ShowAsync();
            if (confirmed == true)
                AssemblyService.StartAsync(_folderId, allowPartial: true);
        }
        else
        {
            AssemblyService.StartAsync(_folderId);
        }
    }

    async Task OpenAiEditDialogAsync()
    {
        var parameters = new DialogParameters<BookEditDialog> { { d => d.FolderId, _folderId } };
        // No titlebar X, no backdrop close: the review phase warns before throwing away hand-edited
        // proposals, and neither of those routes can be intercepted to ask. Every phase carries its
        // own Cancel/Close button instead.
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            BackdropClick = false,
        };
        var dialog = await DialogService.ShowAsync<BookEditDialog>("Edit with AI", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled == false)
            await Presenter.ResetAndLoadAsync(_folderId);
    }

    async Task MergeAndResetAsync((Guid survivorId, Guid deletedId) merge)
    {
        Presenter.NoteMerged(_folderId, merge.survivorId, merge.deletedId);
        await Presenter.ResetAndLoadAsync(_folderId);
    }
    async Task ReadBookAsync()
    {
        await Presenter.ReadBookAsync(_folderId);
        if (Presenter.Error is null)
            await OnBookImported.InvokeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _folderId = new ProjectFolderId(FolderName);
        Presenter.StateChanged -= Refresh;
        Presenter.StateChanged += Refresh;
        await Presenter.LoadAsync(_folderId);
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Presenter.StateChanged -= Refresh;
    }
}
