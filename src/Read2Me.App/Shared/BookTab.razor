@using Read2Me.App.State
@using Read2Me.Core.Models
@using Read2Me.Data.Enums
@inject Read2Me.Services.IProjectReader ProjectReader
@inject Read2Me.Services.IProjectWriter ProjectWriter
@inject Read2Me.Services.UseCases.BookUseCases BookUseCases
@inject BookTreeState TreeState
@inject IDialogService DialogService

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (!_hasContent)
{
    <div style="display:flex; align-items:center; justify-content:center; min-height:300px">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:4rem; opacity:0.3" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Book has not been read in yet.</MudText>
            @if (_filename != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_filename</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoStories"
                       OnClick="ReadBookAsync" Disabled="_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Read Book
            </MudButton>
            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
        </MudStack>
    </div>
}
else
{
    <MudStack Spacing="3" Class="pa-3">
    @{
        RenderFragment<Read2Me.Data.Entities.ParagraphItem> renderItemMenu = item =>
        @<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                  AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                  @onclick:stopPropagation="true">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary"
                         OnClick="@(() => EditParagraphItemAsync(item))">
                Edit Text
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                         OnClick="@(() => DeleteParagraphItemAsync(item))">
                Delete Item
            </MudMenuItem>
        </MudMenu>;

        RenderFragment<Read2Me.Data.Entities.Paragraph> renderParagraphMenu = para =>
        @<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                  AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                  @onclick:stopPropagation="true">
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                         OnClick="@(() => DeleteParagraphAsync(para))">
                Delete Paragraph
            </MudMenuItem>
        </MudMenu>;


        RenderFragment<Read2Me.Data.Entities.Chapter> renderChapterMenu = ch =>
        @<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                  AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                  @onclick:stopPropagation="true">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary"
                         OnClick="@(() => EditChapterAsync(ch))">
                Edit Title
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                         OnClick="@(() => DeleteChapterAsync(ch))">
                Delete Chapter
            </MudMenuItem>
        </MudMenu>;

        RenderFragment<Read2Me.Data.Entities.Part> renderPartMenu = part =>
        @<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                  AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                  @onclick:stopPropagation="true">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary"
                         OnClick="@(() => EditPartAsync(part))">
                Edit Title
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                         OnClick="@(() => DeletePartAsync(part))">
                Delete Part
            </MudMenuItem>
        </MudMenu>;

        RenderFragment<Read2Me.Data.Entities.Volume> renderVolumeMenu = vol =>
        @<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                  AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                  @onclick:stopPropagation="true">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary"
                         OnClick="@(() => EditVolumeAsync(vol))">
                Edit Title
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                         OnClick="@(() => DeleteVolumeAsync(vol))">
                Delete Volume
            </MudMenuItem>
        </MudMenu>;

        RenderFragment<List<Read2Me.Data.Entities.Chapter>> renderChapters = chapters =>
        @<MudExpansionPanels MultiExpansion="true">
            @foreach (var chapter in chapters)
            {
                var ch = chapter;
                <MudExpansionPanel ExpandedChanged="@ChapterExpandCb(ch)">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                            <MudText Style="flex:1">@(ch.Title ?? "Chapter")</MudText>
                            @renderChapterMenu(ch)
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @if (_tree.LoadingIds.Contains(ch.Id))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                        }
                        else if (_tree.LoadedParagraphs.TryGetValue(ch.Id, out var paragraphs))
                        {
                            <MudStack Spacing="2" Class="py-1">
                                @foreach (var para in paragraphs)
                                {
                                    var p = para;
                                    var hasUnknown = _splitView && p.Items.Any(i =>
                                        i.ItemType == ParagraphItemType.Character && i.Character == null);
                                    @if (_splitView)
                                    {
                                        var firstItem = p.Items.FirstOrDefault();
                                        var isPauseParagraph = p.Items.Count == 0
                                            || (p.Items.Count == 1
                                                && firstItem!.ItemType != ParagraphItemType.Character
                                                && firstItem!.ItemType != ParagraphItemType.Narration);
                                        @if (isPauseParagraph)
                                        {
                                            var pauseLabel = firstItem?.ItemType switch
                                            {
                                                ParagraphItemType.ParagraphPause => "Paragraph pause",
                                                ParagraphItemType.ChapterPause   => "Chapter pause",
                                                ParagraphItemType.PartPause      => "Part pause",
                                                ParagraphItemType.VolumePause    => "Volume pause",
                                                ParagraphItemType.Pause          => "Pause",
                                                null                             => "Paragraph pause",
                                                _                                => firstItem!.ItemType.ToString(),
                                            };
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                                                      Style="opacity:0.45;">
                                                <MudText Typo="Typo.caption" Style="flex:1; font-style:italic;">@pauseLabel</MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudStack Spacing="1" Class="pl-2 pr-1 py-1 rounded"
                                                      Style="@($"border-left: 2px solid {(hasUnknown ? "var(--mud-palette-warning)" : "var(--mud-palette-divider)")};{(hasUnknown ? " background: rgba(var(--mud-palette-warning-rgb), 0.06);" : "")}")">
                                                @foreach (var item in p.Items)
                                                {
                                                    var it = item;
                                                    @if (it.ItemType == ParagraphItemType.Character)
                                                    {
                                                        <div style="display:grid; grid-template-columns:120px 1fr auto; align-items:start; gap:4px;">
                                                            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                                                                <ActivatorContent>
                                                                    <MudChip T="string" Size="Size.Small"
                                                                             Color="@(it.Character == null ? Color.Warning : Color.Primary)"
                                                                             Variant="Variant.Filled" Class="mt-0"
                                                                             Style="width:100%; justify-content:center;"
                                                                             OnClick="@(() => {})">
                                                                        @(it.Character?.Name ?? "Unknown")
                                                                    </MudChip>
                                                                </ActivatorContent>
                                                                <ChildContent>
                                                                    <MudMenuItem OnClick="@(() => SetItemCharacterAsync(it, null))">Unknown</MudMenuItem>
                                                                    @foreach (var ch2 in _characters)
                                                                    {
                                                                        var c = ch2;
                                                                        <MudMenuItem OnClick="@(() => SetItemCharacterAsync(it, c.Id))">@c.Name</MudMenuItem>
                                                                    }
                                                                </ChildContent>
                                                            </MudMenu>
                                                            <MudText Typo="Typo.body2">@it.Text</MudText>
                                                            @renderItemMenu(it)
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var (pauseIcon, pauseColor, pauseLabel2) = it.ItemType switch
                                                        {
                                                            ParagraphItemType.VolumePause    => (Icons.Material.Filled.Pause, Color.Secondary, "Volume Pause"),
                                                            ParagraphItemType.PartPause      => (Icons.Material.Filled.Pause, Color.Secondary, "Part Pause"),
                                                            ParagraphItemType.ChapterPause   => (Icons.Material.Filled.Pause, Color.Secondary, "Chapter Pause"),
                                                            ParagraphItemType.ParagraphPause => (Icons.Material.Filled.PauseCircle, Color.Default, "Paragraph Pause"),
                                                            ParagraphItemType.Pause          => (Icons.Material.Filled.PauseCircleOutline, Color.Default, "Pause"),
                                                            ParagraphItemType.Narration      => (Icons.Material.Filled.RecordVoiceOver, Color.Info, "Narration"),
                                                            _                                => (Icons.Material.Filled.HelpOutline, Color.Default, it.ItemType.ToString()),
                                                        };
                                                        <div style="@($"display:grid; grid-template-columns:120px 1fr auto; align-items:center; gap:4px; opacity:{(it.ItemType is ParagraphItemType.Narration ? "1" : "0.6")}; font-style:{(it.ItemType is ParagraphItemType.Narration ? "normal" : "italic")};")">
                                                            <MudChip T="string" Size="Size.Small" Color="@pauseColor" Variant="Variant.Outlined"
                                                                     Icon="@pauseIcon" Class="mt-0"
                                                                     Style="width:100%; justify-content:center;">
                                                                @pauseLabel2
                                                            </MudChip>
                                                            @if (!string.IsNullOrWhiteSpace(it.Text))
                                                            {
                                                                <MudText Typo="Typo.body2">@it.Text</MudText>
                                                            }
                                                            else
                                                            {
                                                                <span></span>
                                                            }
                                                            @renderItemMenu(it)
                                                        </div>
                                                    }
                                                }
                                            </MudStack>
                                        }
                                    }
                                    else
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body2" Style="flex:1">@string.Join(" ", p.Items.Select(i => i.Text))</MudText>
                                            @renderParagraphMenu(p)
                                        </MudStack>
                                    }
                                }
                            </MudStack>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>;
    }
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
            <MudToggleIconButton Toggled="_splitView" ToggledChanged="@((v) => _splitView = v)"
                                 Icon="@Icons.Material.Filled.ViewStream"
                                 ToggledIcon="@Icons.Material.Filled.Subject"
                                 title="Show split items"
                                 toggledTitle="Show original paragraphs"
                                 Size="Size.Small" />
            @if (_confirmReread)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">Delete all book data and reprocess?</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           OnClick="ConfirmRereadeBookAsync" Disabled="_busy">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Confirm
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(() => _confirmReread = false)">
                    Cancel
                </MudButton>
            }
            else
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Warning"
                                 OnClick="@(() => _confirmReread = true)" Disabled="_busy">
                        Reread Book
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.EditNote" IconColor="Color.Info"
                                 OnClick="ManualRereadBookAsync" Disabled="_busy">
                        Manual Reread Book
                    </MudMenuItem>
                </MudMenu>
            }
        </MudStack>

        @if (_volumes.Count == 1)
        {
            var vol = _volumes[0];
            @if (_tree.LoadingIds.Contains(vol.Id))
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
            }
            else if (_tree.LoadedParts.TryGetValue(vol.Id, out var svParts))
            {
                @if (svParts.Count == 1)
                {
                    var p = svParts[0];
                    @if (_tree.LoadingIds.Contains(p.Id))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                    }
                    else if (_tree.LoadedChapters.TryGetValue(p.Id, out var svspChapters))
                    {
                        @renderChapters(svspChapters)
                    }
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true">
                        @foreach (var part in svParts)
                        {
                            var p = part;
                            <MudExpansionPanel ExpandedChanged="@PartExpandCb(p)">
                                <TitleContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                                        <MudText Style="flex:1">@(p.Title ?? "Part")</MudText>
                                        @renderPartMenu(p)
                                    </MudStack>
                                </TitleContent>
                                <ChildContent>
                                    @if (_tree.LoadingIds.Contains(p.Id))
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                    }
                                    else if (_tree.LoadedChapters.TryGetValue(p.Id, out var svmpChapters))
                                    {
                                        @renderChapters(svmpChapters)
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            }
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var volume in _volumes)
                {
                    var vol = volume;
                    <MudExpansionPanel ExpandedChanged="@VolumeExpandCb(vol)">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudText Style="flex:1">@vol.Title</MudText>
                                @renderVolumeMenu(vol)
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @if (_tree.LoadingIds.Contains(vol.Id))
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                            }
                            else if (_tree.LoadedParts.TryGetValue(vol.Id, out var mvParts))
                            {
                                @if (mvParts.Count == 1)
                                {
                                    var p = mvParts[0];
                                    @if (_tree.LoadingIds.Contains(p.Id))
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                    }
                                    else if (_tree.LoadedChapters.TryGetValue(p.Id, out var mvspChapters))
                                    {
                                        @renderChapters(mvspChapters)
                                    }
                                }
                                else
                                {
                                    <MudExpansionPanels MultiExpansion="true">
                                        @foreach (var part in mvParts)
                                        {
                                            var p = part;
                                            <MudExpansionPanel ExpandedChanged="@PartExpandCb(p)">
                                                <TitleContent>
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                                                        <MudText Style="flex:1">@(p.Title ?? "Part")</MudText>
                                                        @renderPartMenu(p)
                                                    </MudStack>
                                                </TitleContent>
                                                <ChildContent>
                                                    @if (_tree.LoadingIds.Contains(p.Id))
                                                    {
                                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                                    }
                                                    else if (_tree.LoadedChapters.TryGetValue(p.Id, out var mvmpChapters))
                                                    {
                                                        @renderChapters(mvmpChapters)
                                                    }
                                                </ChildContent>
                                            </MudExpansionPanel>
                                        }
                                    </MudExpansionPanels>
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";

    bool _loading = true;
    bool _hasContent;
    bool _busy;
    bool _confirmReread;
    bool _splitView;
    string? _filename;
    string? _error;
    Read2Me.Data.Entities.Project? _project;
    List<Read2Me.Data.Entities.Volume> _volumes = [];
    List<Read2Me.Data.Entities.Character> _characters = [];
    PerFolderState _tree = null!;

    EventCallback<bool> VolumeExpandCb(Read2Me.Data.Entities.Volume v) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => _tree.OnVolumeExpandedAsync(v, b, StateHasChanged));

    EventCallback<bool> PartExpandCb(Read2Me.Data.Entities.Part p) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => _tree.OnPartExpandedAsync(p, b, StateHasChanged));

    EventCallback<bool> ChapterExpandCb(Read2Me.Data.Entities.Chapter c) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => _tree.OnChapterExpandedAsync(c, b, StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _tree = TreeState.For(FolderName);
        _confirmReread = false;

        _project = await ProjectReader.GetProjectAsync(FolderName);
        _filename = _project?.Filename;
        _hasContent = await ProjectReader.HasBookContentAsync(FolderName);
        _volumes = _hasContent ? await ProjectReader.GetVolumesAsync(FolderName) : [];
        _characters = _hasContent ? await ProjectReader.GetCharactersAsync(FolderName) : [];

        if (_volumes.Count == 1)
        {
            await _tree.OnVolumeExpandedAsync(_volumes[0], true, () => { });
            if (_tree.LoadedParts.TryGetValue(_volumes[0].Id, out var parts) && parts.Count == 1)
                await _tree.OnPartExpandedAsync(parts[0], true, () => { });
        }

        _loading = false;
    }

    async Task ReadBookAsync()
    {
        _busy = true;
        _error = null;
        var result = await BookUseCases.ImportAsync(FolderName);
        _error = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess) await LoadAsync();
        _busy = false;
    }

    async Task ConfirmRereadeBookAsync()
    {
        _busy = true;
        _error = null;
        var result = await BookUseCases.ImportAsync(FolderName, reread: true);
        _error = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess)
        {
            _tree.Reset();
            await LoadAsync();
        }
        _busy = false;
    }

    async Task ManualRereadBookAsync()
    {
        var dialog = await DialogService.ShowAsync<ManualRereadDialog>("Manual Reread Book");
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        var options = result.Data as ManualReadOptions;
        if (options is null) return;

        _busy = true;
        _error = null;
        var importResult = await BookUseCases.ImportManuallyAsync(FolderName, options);
        _error = importResult.IsSuccess ? null : importResult.Error;
        if (importResult.IsSuccess)
        {
            _tree.Reset();
            await LoadAsync();
        }
        _busy = false;
    }

    async Task SetItemCharacterAsync(Read2Me.Data.Entities.ParagraphItem item, Guid? characterId)
    {
        await ProjectWriter.SetParagraphItemCharacterAsync(FolderName, item.Id, characterId);
        item.CharacterId = characterId;
        item.Character = characterId.HasValue ? _characters.FirstOrDefault(c => c.Id == characterId.Value) : null;
        StateHasChanged();
    }

    async Task DeleteVolumeAsync(Read2Me.Data.Entities.Volume volume)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Volume",
            new DialogParameters<ConfirmDeleteDialog>
            {
                { d => d.ItemType, "Volume" },
                { d => d.ItemName, volume.Title },
                { d => d.HasChildren, true },
            });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        await ProjectWriter.DeleteVolumeAsync(FolderName, volume.Id);
        _tree.Reset();
        await LoadAsync();
    }

    async Task DeletePartAsync(Read2Me.Data.Entities.Part part)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Part",
            new DialogParameters<ConfirmDeleteDialog>
            {
                { d => d.ItemType, "Part" },
                { d => d.ItemName, part.Title ?? "Part" },
                { d => d.HasChildren, true },
            });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        await ProjectWriter.DeletePartAsync(FolderName, part.Id);
        _tree.Reset();
        await LoadAsync();
    }

    async Task DeleteChapterAsync(Read2Me.Data.Entities.Chapter chapter)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Chapter",
            new DialogParameters<ConfirmDeleteDialog>
            {
                { d => d.ItemType, "Chapter" },
                { d => d.ItemName, chapter.Title ?? "Chapter" },
                { d => d.HasChildren, true },
            });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        await ProjectWriter.DeleteChapterAsync(FolderName, chapter.Id);
        _tree.Reset();
        await LoadAsync();
    }

    async Task DeleteParagraphAsync(Read2Me.Data.Entities.Paragraph paragraph)
    {
        var preview = _tree.LoadedParagraphs.Values
            .SelectMany(l => l)
            .FirstOrDefault(p => p.Id == paragraph.Id);
        var label = preview != null
            ? string.Join(" ", preview.Items.Select(i => i.Text)) is var t && t.Length > 60 ? t[..60] + "…" : t
            : "this paragraph";

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Paragraph",
            new DialogParameters<ConfirmDeleteDialog>
            {
                { d => d.ItemType, "Paragraph" },
                { d => d.ItemName, label },
                { d => d.HasChildren, false },
            });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        await ProjectWriter.DeleteParagraphAsync(FolderName, paragraph.Id);
        foreach (var list in _tree.LoadedParagraphs.Values)
            list.RemoveAll(p => p.Id == paragraph.Id);
        StateHasChanged();
    }

    static readonly DialogOptions _editDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    async Task EditVolumeAsync(Read2Me.Data.Entities.Volume volume)
    {
        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Volume Title",
            new DialogParameters<EditTextDialog>
            {
                { d => d.Label, "Title" },
                { d => d.InitialValue, volume.Title },
            }, _editDialogOptions);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var text = result.Data as string;
        if (string.IsNullOrWhiteSpace(text)) return;
        await ProjectWriter.UpdateVolumeTitleAsync(FolderName, volume.Id, text);
        volume.Title = text;
        StateHasChanged();
    }

    async Task EditPartAsync(Read2Me.Data.Entities.Part part)
    {
        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Part Title",
            new DialogParameters<EditTextDialog>
            {
                { d => d.Label, "Title" },
                { d => d.InitialValue, part.Title ?? "" },
            }, _editDialogOptions);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var text = result.Data as string;
        if (string.IsNullOrWhiteSpace(text)) return;
        await ProjectWriter.UpdatePartTitleAsync(FolderName, part.Id, text);
        part.Title = text;
        StateHasChanged();
    }

    async Task EditChapterAsync(Read2Me.Data.Entities.Chapter chapter)
    {
        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Chapter Title",
            new DialogParameters<EditTextDialog>
            {
                { d => d.Label, "Title" },
                { d => d.InitialValue, chapter.Title ?? "" },
            }, _editDialogOptions);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var text = result.Data as string;
        if (string.IsNullOrWhiteSpace(text)) return;
        await ProjectWriter.UpdateChapterTitleAsync(FolderName, chapter.Id, text);
        chapter.Title = text;
        StateHasChanged();
    }

    async Task EditParagraphItemAsync(Read2Me.Data.Entities.ParagraphItem item)
    {
        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Item Text",
            new DialogParameters<EditTextDialog>
            {
                { d => d.Label, "Text" },
                { d => d.InitialValue, item.Text ?? "" },
                { d => d.Lines, 4 },
            }, _editDialogOptions);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var text = result.Data as string;
        if (string.IsNullOrWhiteSpace(text)) return;
        await ProjectWriter.UpdateParagraphItemTextAsync(FolderName, item.Id, text);
        item.Text = text;
        StateHasChanged();
    }

    async Task DeleteParagraphItemAsync(Read2Me.Data.Entities.ParagraphItem item)
    {
        var label = item.Text?.Length > 60 ? item.Text[..60] + "…" : item.Text ?? "this item";

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Item",
            new DialogParameters<ConfirmDeleteDialog>
            {
                { d => d.ItemType, "Item" },
                { d => d.ItemName, label },
                { d => d.HasChildren, false },
            });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        await ProjectWriter.DeleteParagraphItemAsync(FolderName, item.Id);
        foreach (var list in _tree.LoadedParagraphs.Values)
            foreach (var para in list)
                para.Items.Remove(item);
        StateHasChanged();
    }
}
