@using Read2Me.App.State
@using Read2Me.Data.Enums
@inject Read2Me.Services.IProjectReader ProjectReader
@inject Read2Me.Services.IProjectWriter ProjectWriter
@inject Read2Me.Services.UseCases.BookUseCases BookUseCases
@inject BookTreeState TreeState

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (!_hasContent)
{
    <div style="display:flex; align-items:center; justify-content:center; min-height:300px">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:4rem; opacity:0.3" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Book has not been read in yet.</MudText>
            @if (_filename != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_filename</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoStories"
                       OnClick="ReadBookAsync" Disabled="_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Read Book
            </MudButton>
            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
        </MudStack>
    </div>
}
else
{
    <MudStack Spacing="3" Class="pa-3">
    @{
        RenderFragment<List<Read2Me.Data.Entities.Chapter>> renderChapters = chapters =>
        @<MudExpansionPanels MultiExpansion="true">
            @foreach (var chapter in chapters)
            {
                var ch = chapter;
                <MudExpansionPanel Text="@(ch.Title ?? "Chapter")" ExpandedChanged="@ChapterExpandCb(ch)">
                    @if (_tree.LoadingIds.Contains(ch.Id))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                    }
                    else if (_tree.LoadedParagraphs.TryGetValue(ch.Id, out var paragraphs))
                    {
                        <MudStack Spacing="2" Class="py-1">
                            @foreach (var para in paragraphs)
                            {
                                var hasUnknown = _splitView && para.Items.Any(i =>
                                    i.ItemType == ParagraphItemType.Character && i.Character == null);
                                @if (_splitView)
                                {
                                    <MudStack Spacing="1" Class="pl-2 pr-1 py-1 rounded"
                                              Style="@($"border-left: 2px solid {(hasUnknown ? "var(--mud-palette-warning)" : "var(--mud-palette-divider)")};{(hasUnknown ? " background: rgba(var(--mud-palette-warning-rgb), 0.06);" : "")}")">
                                        @foreach (var item in para.Items)
                                        {
                                            var it = item;
                                            @if (it.ItemType == ParagraphItemType.Character)
                                            {
                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                    <MudSelect T="Guid?" Value="@it.CharacterId"
                                                               ValueChanged="@((Guid? v) => SetItemCharacterAsync(it, v))"
                                                               Dense="true" Margin="Margin.Dense" Variant="Variant.Text"
                                                               Style="min-width:120px; max-width:180px"
                                                               Placeholder="@(it.Character?.Name ?? "Unknown")"
                                                               AnchorOrigin="Origin.BottomLeft">
                                                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unknown</MudSelectItem>
                                                        @foreach (var ch2 in _characters)
                                                        {
                                                            var c = ch2;
                                                            <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@c.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                    <MudText Typo="Typo.body2">@it.Text</MudText>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="mt-0">@it.ItemType.ToString()</MudChip>
                                                    <MudText Typo="Typo.body2">@it.Text</MudText>
                                                </MudStack>
                                            }
                                        }
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">@string.Join(" ", para.Items.Select(i => i.Text))</MudText>
                                }
                            }
                        </MudStack>
                    }
                </MudExpansionPanel>
            }
        </MudExpansionPanels>;
    }
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
            @if (_error != null)
            {
                <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
            }
            <MudToggleIconButton Toggled="_splitView" ToggledChanged="@((v) => _splitView = v)"
                                 Icon="@Icons.Material.Filled.ViewStream"
                                 ToggledIcon="@Icons.Material.Filled.Subject"
                                 title="Show split items"
                                 toggledTitle="Show original paragraphs"
                                 Size="Size.Small" />
            @if (_confirmReread)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">Delete all book data and reprocess?</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           OnClick="ConfirmRereadeBookAsync" Disabled="_busy">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Confirm
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(() => _confirmReread = false)">
                    Cancel
                </MudButton>
            }
            else
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Warning"
                                 OnClick="@(() => _confirmReread = true)" Disabled="_busy">
                        Reread Book
                    </MudMenuItem>
                </MudMenu>
            }
        </MudStack>

        @if (_volumes.Count == 1)
        {
            var vol = _volumes[0];
            @if (_tree.LoadingIds.Contains(vol.Id))
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
            }
            else if (_tree.LoadedParts.TryGetValue(vol.Id, out var svParts))
            {
                @if (svParts.Count == 1)
                {
                    var p = svParts[0];
                    @if (_tree.LoadingIds.Contains(p.Id))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                    }
                    else if (_tree.LoadedChapters.TryGetValue(p.Id, out var svspChapters))
                    {
                        @renderChapters(svspChapters)
                    }
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true">
                        @foreach (var part in svParts)
                        {
                            var p = part;
                            <MudExpansionPanel Text="@(p.Title ?? "Part")" ExpandedChanged="@PartExpandCb(p)">
                                @if (_tree.LoadingIds.Contains(p.Id))
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                }
                                else if (_tree.LoadedChapters.TryGetValue(p.Id, out var svmpChapters))
                                {
                                    @renderChapters(svmpChapters)
                                }
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            }
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var volume in _volumes)
                {
                    var vol = volume;
                    <MudExpansionPanel Text="@vol.Title" ExpandedChanged="@VolumeExpandCb(vol)">
                        @if (_tree.LoadingIds.Contains(vol.Id))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                        }
                        else if (_tree.LoadedParts.TryGetValue(vol.Id, out var mvParts))
                        {
                            @if (mvParts.Count == 1)
                            {
                                var p = mvParts[0];
                                @if (_tree.LoadingIds.Contains(p.Id))
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                }
                                else if (_tree.LoadedChapters.TryGetValue(p.Id, out var mvspChapters))
                                {
                                    @renderChapters(mvspChapters)
                                }
                            }
                            else
                            {
                                <MudExpansionPanels MultiExpansion="true">
                                    @foreach (var part in mvParts)
                                    {
                                        var p = part;
                                        <MudExpansionPanel Text="@(p.Title ?? "Part")" ExpandedChanged="@PartExpandCb(p)">
                                            @if (_tree.LoadingIds.Contains(p.Id))
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                                            }
                                            else if (_tree.LoadedChapters.TryGetValue(p.Id, out var mvmpChapters))
                                            {
                                                @renderChapters(mvmpChapters)
                                            }
                                        </MudExpansionPanel>
                                    }
                                </MudExpansionPanels>
                            }
                        }
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";

    bool _loading = true;
    bool _hasContent;
    bool _busy;
    bool _confirmReread;
    bool _splitView;
    string? _filename;
    string? _error;
    Read2Me.Data.Entities.Project? _project;
    List<Read2Me.Data.Entities.Volume> _volumes = [];
    List<Read2Me.Data.Entities.Character> _characters = [];
    PerFolderState _tree = null!;

    EventCallback<bool> VolumeExpandCb(Read2Me.Data.Entities.Volume v) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => _tree.OnVolumeExpandedAsync(v, b, StateHasChanged));

    EventCallback<bool> PartExpandCb(Read2Me.Data.Entities.Part p) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => _tree.OnPartExpandedAsync(p, b, StateHasChanged));

    EventCallback<bool> ChapterExpandCb(Read2Me.Data.Entities.Chapter c) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => _tree.OnChapterExpandedAsync(c, b, StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _tree = TreeState.For(FolderName);
        _confirmReread = false;

        _project = await ProjectReader.GetProjectAsync(FolderName);
        _filename = _project?.Filename;
        _hasContent = await ProjectReader.HasBookContentAsync(FolderName);
        _volumes = _hasContent ? await ProjectReader.GetVolumesAsync(FolderName) : [];
        _characters = _hasContent ? await ProjectReader.GetCharactersAsync(FolderName) : [];

        if (_volumes.Count == 1)
        {
            await _tree.OnVolumeExpandedAsync(_volumes[0], true, () => { });
            if (_tree.LoadedParts.TryGetValue(_volumes[0].Id, out var parts) && parts.Count == 1)
                await _tree.OnPartExpandedAsync(parts[0], true, () => { });
        }

        _loading = false;
    }

    async Task ReadBookAsync()
    {
        _busy = true;
        _error = null;
        var result = await BookUseCases.ImportAsync(FolderName);
        _error = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess) await LoadAsync();
        _busy = false;
    }

    async Task ConfirmRereadeBookAsync()
    {
        _busy = true;
        _error = null;
        var result = await BookUseCases.ImportAsync(FolderName, reread: true);
        _error = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess)
        {
            _tree.Reset();
            await LoadAsync();
        }
        _busy = false;
    }

    async Task SetItemCharacterAsync(Read2Me.Data.Entities.ParagraphItem item, Guid? characterId)
    {
        await ProjectWriter.SetParagraphItemCharacterAsync(FolderName, item.Id, characterId);
        item.CharacterId = characterId;
        item.Character = characterId.HasValue ? _characters.FirstOrDefault(c => c.Id == characterId.Value) : null;
        StateHasChanged();
    }
}
