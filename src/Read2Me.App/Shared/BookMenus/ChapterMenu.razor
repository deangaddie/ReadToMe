@using Read2Me.Data.Entities
@using Read2Me.Core.Models
@inject Read2Me.Services.IBookCommandHandler CommandHandler
@inject IDialogService DialogService

<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
         @onclick:stopPropagation="true">
    <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary"
                 OnClick="EditAsync">Edit Title</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.CallSplit" IconColor="Color.Info"
                 OnClick="SplitPartAsync">Split Part</MudMenuItem>
    @if (!IsFirst)
    {
        <MudMenuItem Icon="@Icons.Material.Filled.MergeType" IconColor="Color.Secondary"
                     OnClick="MergeWithPreviousAsync">Merge with Previous</MudMenuItem>
    }
    @if (!IsLast)
    {
        <MudMenuItem Icon="@Icons.Material.Filled.MergeType" IconColor="Color.Secondary"
                     OnClick="MergeWithNextAsync">Merge with Next</MudMenuItem>
    }
    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                 OnClick="DeleteAsync">Delete Chapter</MudMenuItem>
</MudMenu>

@code {
    [Parameter, EditorRequired] public Chapter Chapter { get; set; } = null!;
    [Parameter, EditorRequired] public string FolderName { get; set; } = "";
    [Parameter, EditorRequired] public bool IsFirst { get; set; }
    [Parameter, EditorRequired] public bool IsLast { get; set; }
    [Parameter] public Guid? PreviousSiblingId { get; set; }
    [Parameter] public Guid? NextSiblingId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback<(Guid survivorId, Guid deletedId)> OnMerged { get; set; }
    [Parameter] public EventCallback<(BookCommand command, Guid sourceParentId)> OnSplit { get; set; }

    static readonly DialogOptions _editOpts = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    async Task EditAsync()
    {
        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Chapter Title",
            new DialogParameters<EditTextDialog>
            {
                { d => d.Label, "Title" },
                { d => d.InitialValue, Chapter.Title ?? "" },
            }, _editOpts);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var text = result.Data as string;
        if (string.IsNullOrWhiteSpace(text)) return;
        await CommandHandler.ExecuteAsync(new UpdateChapterTitleCommand(FolderName, Chapter.Id, text));
        Chapter.Title = text;
        await OnChanged.InvokeAsync();
    }

    async Task SplitPartAsync()
    {
        var dialog = await DialogService.ShowAsync<EditTextDialog>("New Part Title",
            new DialogParameters<EditTextDialog>
            {
                { d => d.Label, "Title" },
                { d => d.InitialValue, "" },
            }, _editOpts);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var title = result.Data as string;
        var command = new SplitAtChapterCommand(FolderName, Chapter.Id, string.IsNullOrWhiteSpace(title) ? null : title);
        // New Part is created; source parent panel is the Part holding this Chapter.
        await OnSplit.InvokeAsync((command, Chapter.PartId));
    }

    async Task MergeWithPreviousAsync()
    {
        await CommandHandler.ExecuteAsync(new MergeChapterCommand(FolderName, Chapter.Id, MergeDirection.Previous));
        if (PreviousSiblingId.HasValue)
            await OnMerged.InvokeAsync((PreviousSiblingId.Value, Chapter.Id));
        else
            await OnReset.InvokeAsync();
    }

    async Task MergeWithNextAsync()
    {
        await CommandHandler.ExecuteAsync(new MergeChapterCommand(FolderName, Chapter.Id, MergeDirection.Next));
        if (NextSiblingId.HasValue)
            await OnMerged.InvokeAsync((Chapter.Id, NextSiblingId.Value));
        else
            await OnReset.InvokeAsync();
    }

    async Task DeleteAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Chapter",
            new DialogParameters<ConfirmDeleteDialog>
            {
                { d => d.ItemType, "Chapter" },
                { d => d.ItemName, Chapter.Title ?? "Chapter" },
                { d => d.HasChildren, true },
            });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        await CommandHandler.ExecuteAsync(new DeleteChapterCommand(FolderName, Chapter.Id));
        await OnReset.InvokeAsync();
    }
}
