@inject MenuActions Menu
@inject BookHierarchyPresenter Presenter

<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
         @onclick:stopPropagation="true">
    @if (Spec.EditLabel != null)
    {
        <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary"
                     OnClick="EditAsync">@Spec.EditLabel</MudMenuItem>
    }
    @if (Spec.Splits.Count > 0)
    {
        @if (Spec.EditLabel != null)
        {
            <MudDivider />
        }
        @foreach (var split in Spec.Splits)
        {
            var s = split;
            <MudMenuItem Icon="@Icons.Material.Filled.CallSplit" IconColor="Color.Info"
                         OnClick="@(() => SplitAsync(s))">@s.Label</MudMenuItem>
        }
    }
    @if (!IsFirst || !IsLast)
    {
        <MudDivider />
        @if (!IsFirst)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.MergeType" IconColor="Color.Secondary"
                         OnClick="MergeWithPreviousAsync">Merge with Previous</MudMenuItem>
        }
        @if (!IsLast)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.MergeType" IconColor="Color.Secondary"
                         OnClick="MergeWithNextAsync">Merge with Next</MudMenuItem>
        }
    }
    @if (Spec.InsertItems.Count > 0)
    {
        <MudDivider />
        @foreach (var ins in Spec.InsertItems)
        {
            var i = ins;
            <MudMenuItem Icon="@(i.Position == InsertPosition.Before ? Icons.Material.Filled.VerticalAlignTop : Icons.Material.Filled.VerticalAlignBottom)"
                         IconColor="Color.Success"
                         OnClick="@(() => InsertItemAsync(i))">@i.Label</MudMenuItem>
        }
    }
    @if (Spec.InsertPausesBefore.Count > 0)
    {
        <MudDivider />
        @foreach (var p in Spec.InsertPausesBefore)
        {
            var ps = p;
            <MudMenuItem Icon="@Icons.Material.Filled.VerticalAlignTop" IconColor="Color.Tertiary"
                         OnClick="@(() => InsertPauseAsync(ps, InsertPosition.Before))">Insert @ps.Label Before</MudMenuItem>
        }
    }
    @if (Spec.InsertPausesAfter.Count > 0)
    {
        <MudDivider />
        @foreach (var p in Spec.InsertPausesAfter)
        {
            var ps = p;
            <MudMenuItem Icon="@Icons.Material.Filled.VerticalAlignBottom" IconColor="Color.Tertiary"
                         OnClick="@(() => InsertPauseAsync(ps, InsertPosition.After))">Insert @ps.Label After</MudMenuItem>
        }
    }
    <MudDivider />
    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                 OnClick="DeleteAsync">@Spec.DeleteLabel</MudMenuItem>
</MudMenu>

@code {
    [Parameter, EditorRequired] public BookNodeMenuSpec Spec { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsFirst { get; set; }
    [Parameter, EditorRequired] public bool IsLast { get; set; }
    [Parameter] public Guid? PreviousSiblingId { get; set; }
    [Parameter] public Guid? NextSiblingId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback<(Guid survivorId, Guid deletedId)> OnMerged { get; set; }

    async Task EditAsync()
    {
        if (Spec.EditAction == null) return;
        var (command, updateLocal) = await Spec.EditAction(Menu);
        if (command == null) return;
        await Menu.ExecuteAsync(command);
        if (updateLocal != null) await updateLocal();
        await OnChanged.InvokeAsync();
    }

    // Splits, item insertion and pause insertion all cross BookMutations: the Book View is coherent
    // again — expansion carried onto the new sibling included — before these return, so none of them
    // fires a reload of its own (ADR 0007).
    async Task SplitAsync(SplitSpec split)
    {
        var mutation = await split.Build(Menu);
        if (mutation == null) return;
        await Presenter.MutateAsync(mutation);
    }

    async Task MergeWithPreviousAsync()
    {
        await Menu.ExecuteAsync(MenuActions.BuildMerge(Spec.FolderId, Spec.Kind, Spec.EntityId, MergeDirection.Previous));
        if (Spec.MergeResetsTree)
            await OnReset.InvokeAsync();
        else if (PreviousSiblingId.HasValue)
            await OnMerged.InvokeAsync((PreviousSiblingId.Value, Spec.EntityId));
        else
            await OnReset.InvokeAsync();
    }

    async Task MergeWithNextAsync()
    {
        await Menu.ExecuteAsync(MenuActions.BuildMerge(Spec.FolderId, Spec.Kind, Spec.EntityId, MergeDirection.Next));
        if (Spec.MergeResetsTree)
            await OnReset.InvokeAsync();
        else if (NextSiblingId.HasValue)
            await OnMerged.InvokeAsync((Spec.EntityId, NextSiblingId.Value));
        else
            await OnReset.InvokeAsync();
    }

    async Task DeleteAsync()
    {
        var (itemType, itemName, hasChildren) = Spec.GetDeleteConfirmArgs();
        if (!await Menu.ConfirmDeleteAsync(itemType, itemName, hasChildren)) return;
        await Menu.ExecuteAsync(MenuActions.BuildDelete(Spec.FolderId, Spec.Kind, Spec.EntityId));
        if (Spec.DeleteCallsChanged)
            await OnChanged.InvokeAsync();
        else
            await OnReset.InvokeAsync();
    }

    async Task InsertItemAsync(InsertItemSpec spec)
    {
        var mutation = await spec.Build(Menu);
        if (mutation == null) return;
        await Presenter.MutateAsync(mutation);
    }

    Task InsertPauseAsync(InsertPauseSpec spec, InsertPosition position) =>
        Presenter.MutateAsync(new InsertPauseParagraphMutation(Spec.FolderId, Spec.EntityId, position, spec.PauseKind));
}
