@if (ProviderType == ParagraphTtsServiceType.Qwen3Base)
{
    <MudStack Spacing="2">
        <MudSelect T="string" Value="_qbSettings.Language" Label="Language" Variant="Variant.Outlined"
                   ValueChanged="@((string v) => QbOnFieldChanged(s => s with { Language = v }))">
            @foreach (var lang in new[] { "auto", "en", "zh", "ja", "ko", "de", "fr", "ru", "pt", "es", "it" })
            {
                <MudSelectItem Value="@lang">@lang</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="double?" Value="_qbSettings.Temperature" Label="Temperature"
                         Variant="Variant.Outlined" Immediate="true"
                         Min="0.0" Max="2.0" Step="0.05"
                         HelperText="Sampling randomness. Leave blank to use server default."
                         ValueChanged="@((double? v) => QbOnFieldChanged(s => s with { Temperature = v }))" />

        <MudNumericField T="double?" Value="_qbSettings.TopP" Label="Top P"
                         Variant="Variant.Outlined" Immediate="true"
                         Min="0.0" Max="1.0" Step="0.01"
                         HelperText="Nucleus sampling ceiling. Leave blank to use server default."
                         ValueChanged="@((double? v) => QbOnFieldChanged(s => s with { TopP = v }))" />

        <MudNumericField T="int?" Value="_qbSettings.TopK" Label="Top K"
                         Variant="Variant.Outlined" Immediate="true"
                         Min="1"
                         HelperText="Top-K sampling cutoff. Leave blank to use server default."
                         ValueChanged="@((int? v) => QbOnFieldChanged(s => s with { TopK = v }))" />

        <MudNumericField T="double?" Value="_qbSettings.RepetitionPenalty" Label="Repetition Penalty"
                         Variant="Variant.Outlined" Immediate="true"
                         Min="1.0" Max="2.0" Step="0.05"
                         HelperText="Penalizes repeated tokens. Leave blank to use server default."
                         ValueChanged="@((double? v) => QbOnFieldChanged(s => s with { RepetitionPenalty = v }))" />

        <MudNumericField T="int?" Value="_qbSettings.MaxNewTokens" Label="Max New Tokens"
                         Variant="Variant.Outlined" Immediate="true"
                         Min="1"
                         HelperText="Caps generated token count. Leave blank to use server default."
                         ValueChanged="@((int? v) => QbOnFieldChanged(s => s with { MaxNewTokens = v }))" />

        <MudButton StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="QbResetToDefault">
            Return to default
        </MudButton>
    </MudStack>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public ParagraphTtsServiceType ProviderType { get; set; }
    [Parameter] public TtsSettingsEditorMode Mode { get; set; }
    [Parameter] public string? ProviderDefaultsJson { get; set; }

    // ProviderDefaults mode: tracks full settings object
    private VoxCpm2ParagraphTtsSettings _settings = VoxCpm2ParagraphTtsSettings.Recommended;

    // VoiceOverride mode: base = provider config, effective = base + patch applied
    private VoxCpm2ParagraphTtsSettings _base = VoxCpm2ParagraphTtsSettings.Recommended;
    private VoxCpm2ParagraphTtsSettings _effective = VoxCpm2ParagraphTtsSettings.Recommended;
    private string _baseJson = "";

    // Chatterbox: same ProviderDefaults/VoiceOverride split as VoxCPM2 above, distinct record type.
    private ChatterboxParagraphTtsSettings _cbSettings = ChatterboxParagraphTtsSettings.Recommended;
    private ChatterboxParagraphTtsSettings _cbBase = ChatterboxParagraphTtsSettings.Recommended;
    private ChatterboxParagraphTtsSettings _cbEffective = ChatterboxParagraphTtsSettings.Recommended;
    private string _cbBaseJson = "";

    // ChatterboxTurbo: same ProviderDefaults/VoiceOverride split, distinct record type.
    private ChatterboxTurboParagraphTtsSettings _cbtSettings = ChatterboxTurboParagraphTtsSettings.Recommended;
    private ChatterboxTurboParagraphTtsSettings _cbtBase = ChatterboxTurboParagraphTtsSettings.Recommended;
    private ChatterboxTurboParagraphTtsSettings _cbtEffective = ChatterboxTurboParagraphTtsSettings.Recommended;
    private string _cbtBaseJson = "";

    // Qwen3Base: ProviderDefaults mode only (no VoiceOverride diff support).
    private Qwen3ParagraphTtsSettings _qbSettings = Qwen3ParagraphTtsSettings.Recommended;

    private static readonly JsonSerializerOptions _jsonOpts =
        new(JsonSerializerDefaults.Web);

    protected override void OnParametersSet()
    {
        if (ProviderType == ParagraphTtsServiceType.VoxCpm2)
        {
            if (Mode == TtsSettingsEditorMode.VoiceOverride)
            {
                _baseJson = string.IsNullOrWhiteSpace(ProviderDefaultsJson)
                    ? JsonSerializer.Serialize(VoxCpm2ParagraphTtsSettings.Recommended, _jsonOpts)
                    : ProviderDefaultsJson;

                _base = JsonSerializer.Deserialize<VoxCpm2ParagraphTtsSettings>(_baseJson, _jsonOpts)
                        ?? VoxCpm2ParagraphTtsSettings.Recommended;

                _effective = VoxCpm2ParagraphTtsSettingsDiff.Apply(_baseJson, Value);
            }
            else
            {
                _settings = string.IsNullOrWhiteSpace(Value)
                    ? VoxCpm2ParagraphTtsSettings.Recommended
                    : JsonSerializer.Deserialize<VoxCpm2ParagraphTtsSettings>(Value, _jsonOpts)
                      ?? VoxCpm2ParagraphTtsSettings.Recommended;
                _effective = _settings;
            }
            return;
        }

        if (ProviderType == ParagraphTtsServiceType.Chatterbox)
        {
            if (Mode == TtsSettingsEditorMode.VoiceOverride)
            {
                _cbBaseJson = string.IsNullOrWhiteSpace(ProviderDefaultsJson)
                    ? JsonSerializer.Serialize(ChatterboxParagraphTtsSettings.Recommended, _jsonOpts)
                    : ProviderDefaultsJson;

                _cbBase = JsonSerializer.Deserialize<ChatterboxParagraphTtsSettings>(_cbBaseJson, _jsonOpts)
                        ?? ChatterboxParagraphTtsSettings.Recommended;

                _cbEffective = ChatterboxParagraphTtsSettingsDiff.Apply(_cbBaseJson, Value);
            }
            else
            {
                _cbSettings = string.IsNullOrWhiteSpace(Value)
                    ? ChatterboxParagraphTtsSettings.Recommended
                    : JsonSerializer.Deserialize<ChatterboxParagraphTtsSettings>(Value, _jsonOpts)
                      ?? ChatterboxParagraphTtsSettings.Recommended;
                _cbEffective = _cbSettings;
            }
            return;
        }

        if (ProviderType == ParagraphTtsServiceType.ChatterboxTurbo)
        {
            if (Mode == TtsSettingsEditorMode.VoiceOverride)
            {
                _cbtBaseJson = string.IsNullOrWhiteSpace(ProviderDefaultsJson)
                    ? JsonSerializer.Serialize(ChatterboxTurboParagraphTtsSettings.Recommended, _jsonOpts)
                    : ProviderDefaultsJson;

                _cbtBase = JsonSerializer.Deserialize<ChatterboxTurboParagraphTtsSettings>(_cbtBaseJson, _jsonOpts)
                        ?? ChatterboxTurboParagraphTtsSettings.Recommended;

                _cbtEffective = ChatterboxTurboParagraphTtsSettingsDiff.Apply(_cbtBaseJson, Value);
            }
            else
            {
                _cbtSettings = string.IsNullOrWhiteSpace(Value)
                    ? ChatterboxTurboParagraphTtsSettings.Recommended
                    : JsonSerializer.Deserialize<ChatterboxTurboParagraphTtsSettings>(Value, _jsonOpts)
                      ?? ChatterboxTurboParagraphTtsSettings.Recommended;
                _cbtEffective = _cbtSettings;
            }
            return;
        }

        if (ProviderType == ParagraphTtsServiceType.Qwen3Base)
        {
            _qbSettings = string.IsNullOrWhiteSpace(Value)
                ? Qwen3ParagraphTtsSettings.Recommended
                : JsonSerializer.Deserialize<Qwen3ParagraphTtsSettings>(Value, _jsonOpts)
                  ?? Qwen3ParagraphTtsSettings.Recommended;
        }
    }

    private bool IsOverridden(string jsonKey)
    {
        var patch = VoxCpm2ParagraphTtsSettingsDiff.Diff(_baseJson, _effective);
        var obj = JsonNode.Parse(patch)?.AsObject();
        return obj?.ContainsKey(jsonKey) == true;
    }

    private string? FieldStyle(string jsonKey)
    {
        if (Mode != TtsSettingsEditorMode.VoiceOverride) return null;
        return IsOverridden(jsonKey) ? "border-left: 3px solid var(--mud-palette-warning);" : null;
    }

    private void OnFieldChanged(Func<VoxCpm2ParagraphTtsSettings, VoxCpm2ParagraphTtsSettings> update)
    {
        if (Mode == TtsSettingsEditorMode.VoiceOverride)
        {
            _effective = update(_effective);
            _ = EmitOverrideAsync();
        }
        else
        {
            _settings = update(_settings);
            _ = EmitAsync();
        }
    }

    private async Task EmitAsync()
    {
        var json = JsonSerializer.Serialize(_settings, _jsonOpts);
        await ValueChanged.InvokeAsync(json);
    }

    private async Task EmitOverrideAsync()
    {
        var patch = VoxCpm2ParagraphTtsSettingsDiff.Diff(_baseJson, _effective);
        await ValueChanged.InvokeAsync(patch);
    }

    private async Task ResetToDefault()
    {
        if (Mode == TtsSettingsEditorMode.VoiceOverride)
        {
