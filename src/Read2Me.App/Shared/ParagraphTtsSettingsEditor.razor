@using Read2Me.Services.Audio.ParagraphTts.Settings
@using System.Text.Json
@using System.Text.Json.Nodes

@if (ProviderType == ParagraphTtsServiceType.VoxCpm2)
{
    <MudStack Spacing="2">
        <MudStack Spacing="0" Style="@FieldStyle("cfg_value")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">CFG Value</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@_effective.CfgValue.ToString("F1")</MudText>
                    @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("cfg_value"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                                       OnClick="@(() => ResetField(b => _effective with { CfgValue = b.CfgValue }))" />
                    }
                </MudStack>
            </MudStack>
            <MudSlider T="double" Value="_effective.CfgValue" Min="1.0" Max="5.0" Step="0.1"
                       ValueChanged="@((double v) => OnFieldChanged(s => s with { CfgValue = v }))" />
            <MudText Typo="Typo.caption" Color="Color.Default">Guidance scale — higher = closer to design prompt. (1.0–5.0)</MudText>
        </MudStack>

        <MudStack Spacing="0" Style="@FieldStyle("inference_timesteps")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">LocDiT Steps</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@_effective.InferenceTimesteps</MudText>
                    @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("inference_timesteps"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                                       OnClick="@(() => ResetField(b => _effective with { InferenceTimesteps = b.InferenceTimesteps }))" />
                    }
                </MudStack>
            </MudStack>
            <MudSlider T="int" Value="_effective.InferenceTimesteps" Min="1" Max="50" Step="1"
                       ValueChanged="@((int v) => OnFieldChanged(s => s with { InferenceTimesteps = v }))" />
            <MudText Typo="Typo.caption" Color="Color.Default">Flow-matching diffusion steps — speed vs quality. (1–50)</MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="int" Value="_effective.MinLen" Label="Min Length (s)"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="1" Max="100"
                             HelperText="Minimum output length in seconds."
                             Style="@FieldStyle("min_len")"
                             ValueChanged="@((int v) => OnFieldChanged(s => s with { MinLen = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("min_len"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { MinLen = b.MinLen }))" />
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="int" Value="_effective.MaxLen" Label="Max Length (tokens)"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="10" Max="8192"
                             HelperText="Maximum output length in tokens (server caps at 8192)."
                             Style="@FieldStyle("max_len")"
                             ValueChanged="@((int v) => OnFieldChanged(s => s with { MaxLen = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("max_len"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { MaxLen = b.MaxLen }))" />
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudCheckBox T="bool" Value="_effective.Normalize" Label="Text Normalization"
                         Style="@FieldStyle("normalize")"
                         ValueChanged="@((bool v) => OnFieldChanged(s => s with { Normalize = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("normalize"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { Normalize = b.Normalize }))" />
            }
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Default">Expand numbers, dates, abbreviations.</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudCheckBox T="bool" Value="_effective.Denoise" Label="Denoise Reference Audio"
                         Style="@FieldStyle("denoise")"
                         ValueChanged="@((bool v) => OnFieldChanged(s => s with { Denoise = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("denoise"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { Denoise = b.Denoise }))" />
            }
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Default">Clean the reference audio (ZipEnhancer).</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudCheckBox T="bool" Value="_effective.RetryBadcase" Label="Retry Bad Cases"
                         Style="@FieldStyle("retry_badcase")"
                         ValueChanged="@((bool v) => OnFieldChanged(s => s with { RetryBadcase = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("retry_badcase"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { RetryBadcase = b.RetryBadcase }))" />
            }
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Default">Re-synthesize when a bad result is detected.</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="int" Value="_effective.RetryBadcaseMaxTimes" Label="Max Retries"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="1" Max="10"
                             HelperText="Maximum retry attempts."
                             Style="@FieldStyle("retry_badcase_max_times")"
                             ValueChanged="@((int v) => OnFieldChanged(s => s with { RetryBadcaseMaxTimes = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("retry_badcase_max_times"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { RetryBadcaseMaxTimes = b.RetryBadcaseMaxTimes }))" />
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="double" Value="_effective.RetryBadcaseRatioThreshold" Label="Ratio Threshold"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="1.0" Step="0.1"
                             HelperText="Bad-case detection ratio threshold."
                             Style="@FieldStyle("retry_badcase_ratio_threshold")"
                             ValueChanged="@((double v) => OnFieldChanged(s => s with { RetryBadcaseRatioThreshold = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && IsOverridden("retry_badcase_ratio_threshold"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => ResetField(b => _effective with { RetryBadcaseRatioThreshold = b.RetryBadcaseRatioThreshold }))" />
            }
        </MudStack>

        <MudButton StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetToDefault">
            Return to default
        </MudButton>
    </MudStack>
}

@if (ProviderType == ParagraphTtsServiceType.Chatterbox)
{
    <MudStack Spacing="2">
        <MudStack Spacing="0" Style="@CbFieldStyle("exaggeration")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">Exaggeration</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@_cbEffective.Exaggeration.ToString("F2")</MudText>
                    @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbIsOverridden("exaggeration"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                                       OnClick="@(() => CbResetField(b => _cbEffective with { Exaggeration = b.Exaggeration }))" />
                    }
                </MudStack>
            </MudStack>
            <MudSlider T="double" Value="_cbEffective.Exaggeration" Min="0.0" Max="2.0" Step="0.05"
                       ValueChanged="@((double v) => CbOnFieldChanged(s => s with { Exaggeration = v }))" />
            <MudText Typo="Typo.caption" Color="Color.Default">Emotional intensity. (0.0–2.0)</MudText>
        </MudStack>

        <MudStack Spacing="0" Style="@CbFieldStyle("cfg_weight")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">CFG Weight</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@_cbEffective.CfgWeight.ToString("F2")</MudText>
                    @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbIsOverridden("cfg_weight"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                                       OnClick="@(() => CbResetField(b => _cbEffective with { CfgWeight = b.CfgWeight }))" />
                    }
                </MudStack>
            </MudStack>
            <MudSlider T="double" Value="_cbEffective.CfgWeight" Min="0.0" Max="1.0" Step="0.05"
                       ValueChanged="@((double v) => CbOnFieldChanged(s => s with { CfgWeight = v }))" />
            <MudText Typo="Typo.caption" Color="Color.Default">Pace/guidance weight. (0.0–1.0)</MudText>
        </MudStack>

        <MudStack Spacing="0" Style="@CbFieldStyle("temperature")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">Temperature</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@_cbEffective.Temperature.ToString("F2")</MudText>
                    @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbIsOverridden("temperature"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                                       OnClick="@(() => CbResetField(b => _cbEffective with { Temperature = b.Temperature }))" />
                    }
                </MudStack>
            </MudStack>
            <MudSlider T="double" Value="_cbEffective.Temperature" Min="0.0" Max="2.0" Step="0.05"
                       ValueChanged="@((double v) => CbOnFieldChanged(s => s with { Temperature = v }))" />
            <MudText Typo="Typo.caption" Color="Color.Default">Sampling randomness. (0.0–2.0)</MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="double" Value="_cbEffective.MinP" Label="Min P"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="0.0" Max="1.0" Step="0.01"
                             HelperText="Nucleus sampling floor."
                             Style="@CbFieldStyle("min_p")"
                             ValueChanged="@((double v) => CbOnFieldChanged(s => s with { MinP = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbIsOverridden("min_p"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => CbResetField(b => _cbEffective with { MinP = b.MinP }))" />
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="double" Value="_cbEffective.TopP" Label="Top P"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="0.0" Max="1.0" Step="0.01"
                             HelperText="Nucleus sampling ceiling."
                             Style="@CbFieldStyle("top_p")"
                             ValueChanged="@((double v) => CbOnFieldChanged(s => s with { TopP = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbIsOverridden("top_p"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => CbResetField(b => _cbEffective with { TopP = b.TopP }))" />
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="double" Value="_cbEffective.RepetitionPenalty" Label="Repetition Penalty"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="1.0" Max="2.0" Step="0.05"
                             HelperText="Penalizes repeated tokens."
                             Style="@CbFieldStyle("repetition_penalty")"
                             ValueChanged="@((double v) => CbOnFieldChanged(s => s with { RepetitionPenalty = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbIsOverridden("repetition_penalty"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => CbResetField(b => _cbEffective with { RepetitionPenalty = b.RepetitionPenalty }))" />
            }
        </MudStack>

        <MudButton StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="CbResetToDefault">
            Return to default
        </MudButton>
    </MudStack>
}

@if (ProviderType == ParagraphTtsServiceType.ChatterboxTurbo)
{
    <MudStack Spacing="2">
        <MudStack Spacing="0" Style="@CbtFieldStyle("temperature")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">Temperature</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@_cbtEffective.Temperature.ToString("F2")</MudText>
                    @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbtIsOverridden("temperature"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                                       OnClick="@(() => CbtResetField(b => _cbtEffective with { Temperature = b.Temperature }))" />
                    }
                </MudStack>
            </MudStack>
            <MudSlider T="double" Value="_cbtEffective.Temperature" Min="0.0" Max="2.0" Step="0.05"
                       ValueChanged="@((double v) => CbtOnFieldChanged(s => s with { Temperature = v }))" />
            <MudText Typo="Typo.caption" Color="Color.Default">Sampling randomness. (0.0–2.0)</MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudNumericField T="double" Value="_cbtEffective.RepetitionPenalty" Label="Repetition Penalty"
                             Variant="Variant.Outlined" Immediate="true"
                             Min="1.0" Max="2.0" Step="0.05"
                             HelperText="Penalizes repeated tokens."
                             Style="@CbtFieldStyle("repetition_penalty")"
                             ValueChanged="@((double v) => CbtOnFieldChanged(s => s with { RepetitionPenalty = v }))" />
            @if (Mode == TtsSettingsEditorMode.VoiceOverride && CbtIsOverridden("repetition_penalty"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" title="Reset to provider default"
                               OnClick="@(() => CbtResetField(b => _cbtEffective with { RepetitionPenalty = b.RepetitionPenalty }))" />
