        <MudText Typo="Typo.caption" Color="Color.Default">
            Expression comes from inline paralinguistic tags in the paragraph text, not knobs: [laugh] [chuckle] [sigh] [cough] [clear throat] [gasp] [groan] [sniff] [shush]
        </MudText>

        <MudButton StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="CbtResetToDefault">
