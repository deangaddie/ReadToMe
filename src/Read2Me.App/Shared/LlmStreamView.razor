@using System.Text
@using Read2Me.Services.Events
@inject EventJournal<LlmStreamEvent> Journal
@inject ThroughputAggregator Throughput
@inject IJSRuntime JS
@implements IDisposable

@{
    // Pull once per paint so the headline, live subscript and final table all describe the same
    // instant of the process-wide Throughput Run. The journal already supplies this component's
    // paint cadence; throughput adds no subscription and no timer.
    var throughput = Throughput.Snapshot;
}

<div @ref="_scrollContainer"
     style="height:100%; overflow-y:auto; overscroll-behavior:contain; display:flex; flex-direction:column; gap:12px; padding:4px;">
    @if (ShowThroughput)
    {
        <div style="position:sticky; top:0; z-index:1; flex:none; padding:8px 12px;
                    background:var(--mud-palette-surface); border-bottom:1px solid var(--mud-palette-divider);">
            <MudText Typo="Typo.h5" Style="@ThroughputText.StyleFor(throughput.RunThroughput)">
                @ThroughputText.Rate(throughput.RunThroughput)
            </MudText>
            <MudText Typo="Typo.caption" Style="opacity:0.6;">
                <GenerationRateSubscript Snapshot="throughput" />
            </MudText>
            <ThroughputByConfigTable Snapshot="throughput" />
        </div>
    }
    @if (_turns.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="padding:16px; text-align:center;">
            Waiting for next LLM request...
        </MudText>
    }
    @foreach (var turn in _turns)
    {
        <MudCard Outlined="true">
            @if (!string.IsNullOrEmpty(turn.Preview))
            {
                <MudCardHeader Style="padding:8px 16px; background:var(--mud-palette-background-grey);">
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="opacity:0.6;" />
                            <MudText Typo="Typo.caption" Style="opacity:0.8; font-weight:600;">Request</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.5;">— @turn.Preview</MudText>
                        </MudStack>
                    </CardHeaderContent>
                </MudCardHeader>
            }
            @if (turn.Prompt.Length > 0)
            {
                <div style="padding:8px 16px; border-bottom:1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption"
                             Style="white-space:pre-wrap; font-family:monospace; opacity:0.75; font-size:0.7rem; overflow-y:auto; display:block;">
                        @turn.Prompt</MudText>
                    </div>
                }
                @if (turn.Thinking.Length > 0)
                {
                    <div
                        style="padding:8px 16px; border-bottom:1px solid var(--mud-palette-divider); background:var(--mud-palette-background-grey); opacity:0.8;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="margin-bottom:4px;">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Style="opacity:0.6;" />
                            <MudText Typo="Typo.caption" Style="opacity:0.6; font-style:italic;">Thinking</MudText>
                        </MudStack>
                        <div style="overflow-y:auto;">
                            <MudText Typo="Typo.caption"
                                     Style="white-space:pre-wrap; font-family:monospace; font-style:italic; opacity:0.65; font-size:0.7rem;">
                                @turn.Thinking.ToString()</MudText>
                            </div>
                        </div>
                    }
                    @if (turn.Response.Length > 0 || turn.IsStreaming)
                    {
                        <div
                            style="padding:8px 16px; @(turn.FailureReason != null ? "border-bottom:1px solid var(--mud-palette-divider);" : "")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="margin-bottom:4px;">
                                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Style="opacity:0.6;" />
                                <MudText Typo="Typo.caption" Style="opacity:0.6;">Response</MudText>
                                @if (turn.IsStreaming)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                         Style="width:10px;height:10px;opacity:0.6;" />
                                }
                            </MudStack>
                            <div style="overflow-y:auto;">
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap; font-family:monospace; font-size:0.78rem;">
                                    @turn.Response.ToString()</MudText>
                                </div>
                            </div>
                        }
                        @if (turn.FailureReason != null)
                        {
                            <div style="padding:8px 16px;">
                                <MudText Typo="Typo.caption" Color="Color.Error">@turn.FailureReason</MudText>
                            </div>
                        }
                        @if (turn.Stats != null)
                        {
                            <div style="padding:4px 16px 8px; opacity:0.5;">
                                <MudText Typo="Typo.caption">
                                    @Count(turn.Stats.TokensIn) in · @Count(turn.Stats.TokensOut) out
                                    · @Seconds(turn.Stats.GenerationMs) gen · @Rate(turn.Stats.TokensPerSecond) tok/s
                                </MudText>
                            </div>
                        }
                    </MudCard>
                }
            </div>

@code {
    [Parameter]
    public bool ShowThroughput { get; set; } = true;

    private readonly List<StreamTurn> _turns = new();
    private ElementReference _scrollContainer;
    private bool _needsScroll;

    // Journal subscription replays the in-progress turn first, so expanding the
    // view mid-request shows the current item instead of waiting for the next one.
    protected override void OnInitialized() => Journal.Subscribe(OnEvent);

    private void OnEvent(LlmStreamEvent e)
    {
        InvokeAsync(() =>
        {
            Apply(e);
            _needsScroll = true;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _needsScroll)
        {
            _needsScroll = false;
            await JS.InvokeVoidAsync("read2meAutoScroll", _scrollContainer);
        }
    }

    private void Apply(LlmStreamEvent e)
    {
        switch (e)
        {
            case RequestStarted rs:
                _turns.Add(new StreamTurn { Preview = rs.ParagraphPreview, Prompt = rs.Prompt });
                break;

            case ThinkingDelta td:
                CurrentTurn?.Thinking.Append(td.Text);
                break;

            case ContentDelta cd:
                CurrentTurn?.Response.Append(cd.Text);
                break;

            case StreamCompleted sc:
                if (CurrentTurn is { } t)
                {
                    t.IsStreaming = false;
                    t.Stats = sc;
                }
                break;

            case StreamFailed sf:
                if (CurrentTurn is { } ft)
                {
                    ft.IsStreaming = false;
                    ft.FailureReason = sf.Reason;
                }
                break;

            case EscalationStarted es:
                _turns.Add(new StreamTurn
                {
                    Preview = $"Escalation step {es.Step} → {es.ConfigName} ({es.ItemCount} item{(es.ItemCount == 1 ? "" : "s")})",
                    IsStreaming = false,
                });
                break;
        }
    }

    private StreamTurn? CurrentTurn => _turns.LastOrDefault();

    // Absence renders as absence. A backend that sends no timings, or a fully cache-hit prompt
    // llama.cpp could not measure, leaves the slot showing "—" rather than a "0" that would read
    // as "it generated nothing" (ADR 0003). Nothing here is estimated.
    private const string Absent = "—";

    private static string Count(int? value) => value?.ToString() ?? Absent;

    /// <summary>Server-measured generation time, shown in seconds. Excludes load and queue wait.</summary>
    private static string Seconds(double? milliseconds) =>
        milliseconds is { } ms ? $"{(ms / 1000.0).ToString("F1")}s" : Absent;

    private static string Rate(double? tokensPerSecond) =>
        tokensPerSecond?.ToString("F1") ?? Absent;

    public void Dispose() => Journal.Unsubscribe(OnEvent);

    private sealed class StreamTurn
    {
        public string Preview { get; init; } = string.Empty;
        public string Prompt { get; init; } = string.Empty;
        public StringBuilder Thinking { get; } = new();
        public StringBuilder Response { get; } = new();
        public bool IsStreaming { get; set; } = true;
        public StreamCompleted? Stats { get; set; }
        public string? FailureReason { get; set; }
    }
}
