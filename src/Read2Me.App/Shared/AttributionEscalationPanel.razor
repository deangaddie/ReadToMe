@using Read2Me.App.Shared
@using Read2Me.AppData.Entities
@inject LlmSettingsService SettingsService
@implements IDisposable

<MudPaper Class="pa-4 mt-6" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-1">Attribution chain</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Character attribution runs each chain config in order. The first config answers the easy lines;
        suspect answers (unknown, unlisted name, parse failure) escalate to the next. Every step is
        reorderable and removable. Same-server multi-model chains are supported — the llama.cpp fork
        loads the requested preset per request. Each config is offered four times in the add list, one
        per combination of two per-rung flags. "(thinking)" runs that rung with model thinking enabled:
        slower but higher recall. "(simple)" asks with the strict prompt, which assigns a speaker only
        when the text explicitly names one and otherwise answers "unknown" — far less confabulation on
        scenes where the speaker is never named, at the cost of escalating more often. The same config
        can hold every combination; to change a rung's mode, remove it and add the other variant.
    </MudText>

    @if (_presenter is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
    }
    else
    {
        @if (_presenter.Chain.Count == 0)
        {
            @if (_presenter.FallbackConfig is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    The chain is empty — attribution falls back to the default config
                    <b>@_presenter.FallbackConfig.Name</b>. Add configs below to run a multi-step chain.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    The chain is empty and no default config is selected — attribution has no model to run.
                </MudAlert>
            }
        }

        @for (int r = 0; r < _presenter.Chain.Count; r++)
        {
            var index = r; // captured per row: every handler below addresses its row by index
            var step = _presenter.Chain[index];
            var cfg = step.Config;
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                   Disabled="@(!_presenter.CanMoveUp(index))"
                                   OnClick="@(() => MoveUpAsync(index))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                   Disabled="@(!_presenter.CanMoveDown(index))"
                                   OnClick="@(() => MoveDownAsync(index))" />
                    <MudText Typo="Typo.body1">@cfg.Name</MudText>
                    @if (!string.IsNullOrWhiteSpace(cfg.Model))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cfg.Model</MudText>
                    }
                    <MudSpacer />
                    @* Both flags are fixed at add time — the row shows which variant was picked. *@
                    <MudCheckBox T="bool" Value="@(step.Style == AttributionPromptStyle.Simple)" Dense="true"
                                 Size="Size.Small" ReadOnly="true" Label="Simple prompt" />
                    <MudCheckBox T="bool" Value="step.Thinking" Dense="true" Size="Size.Small"
                                 ReadOnly="true" Label="Thinking" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveAsync(index))" />
                </MudStack>
            </MudPaper>
        }

        @if (_presenter.AvailableToAdd.Count > 0)
        {
            @* Keyed on a nonce so the select is a fresh component after each add — otherwise it keeps
               the previously picked value and re-picking the same option raises no ValueChanged. *@
            <MudSelect T="string" Label="Add chain step" Value="@(null as string)" @key="_addNonce"
                       ValueChanged="OnAddSelectedAsync" Dense="true" Class="mt-2" Variant="Variant.Outlined">
                @foreach (var option in _presenter.AvailableToAdd)
                {
                    <MudSelectItem T="string" Value="@option.Key">@option.Label</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSwitch T="bool" Value="_presenter.SelfConsistency" ValueChanged="OnSelfConsistencyChangedAsync"
                   Color="Color.Primary" Class="mt-4"
                   Label="Self-consistency: sample twice on non-final steps and escalate on disagreement — doubles LLM calls for those steps" />
    }
</MudPaper>

@code {
    AttributionEscalationPresenter? _presenter;
    int _addNonce;

    protected override async Task OnInitializedAsync()
    {
        SettingsService.OnChanged += HandleChanged;
        _presenter = new AttributionEscalationPresenter(SettingsService);
        await _presenter.LoadAsync();
    }

    void HandleChanged() => InvokeAsync(ReloadAsync);

    async Task ReloadAsync()
    {
        if (_presenter is null) return;
        await _presenter.LoadAsync();
        StateHasChanged();
    }

    async Task MoveUpAsync(int index)
    {
        await _presenter!.MoveUpAsync(index);
        StateHasChanged();
    }

    async Task MoveDownAsync(int index)
    {
        await _presenter!.MoveDownAsync(index);
        StateHasChanged();
    }

    async Task RemoveAsync(int index)
    {
        await _presenter!.RemoveAsync(index);
        StateHasChanged();
    }

    async Task OnAddSelectedAsync(string? key)
    {
        if (TryParseKey(key, out int configId, out bool thinking, out var style))
        {
            await _presenter!.AddAsync(configId, thinking, style);
            _addNonce++; // rebuild the select so it drops back to the placeholder
            StateHasChanged();
        }
    }

    /// <summary>
    /// Split a "<c>&lt;configId&gt;:&lt;t|f&gt;:&lt;style&gt;</c>" option key back into its parts.
    /// Every key the add list emits names a style explicitly, so a rung added here never inherits.
    /// </summary>
    static bool TryParseKey(string? key, out int configId, out bool thinking, out AttributionPromptStyle style)
    {
        configId = 0;
        thinking = false;
        style = AttributionPromptStyle.Full;
        var parts = key?.Split(':');
        if (parts is not { Length: 3 } || !int.TryParse(parts[0], out configId)) return false;
        if (!Enum.TryParse(parts[2], out style)) return false;
        thinking = parts[1] == "t";
        return true;
    }

    async Task OnSelfConsistencyChangedAsync(bool value)
    {
        await _presenter!.SetSelfConsistencyAsync(value);
        StateHasChanged();
    }

    public void Dispose()
    {
        SettingsService.OnChanged -= HandleChanged;
    }
}
