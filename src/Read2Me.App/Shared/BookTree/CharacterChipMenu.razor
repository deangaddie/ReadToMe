@using Read2Me.App.State
@inject BookHierarchyPresenter Presenter

<MudMenu @bind-Open="_open" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true"
         PositionAtCursor="false">
    <ActivatorContent>
        <MudChip T="string" Size="Size.Small"
                 Color="@Color"
                 Variant="@Variant"
                 Icon="@Icon"
                 Class="mt-0"
                 Style="@($"{Style} cursor:pointer;")"
                 OnClick="@(() => _open = true)">
            @Label
        </MudChip>
    </ActivatorContent>
    <ChildContent>
        @* Narration is a speaker, not an item type (ADR-0006): the narrator is one entry in this
           list like any character, pinned at the top because the roster sorts IsNarrator first.
           Under a narrator link the entry names the linked character, so "Narrator (Alice)" reads
           apart from "Alice" — they are different stored speakers with different voice rules. *@
        @foreach (var ch in Presenter.Characters)
        {
            var c = ch;
            <MudMenuItem OnClick="@(() => Select(c.Id))" data-testid="@($"pick-{(c.IsNarrator ? "narrator" : c.Id.ToString())}")">
                @(c.IsNarrator ? NarratorLabel : c.Name)
            </MudMenuItem>
        }
        <MudDivider />
        <MudMenuItem OnClick="@(() => Select(null))" data-testid="pick-requeue">
            Clear speaker — re-queue as unattributed dialog
        </MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="AddCharacter">Add new character...</MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Style { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback<Guid?> OnSelected { get; set; }

    private bool _open;

    private string NarratorLabel =>
        Presenter.Narrator.IsLinked ? $"Narrator ({Presenter.Narrator.DisplayName})" : "Narrator";

    private async Task Select(Guid? characterId)
    {
        _open = false;
        await OnSelected.InvokeAsync(characterId);
    }

    private async Task AddCharacter()
    {
        _open = false;
        var newId = await Presenter.AddCharacterAsync(FolderId);
        if (newId is Guid id)
            await OnSelected.InvokeAsync(id);
    }
}
