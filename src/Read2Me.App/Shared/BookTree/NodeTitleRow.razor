@using Read2Me.App.State
@using Read2Me.App.Shared.BookMenus
@using Read2Me.Services.NodeStatus
@inject BookHierarchyPresenter Presenter
@inject NodeStatusService NodeStatus
@implements IDisposable

@{
    var isAudioMode = Presenter.ViewMode == BookViewMode.SplitAudio;
    var row = NodeRowViewModel.For(
        isAudioMode ? Presenter.IsNodeAudioSelectable(NodeId) : Presenter.IsNodeSelectable(NodeId),
        isAudioMode
            ? Presenter.AudioSelection.NodeState(Level, NodeId)
            : Presenter.Selection.NodeState(Level, NodeId),
        NodeStatus.StatusForNode(FolderId, NodeId));
}
<MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
    @if (row.ShowSelectionControls)
    {
        <span @onclick:stopPropagation="true" style="display:inline-flex;align-items:center;">
            @if (isAudioMode)
            {
                <MudCheckBox T="bool?" Value="@row.CheckboxValue"
                             ValueChanged="@((bool? v) => Presenter.SetAudioNodeAsync(Level, NodeId, v == true))"
                             Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.PlaylistAddCheck"
                               Size="Size.Small" title="Select needs audio"
                               OnClick="@(() => Presenter.SetAudioNodeAsync(Level, NodeId, true, needsAudioOnly: true))" />
            }
            else
            {
                <MudCheckBox T="bool?" Value="@row.CheckboxValue"
                             ValueChanged="@((bool? v) => Presenter.SetNodeAsync(Level, NodeId, v == true))"
                             Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.PlaylistAddCheck"
                               Size="Size.Small" title="Select unprocessed"
                               OnClick="@(() => Presenter.SetNodeAsync(Level, NodeId, true, unprocessedOnly: true))" />
            }
        </span>
    }
    <MudText Style="flex:1">@Title</MudText>
    @if (row.ShowAttributionBadge)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                 Icon="@Icons.Material.Filled.PersonOff" Class="mt-0"
                 Style="pointer-events:none;">@row.AttributionRemaining</MudChip>
    }
    @if (row.ShowAudioBadge)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                 Icon="@Icons.Material.Filled.GraphicEq" Class="mt-0"
                 Style="pointer-events:none;">@row.AudioRemaining</MudChip>
    }
    @if (row.ShowReviewBadge)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                 Icon="@Icons.Material.Filled.RateReview" Class="mt-0"
                 Style="pointer-events:none;">@row.Review</MudChip>
    }
    @if (row.ShowDoneIndicator)
    {
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                 Color="Color.Success" Style="opacity:0.5;pointer-events:none;" />
    }
    @if (row.ShowAttributionProcessingChip)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                 Icon="@Icons.Material.Filled.HourglassEmpty" Class="mt-0"
                 Style="pointer-events:none;">Processing</MudChip>
    }
    @if (row.ShowAttributionQueuedChip)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                 Class="mt-0" Style="pointer-events:none;">@row.AttributionQueuedCount queued</MudChip>
    }
    <BookNodeMenu Spec="@Spec"
                 IsFirst="IsFirst"
                 IsLast="IsLast"
                 PreviousSiblingId="PreviousSiblingId"
                 NextSiblingId="NextSiblingId"
                 OnChanged="OnChanged"
                 OnMerged="OnMerged"
                 OnSplit="OnSplit"
                 OnReset="OnReset" />
</MudStack>

@code {
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }
    [Parameter, EditorRequired] public Guid NodeId { get; set; }
    [Parameter, EditorRequired] public BookNodeLevel Level { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public BookNodeMenuSpec Spec { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsFirst { get; set; }
    [Parameter, EditorRequired] public bool IsLast { get; set; }
    [Parameter] public Guid? PreviousSiblingId { get; set; }
    [Parameter] public Guid? NextSiblingId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<(Guid survivorId, Guid deletedId)> OnMerged { get; set; }
    [Parameter] public EventCallback<BookSplit> OnSplit { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    protected override void OnInitialized()
    {
        NodeStatus.Changed += Refresh;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NodeStatus.Changed -= Refresh;
    }
}
