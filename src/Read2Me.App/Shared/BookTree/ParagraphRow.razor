@using Read2Me.App.State
@using Read2Me.App.Shared.BookMenus
@using Read2Me.Core.Models
@using Read2Me.Data.Entities
@using Read2Me.Data.Enums
@using Read2Me.Services.Characters
@inject BookHierarchyPresenter Presenter
@inject CharacterQueueService Queue
@implements IDisposable

@{
    var queueStatus = Queue.StatusOf(FolderId, Para.Id);
    var queueOutcome = queueStatus is null ? Queue.OutcomeOf(FolderId, Para.Id) : null;
    var vm = ParagraphRowViewModel.For(Para, Presenter.SplitView, queueStatus, queueOutcome is not null);
    var isBusy = vm.IsBusy;
    var isCharPara = vm.IsCharacterParagraph;
    var hasUnknown = vm.HasUnknownInSplit;
}

@if (Presenter.SplitView)
{
    var firstItem = Para.Items.FirstOrDefault();
    var isPauseParagraph = ParagraphItemDisplay.IsPauseParagraph(Para);
    @if (isPauseParagraph)
    {
        var pauseLabel = ParagraphItemDisplay.GetPauseLabel(firstItem?.ItemType);
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                  Style="opacity:0.45;">
            <MudText Typo="Typo.caption" Style="flex:1; font-style:italic;">@pauseLabel</MudText>
            @if (!isBusy)
            {
                <BookNodeMenu Spec="@BookNodeMenuSpecs.ForPauseParagraph(FolderId, Para)"
                             IsFirst="false" IsLast="false"
                             OnChanged="@(() => { Presenter.Tree.RemoveParagraph(Para.Id); OnChanged.InvokeAsync(); })"
                             OnReset="@(() => Presenter.ResetAndLoadAsync(FolderId))" />
            }
        </MudStack>
    }
    else
    {
        var items = Para.Items.ToList();
        var isSplitSelected = isCharPara && Presenter.Selection.IsParagraphSelected(Para.Id);
        var splitBg = hasUnknown ? "rgba(var(--mud-palette-warning-rgb), 0.06)" : isSplitSelected ? "rgba(var(--mud-palette-primary-rgb), 0.10)" : "";
        <MudStack Spacing="1" Class="pl-2 pr-1 py-1 rounded"
                  Style="@($"border-left: 2px solid {(hasUnknown ? "var(--mud-palette-warning)" : isSplitSelected ? "var(--mud-palette-primary)" : "var(--mud-palette-divider)") };{(splitBg != "" ? $" background: {splitBg};" : "")}")">
            @if (isCharPara)
            {
                @if (isBusy)
                {
                    <QueueStatusChip Status="queueStatus!.Value" />
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudCheckBox T="bool" Value="@isSplitSelected"
                                     ValueChanged="@((bool v) => Presenter.ToggleParagraphAsync(FolderId, Para.Id, ChapterId, PartId, VolumeId, v))"
                                     Size="Size.Small" />
                        @if (queueOutcome is not null)
                        {
                            <QueueOutcomeChip Outcome="queueOutcome" />
                        }
                    </MudStack>
                }
            }
            @foreach (var item in items)
            {
                var it = item;
                @if (it.ItemType == ParagraphItemType.Character || it.ItemType == ParagraphItemType.Narration)
                {
                    var isCharItem = it.ItemType == ParagraphItemType.Character;
                    var (chipIcon, chipColor, chipLabel) = isCharItem
                        ? ("", it.Character == null ? Color.Warning : Color.Primary, it.Character?.Name ?? "Unknown")
                        : ParagraphItemDisplay.GetItemDisplay(it.ItemType) switch { var d => (d.icon, d.color, d.label) };
                    <div style="display:grid; grid-template-columns:120px 1fr auto; align-items:start; gap:8px;">
                        <CharacterChipMenu Label="@chipLabel"
                                           FolderId="@FolderId"
                                           Color="@chipColor"
                                           Variant="@(isCharItem ? Variant.Filled : Variant.Outlined)"
                                           Icon="@(isCharItem ? null : chipIcon)"
                                           Style="width:100%; justify-content:center;"
                                           OnSelected="@(id => Presenter.SetItemCharacterAsync(FolderId, it, id))" />
                        @if (!string.IsNullOrWhiteSpace(it.Text))
                        {
                            <MudText Typo="Typo.body2" Style="@(isCharItem ? "" : "font-style:italic;")">@it.Text</MudText>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (!isBusy)
                        {
                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraphItem(FolderId, it)"
                                               IsFirst="@(items[0].Id == it.Id)"
                                               IsLast="@(items[^1].Id == it.Id)"
                                               OnChanged="OnChanged"
                                               OnReset="@(() => Presenter.ResetAndLoadAsync(FolderId))" />
                        }
                        else
                        {
                            <span></span>
                        }
                    </div>
                }
                else
                {
                    var (pauseIcon, pauseColor, pauseLabel2) = ParagraphItemDisplay.GetItemDisplay(it.ItemType);
                    <div style="@($"display:grid; grid-template-columns:120px 1fr auto; align-items:center; gap:8px; opacity:0.6; font-style:italic;")">
                        <MudChip T="string" Size="Size.Small" Color="@pauseColor" Variant="Variant.Outlined"
                                 Icon="@pauseIcon" Class="mt-0"
                                 Style="width:100%; justify-content:center;">
                            @pauseLabel2
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(it.Text))
                        {
                            <MudText Typo="Typo.body2">@it.Text</MudText>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (!isBusy)
                        {
                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraphItem(FolderId, it)"
                                               IsFirst="@(items[0].Id == it.Id)"
                                               IsLast="@(items[^1].Id == it.Id)"
                                               OnChanged="OnChanged"
                                               OnReset="@(() => Presenter.ResetAndLoadAsync(FolderId))" />
                        }
                        else
                        {
                            <span></span>
                        }
                    </div>
                }
            }
        </MudStack>
    }
}
else
{
    var isPause = ParagraphItemDisplay.IsPauseParagraph(Para);
    var isSelected = Presenter.Selection.IsParagraphSelected(Para.Id);
    @if (!isPause)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                  Style="@($"border-radius: 4px; padding: 0 4px;{(isSelected ? " color: var(--mud-palette-primary-text); background: rgba(var(--mud-palette-primary-rgb), 0.12);" : "")}")">
            @if (isBusy)
            {
                <QueueStatusChip Status="queueStatus!.Value" />
            }
            else if (isCharPara)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                    <MudCheckBox T="bool" Value="@isSelected"
                                 ValueChanged="@((bool v) => Presenter.ToggleParagraphAsync(FolderId, Para.Id, ChapterId, PartId, VolumeId, v))"
                                 Size="Size.Small" />
                    @if (queueOutcome is not null)
                    {
                        <QueueOutcomeChip Outcome="queueOutcome" />
                    }
                </MudStack>
            }
            else
            {
                <span style="display:inline-block; width:38px; flex-shrink:0;"></span>
            }
            @if (isCharPara && !isBusy)
            {
                var (chipColor, chipLabel) = vm.Chip switch
                {
                    ParaCharacterChip.Mixed   => (Color.Default, "Mixed"),
                    ParaCharacterChip.Unknown => (Color.Warning, "Unknown"),
                    ParaCharacterChip.Single  => (Color.Primary, vm.SingleCharacterName!),
                    _                         => (Color.Default, "")
                };
                <CharacterChipMenu Label="@chipLabel"
                                   FolderId="@FolderId"
                                   Color="@chipColor"
                                   Variant="Variant.Filled"
                                   Style="flex-shrink:0;"
                                   OnSelected="@(id => Presenter.SetParagraphCharacterAsync(FolderId, Para, id))" />
            }
            <MudText Typo="Typo.body2" Style="flex:1">@string.Join(" ", Para.Items.Select(i => i.Text))</MudText>
            @if (!isBusy)
            {
                <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraph(FolderId, Para)"
                               IsFirst="IsFirst"
                               IsLast="IsLast"
                               OnChanged="@(() => { Presenter.Tree.RemoveParagraph(Para.Id); OnChanged.InvokeAsync(); })"
                               OnSplit="OnSplit"
                               OnReset="@(() => Presenter.ResetAndLoadAsync(FolderId))" />
            }
        </MudStack>
    }
}

@code {
    [Parameter, EditorRequired] public Paragraph Para { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter, EditorRequired] public Guid PartId { get; set; }
    [Parameter, EditorRequired] public Guid VolumeId { get; set; }
    [Parameter, EditorRequired] public bool IsFirst { get; set; }
    [Parameter, EditorRequired] public bool IsLast { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<BookSplit> OnSplit { get; set; }

    protected override void OnInitialized()
    {
        Queue.Changed += Refresh;
        ApplyResolvedCharacter();
    }

    // Worker writes the resolved character to the DB on a background scope; this
    // circuit's in-memory tree is untouched. Stamp the resolved character onto the
    // loaded items so the chip updates without a reload. Idempotent.
    void ApplyResolvedCharacter()
    {
        var resolved = Queue.ResolvedOf(FolderId, Para.Id);
        if (resolved is null) return;

        foreach (var it in Para.Items)
        {
            if (it.ItemType != ParagraphItemType.Character) continue;
            if (it.CharacterId == resolved.CharacterId) continue;
            it.CharacterId = resolved.CharacterId;
            it.Character = new Character { Id = resolved.CharacterId, Name = resolved.Name };
        }
    }

    void Refresh() => InvokeAsync(() =>
    {
        ApplyResolvedCharacter();
        StateHasChanged();
    });

    public void Dispose()
    {
        Queue.Changed -= Refresh;
    }
}
