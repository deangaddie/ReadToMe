@using Read2Me.App.State
@using Read2Me.App.Shared.BookMenus
@using Read2Me.Services.Audio
@using Read2Me.Services.Characters
@inject BookHierarchyPresenter Presenter
@inject CharacterQueueService Queue
@inject AudioQueueService AudioQueue
@inject AudioReviewService AudioReviews
@implements IDisposable

@{
    var viewMode = Presenter.ViewMode;
    var isSplit = viewMode != BookViewMode.Combined;
    var queueStatus = Queue.StatusOf(FolderId, Para.Id);
    var queueOutcome = queueStatus is null ? Queue.OutcomeOf(FolderId, Para.Id) : null;
    var vm = ParagraphRowViewModel.For(Para, isSplit, queueStatus, queueOutcome is not null);
    var isBusy = vm.IsBusy;
    var isCharPara = vm.IsCharacterParagraph;
    var hasUnknown = vm.HasUnknownInSplit;
}

@if (isSplit)
{
    var firstItem = Para.Items.FirstOrDefault();
    var isPauseParagraph = ParagraphItemDisplay.IsPauseParagraph(Para);
    @if (isPauseParagraph)
    {
        var pauseLabel = ParagraphItemDisplay.GetPauseLabel(firstItem?.ItemType);
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                  Style="opacity:0.45;">
            <MudText Typo="Typo.caption" Style="flex:1; font-style:italic;">@pauseLabel</MudText>
            @if (!isBusy)
            {
                <BookNodeMenu Spec="@BookNodeMenuSpecs.ForPauseParagraph(FolderId, Para)"
                             IsFirst="false" IsLast="false"
                             OnChanged="@(async () => { await Presenter.RefreshAsync(); await OnChanged.InvokeAsync(); })" />
            }
        </MudStack>
    }
    else
    {
        var items = Para.Items.ToList();
        var isAttribution = viewMode == BookViewMode.SplitAttribution;
        var isAudioMode = viewMode == BookViewMode.SplitAudio;
        var isSplitSelected = isAttribution && isCharPara && Presenter.Selection.IsParagraphSelected(Para.Id);
        var splitBg = hasUnknown ? "rgba(var(--mud-palette-warning-rgb), 0.06)" : isSplitSelected ? "rgba(var(--mud-palette-primary-rgb), 0.10)" : "";
        <MudStack Spacing="1" Class="pl-2 pr-1 py-1 rounded paragraph-hover-block"
                  Style="@($"border-left: 2px solid {(hasUnknown ? "var(--mud-palette-warning)" : isSplitSelected ? "var(--mud-palette-primary)" : "var(--mud-palette-divider)") };{(splitBg != "" ? $" background: {splitBg};" : "")}")">
            @if (isAttribution && isCharPara)
            {
                @if (isBusy)
                {
                    <QueueStatusChip Status="queueStatus!.Value" />
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudCheckBox T="bool" Value="@isSplitSelected"
                                     ValueChanged="@((bool v) => Presenter.ToggleParagraphAsync(Para.Id, new ParagraphSelection(VolumeId, PartId, ChapterId), v))"
                                     Size="Size.Small" />
                        @if (queueOutcome is not null)
                        {
                            <QueueOutcomeChip Outcome="queueOutcome" />
                        }
                    </MudStack>
                }
            }
            @foreach (var item in items)
            {
                var it = item;
                @if (!ParagraphItemKinds.IsPause(it.ItemType))
                {
                    // What an item is comes from its speaker, never its type (ADR-0006).
                    var isNarration = NarrationRule.IsNarration(it);
                    var (chipIcon, chipColor, chipLabel) = ParagraphItemDisplay.GetSpeechDisplay(it);
                    var audioRef = new AudioItemRef(it.Id, Para.Id, ChapterId, PartId, VolumeId);
                    var audioStatus = isAudioMode ? AudioQueue.StatusOf(FolderId, it.Id) : null;
                    var audioOutcome = isAudioMode && audioStatus is null ? AudioQueue.OutcomeOf(FolderId, it.Id) : null;
                    var isAudioBusy = audioStatus is not null;
                    var isAudioSelected = isAudioMode && !isAudioBusy && Presenter.AudioSelection.IsItemSelected(it.Id);
                    <div class="paragraph-item-hover-row" style="display:grid; grid-template-columns:@(isAudioMode ? "32px " : "")120px 1fr auto; align-items:start; gap:8px;">
                        @if (isAudioMode)
                        {
                            @if (isAudioBusy)
                            {
                                <span></span>
                            }
                            else
                            {
                                <MudCheckBox T="bool" Value="@isAudioSelected"
                                             Disabled="@(it.CharacterId == null && !Presenter.NarratorOnlyMode)"
                                             ValueChanged="@((bool v) => Presenter.ToggleAudioItemAsync(audioRef, v))"
                                             Size="Size.Small" Class="pa-0 ma-0" />
                            }
                        }
                        <CharacterChipMenu Label="@chipLabel"
                                           FolderId="@FolderId"
                                           Color="@chipColor"
                                           Variant="@(isNarration ? Variant.Outlined : Variant.Filled)"
                                           Icon="@(isNarration ? chipIcon : null)"
                                           Style="width:100%; justify-content:center;"
                                           OnSelected="@(id => Presenter.AssignCharacterAsync(FolderId, Para, it, id))" />
                        @if (!string.IsNullOrWhiteSpace(it.Text))
                        {
                            <div>
                                <MudText Typo="Typo.body2" Style="@(isNarration ? "font-style:italic;" : "")">@it.Text</MudText>
                                @if (isAudioMode)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1"
                                              Style="flex-wrap:wrap;">
                                        <SplitAudioVoicePreview CharacterId="@it.CharacterId"
                                                                Narrator="@Presenter.Narrator"
                                                                VoiceName="@Presenter.ResolvedVoiceName(it.Id)"
                                                                TestId="@($"voice-preview-{it.Id}")" />
                                        @if (!string.IsNullOrWhiteSpace(it.VoiceInstructions))
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Size="Size.Small"
                                                     Style="opacity:0.55; font-size:1rem;" />
                                            <MudText Typo="Typo.caption" Style="opacity:0.65; font-style:italic;"
                                                     data-testid="@($"voice-instructions-{it.Id}")">
                                                @it.VoiceInstructions
                                            </MudText>
                                        }
                                    </MudStack>
                                }
                            </div>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (!isBusy)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                @if (isAudioMode)
                                {
                                    var review = AudioReviews.ReviewOf(FolderId, it.Id);
                                    @if (review is not null)
                                    {
                                        <AudioReviewChip Review="review"
                                                         OnDismiss="@(() => Presenter.DismissAudioReviewAsync(FolderId, it.Id))" />
                                    }
                                }
                                @if (isAudioMode && isAudioBusy)
                                {
                                    <AudioQueueStatusChip Status="audioStatus!.Value" />
                                }
                                else if (isAudioMode && audioOutcome is not null)
                                {
                                    <AudioQueueOutcomeChip Outcome="audioOutcome" />
                                }
                                else if (isAudioMode && it.AudioFileName != null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayCircleOutline"
                                                   Size="Size.Small"
                                                   data-testid="@($"audio-play-{it.Id}")"
                                                   OnClick="@(() => Presenter.TogglePlayingAudioItemAsync(it.Id))"
                                                   Color="@(Presenter.PlayingAudioItemId == it.Id ? Color.Primary : Color.Default)" />
                                }
                                @if (!isAudioBusy)
                                {
                                    <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraphItem(FolderId, it, Presenter)"
                                                 IsFirst="@(items[0].Id == it.Id)"
                                                 IsLast="@(items[^1].Id == it.Id)"
                                                 OnChanged="OnChanged" />
                                }
                            </MudStack>
                        }
                        else
                        {
                            <span></span>
                        }
                    </div>
                    @if (isAudioMode && Presenter.PlayingAudioItemId == it.Id && it.AudioFileName != null)
                    {
                        var audioVersion = AudioQueue.AudioVersionOf(FolderId, it.Id);
                        var audioSrc = $"/workspace/{FolderId.Value}/{it.AudioFileName.Replace('\\', '/')}";
                        if (audioVersion.HasValue) audioSrc += $"?v={audioVersion.Value}";
                        <audio src="@audioSrc" controls style="width:100%; margin-top:4px;"></audio>
                    }
                }
                else
                {
                    var (pauseIcon, pauseColor, pauseLabel2) = ParagraphItemDisplay.GetPauseDisplay(it.ItemType);
                    <div class="paragraph-item-hover-row" style="@($"display:grid; grid-template-columns:{(isAudioMode ? "32px " : "")}120px 1fr auto; align-items:center; gap:8px; opacity:0.6; font-style:italic;")">
                        @if (isAudioMode)
                        {
                            <span></span>
                        }
                        <MudChip T="string" Size="Size.Small" Color="@pauseColor" Variant="Variant.Outlined"
                                 Icon="@pauseIcon" Class="mt-0"
                                 Style="width:100%; justify-content:center;">
                            @pauseLabel2
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(it.Text))
                        {
                            <MudText Typo="Typo.body2">@it.Text</MudText>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (!isBusy)
                        {
                            <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraphItem(FolderId, it, Presenter)"
                                               IsFirst="@(items[0].Id == it.Id)"
                                               IsLast="@(items[^1].Id == it.Id)"
                                               OnChanged="OnChanged" />
                        }
                        else
                        {
                            <span></span>
                        }
                    </div>
                }
            }
        </MudStack>
    }
}
else
{
    var isPause = ParagraphItemDisplay.IsPauseParagraph(Para);
    var isSelected = Presenter.Selection.IsParagraphSelected(Para.Id);
    @if (!isPause)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                  Class="paragraph-hover-row"
                  Style="@($"border-radius: 4px; padding: 0 4px;{(isSelected ? " color: var(--mud-palette-primary-text); background: rgba(var(--mud-palette-primary-rgb), 0.12);" : "")}")">
            @if (isBusy)
            {
                <QueueStatusChip Status="queueStatus!.Value" />
            }
            else if (isCharPara)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                    <MudCheckBox T="bool" Value="@isSelected"
                                 ValueChanged="@((bool v) => Presenter.ToggleParagraphAsync(Para.Id, new ParagraphSelection(VolumeId, PartId, ChapterId), v))"
                                 Size="Size.Small" />
                    @if (queueOutcome is not null)
                    {
                        <QueueOutcomeChip Outcome="queueOutcome" />
                    }
                </MudStack>
            }
            else
            {
                <span style="display:inline-block; width:38px; flex-shrink:0;"></span>
            }
            @if (vm.Chip != ParaCharacterChip.None && !isBusy)
            {
                var (chipColor, chipLabel) = vm.Chip switch
                {
                    ParaCharacterChip.Mixed     => (Color.Default, "Mixed"),
                    ParaCharacterChip.Unknown   => (Color.Warning, "Unknown"),
                    ParaCharacterChip.Partial   => (Color.Warning, $"{vm.SingleCharacterName ?? "Mixed"} +?"),
                    ParaCharacterChip.Single    => (Color.Primary, vm.SingleCharacterName!),
                    ParaCharacterChip.Narration => (Color.Info, "Narration"),
                    _                           => (Color.Default, "")
                };
                <CharacterChipMenu Label="@chipLabel"
                                   FolderId="@FolderId"
                                   Color="@chipColor"
                                   Variant="Variant.Filled"
                                   Style="flex-shrink:0;"
                                   OnSelected="@(id => Presenter.AssignCharacterAsync(FolderId, Para, null, id))" />
            }
            <MudText Typo="Typo.body2" Style="flex:1">@string.Join(" ", Para.Items.Select(i => i.Text))</MudText>
            @if (!isBusy)
            {
                <BookNodeMenu Spec="@BookNodeMenuSpecs.ForParagraph(FolderId, Para)"
                               IsFirst="IsFirst"
                               IsLast="IsLast"
                               OnChanged="@(async () => { await Presenter.RefreshAsync(); await OnChanged.InvokeAsync(); })" />
            }
        </MudStack>
    }
}

@code {
    [Parameter, EditorRequired] public Paragraph Para { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter, EditorRequired] public Guid PartId { get; set; }
    [Parameter, EditorRequired] public Guid VolumeId { get; set; }
    [Parameter, EditorRequired] public bool IsFirst { get; set; }
    [Parameter, EditorRequired] public bool IsLast { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    protected override void OnInitialized()
    {
        Queue.Changed += Refresh;
        AudioQueue.Changed += Refresh;
        AudioReviews.Changed += Refresh;
        Presenter.StateChanged += Refresh;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Queue.Changed -= Refresh;
        AudioQueue.Changed -= Refresh;
        AudioReviews.Changed -= Refresh;
        Presenter.StateChanged -= Refresh;
    }
}
