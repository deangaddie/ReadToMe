@using Read2Me.Services.Audio

@if (Status == AudioItemQueueStatus.Processing)
{
    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
             Icon="@Icons.Material.Filled.HourglassEmpty" Class="mt-0"
             Style="pointer-events:none;">
        Processing
    </MudChip>
}
else
{
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
             Class="mt-0" Style="pointer-events:none;">
        Queued
    </MudChip>
}

@code {
    [Parameter, EditorRequired] public AudioItemQueueStatus Status { get; set; }
}
