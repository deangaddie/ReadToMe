@using Read2Me.App.State
@using Read2Me.App.Shared.BookMenus
@inject BookHierarchyPresenter Presenter

@if (Parts.Count == 1)
{
    var p = Parts[0];
    @if (Presenter.IsExpanding(p.Id))
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
    }
    else if (Presenter.Chapters(p.Id) is { } singlePartChapters)
    {
        @RenderChapters(singlePartChapters, p.Id)
    }
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @for (int i = 0; i < Parts.Count; i++)
        {
            var p = Parts[i];
            var idx = i;
            <MudExpansionPanel Expanded="@Presenter.IsExpanded(BookNodeLevel.Part, p.Id)"
                              ExpandedChanged="@PartExpandCb(p)">
                <TitleContent>
                    <NodeTitleRow FolderId="@FolderId"
                                  NodeId="@p.Id"
                                  Level="BookNodeLevel.Part"
                                  Title="@(p.Title ?? "Part")"
                                  Spec="@BookNodeMenuSpecs.ForPart(FolderId, p)"
                                  IsFirst="@(idx == 0)"
                                  IsLast="@(idx == Parts.Count - 1)" />
                </TitleContent>
                <ChildContent>
                    @if (Presenter.IsExpanding(p.Id))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                    }
                    else if (Presenter.Chapters(p.Id) is { } multiPartChapters)
                    {
                        @RenderChapters(multiPartChapters, p.Id)
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Part> Parts { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }
    [Parameter, EditorRequired] public Guid VolumeId { get; set; }

    EventCallback<bool> PartExpandCb(Part p) =>
        EventCallback.Factory.Create<bool>(this, (bool b) => Presenter.SetNodeExpandedAsync(BookNodeLevel.Part, p.Id, b));

    RenderFragment RenderChapters(IReadOnlyList<Chapter> chapters, Guid partId) =>
        @<MudExpansionPanels MultiExpansion="true">
            @for (int i = 0; i < chapters.Count; i++)
            {
                var ch = chapters[i];
                var idx = i;
                <ChapterPanel Chapter="@ch"
                              FolderId="@FolderId"
                              PartId="@partId"
                              VolumeId="@VolumeId"
                              IsFirst="@(idx == 0)"
                              IsLast="@(idx == chapters.Count - 1)" />
            }
        </MudExpansionPanels>;

}
