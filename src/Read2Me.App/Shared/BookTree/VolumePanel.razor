@using Read2Me.App.State
@using Read2Me.App.Shared.BookMenus
@inject BookHierarchyPresenter Presenter

@if (IsSingleVolume)
{
    @RenderVolumeBody(Volume)
}
else
{
    <MudExpansionPanel Expanded="@Presenter.IsExpanded(BookNodeLevel.Volume, Volume.Id)"
                      ExpandedChanged="@VolumeExpandCb">
        <TitleContent>
            <NodeTitleRow FolderId="@FolderId"
                          NodeId="@Volume.Id"
                          Level="BookNodeLevel.Volume"
                          Title="@(Volume.Title ?? "Volume")"
                          Spec="@BookNodeMenuSpecs.ForVolume(FolderId, Volume)"
                          IsFirst="IsFirst"
                          IsLast="IsLast" />
        </TitleContent>
        <ChildContent>
            @RenderVolumeBody(Volume)
        </ChildContent>
    </MudExpansionPanel>
}

@code {
    [Parameter, EditorRequired] public Volume Volume { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectFolderId FolderId { get; set; }
    [Parameter, EditorRequired] public bool IsSingleVolume { get; set; }
    [Parameter, EditorRequired] public bool IsFirst { get; set; }
    [Parameter, EditorRequired] public bool IsLast { get; set; }

    EventCallback<bool> VolumeExpandCb =>
        EventCallback.Factory.Create<bool>(this, (bool b) => Presenter.SetNodeExpandedAsync(BookNodeLevel.Volume, Volume.Id, b));

    RenderFragment RenderVolumeBody(Volume vol) =>
        @<text>
            @if (Presenter.IsExpanding(vol.Id))
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
            }
            else if (Presenter.Parts(vol.Id) is { } parts)
            {
                <PartPanel Parts="@parts"
                           FolderId="@FolderId"
                           VolumeId="@vol.Id" />
            }
        </text>;

}
