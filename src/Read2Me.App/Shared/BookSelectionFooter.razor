@using Read2Me.App.State
@using Read2Me.Data.Entities
@using Read2Me.Services.Characters
@inject BookHierarchyPresenter Presenter
@inject CharacterQueueService Queue
@implements IDisposable

@{
    var snap = Queue.Snapshot();
    var queueBarActive = snap.QueuedCount > 0 || snap.ProcessingCount > 0;
    var bottomOffset = queueBarActive ? "38px" : "0";
}

@if (Presenter.SelectedParagraphCount > 0)
{
    <div style="position:fixed; bottom:@bottomOffset; left:0; right:0; z-index:1300;
                background:var(--mud-palette-surface);
                border-top:1px solid var(--mud-palette-divider);
                box-shadow:0 -2px 8px rgba(0,0,0,0.15);
                padding:8px 16px;
                display:flex; align-items:center; gap:12px; flex-wrap:wrap;">

        <MudText Typo="Typo.body2">
            <b>@Presenter.SelectedParagraphCount</b> paragraph@(Presenter.SelectedParagraphCount == 1 ? "" : "s") selected
        </MudText>

        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   OnClick="AddToQueue">
            Add to Character queue
        </MudButton>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Presenter.StateChanged += Refresh;
    }

    Task AddToQueue() => Presenter.AddSelectionToCharacterQueue();

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Presenter.StateChanged -= Refresh;
    }
}
