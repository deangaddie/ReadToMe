@using Read2Me.App.State
@using Read2Me.Services.Audio
@using Read2Me.Services.Characters
@inject BookHierarchyPresenter Presenter
@inject CharacterQueueService Queue
@inject AudioQueueService AudioQueue
@implements IDisposable

@{
    var snap = Queue.Snapshot();
    var audioSnap = AudioQueue.Snapshot();
    var charBarActive = snap.QueuedCount > 0 || snap.ProcessingCount > 0;
    var audioBarActive = audioSnap.QueuedCount > 0 || audioSnap.ProcessingCount > 0;
    var activeBars = (charBarActive ? 1 : 0) + (audioBarActive ? 1 : 0);
    var bottomOffset = activeBars switch { 2 => "76px", 1 => "38px", _ => "0" };
    var isAudioMode = Presenter.ViewMode == BookViewMode.SplitAudio;
    var audioCount = Presenter.SelectedAudioItemCount;
    var attrCount = Presenter.SelectedParagraphCount;
    var showFooter = isAudioMode ? audioCount > 0 : attrCount > 0;
}

@if (showFooter)
{
    <div style="position:fixed; bottom:@bottomOffset; left:0; right:0; z-index:1300;
                background:var(--mud-palette-surface);
                border-top:1px solid var(--mud-palette-divider);
                box-shadow:0 -2px 8px rgba(0,0,0,0.15);
                padding:8px 16px;
                display:flex; align-items:center; gap:12px; flex-wrap:wrap;">

        @if (isAudioMode)
        {
            <MudText Typo="Typo.body2">
                <b>@audioCount</b> item@(audioCount == 1 ? "" : "s") selected
            </MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.GraphicEq"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       OnClick="AddToAudioQueue">
                Add to Audio queue
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2">
                <b>@attrCount</b> paragraph@(attrCount == 1 ? "" : "s") selected
            </MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       OnClick="AddToCharacterQueue">
                Add to Character queue
            </MudButton>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Presenter.StateChanged += Refresh;
        AudioQueue.Changed += Refresh;
    }

    Task AddToCharacterQueue() => Presenter.AddSelectionToCharacterQueueAsync();
    Task AddToAudioQueue() => Presenter.AddSelectionToAudioQueueAsync();

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Presenter.StateChanged -= Refresh;
        AudioQueue.Changed -= Refresh;
    }
}
