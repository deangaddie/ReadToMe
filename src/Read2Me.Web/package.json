{
  "name": "read2me-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "build": "bun build.ts",
    "lint": "bun --bun oxlint --type-aware",
    "format": "bun --bun oxfmt",
    "format:check": "bun --bun oxfmt --check",
    "typecheck": "bun --bun x tsc --noEmit",
    "test": "bun test",
    "api:types": "bun --bun x openapi-typescript src/app/api/openapi.json -o src/app/api/schema.d.ts",
    "icons": "bun scripts/icons.ts",
    "icons:check": "bun scripts/icons.ts --check",
    "help": "bun scripts/help.ts",
    "help:check": "bun scripts/help.ts --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run icons:check && bun run help:check && bun run test && bun run build"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@preact/signals-core": "^1.14.0",
    "lit-html": "^3.3.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.4",
    "@typescript/typescript6": "6.0.2",
    "eslint-plugin-lit": "2.3.1",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "openapi-typescript@7.13.0": "patches/openapi-typescript@7.13.0.patch"
  }
}
