# Stage 1: deps — only rebuilds when requirements.txt changes
# chatterbox-tts 0.1.7 hard-pins torch==2.6.0 (for python < 3.14), so the base
# image is the newest CUDA build that ships exactly that torch.
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime@sha256:f894dae26e1ee8557c544f9cfdb9dc011b1552bf3c1e656b422f2e221d380e40 AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY chatterbox/requirements.txt .

RUN pip install --no-cache-dir --require-hashes -r requirements.txt
RUN pip uninstall -y torchvision || true

# Stage 2: app — rebuilds on app file changes, deps layer reused
FROM deps AS app

ARG APP_MODULE=app
ENV APP_MODULE=${APP_MODULE}

RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/logs /cache && \
    chown -R appuser:appuser /app /cache

COPY --chown=appuser:appuser chatterbox/app.py chatterbox/app_turbo.py ./

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health', timeout=5).raise_for_status()" || exit 1

CMD uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port 8000
