# Stage 1: deps — only rebuilds when requirements.txt changes
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY chatterbox/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "transformers>=4.40.0,<5.0.0" && \
    pip uninstall -y torchvision || true

# Stage 2: app — rebuilds on app file changes, deps layer reused
FROM deps AS app

ARG APP_MODULE=app
ENV APP_MODULE=${APP_MODULE}

RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/logs /cache && \
    chown -R appuser:appuser /app /cache

COPY --chown=appuser:appuser chatterbox/app.py chatterbox/app_turbo.py ./

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health', timeout=5).raise_for_status()" || exit 1

CMD uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port 8000
