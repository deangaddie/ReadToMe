# torch/torchaudio: exact base-image build (2.6.0+cu126) by direct hashed wheel URL, so
# PyPI stays the ONLY index — no --extra-index-url, no dependency-confusion surface, and
# none of the PyTorch mirror's stale requests/certifi/urllib3 copies can win the resolution.
torch @ https://download.pytorch.org/whl/cu126/torch-2.6.0%2Bcu126-cp311-cp311-manylinux_2_28_x86_64.whl
torchaudio @ https://download.pytorch.org/whl/cu126/torchaudio-2.6.0%2Bcu126-cp311-cp311-linux_x86_64.whl
