# Stage 1: deps — only rebuilds when requirements.txt changes
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime@sha256:bfbb4a2b4fdba0fefdb428ea737e626d61bb3daf74a16e1ff935bdb03aa7c3f0 AS deps

WORKDIR /app

# The base image is a plain Ubuntu system python, which marks itself PEP 668
# externally-managed; there is no virtualenv to fall back on inside the image.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY qwen3/requirements.txt .

# torch and torchaudio (matching cu130 build) enter the lock as direct hashed
# wheel URLs, so this single hashed install covers the whole closure.
RUN pip install --no-cache-dir --require-hashes -r requirements.txt
RUN pip uninstall -y torchvision || true

# Stage 2: app — rebuilds on every app.py change, deps layer reused
FROM deps AS app

# uid 1000 already exists in the base image as "ubuntu" — reuse it rather than
# adding a second unprivileged user.
RUN mkdir -p /app/logs /cache && \
    chown -R ubuntu:ubuntu /app /cache

ARG APP_MODULE=app
ARG APP_PORT=8100

COPY --chown=ubuntu:ubuntu qwen3/app.py qwen3/app_base.py ./

ENV APP_MODULE=${APP_MODULE}
ENV APP_PORT=${APP_PORT}

USER ubuntu

EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:'+'${APP_PORT}'+'/health', timeout=5).raise_for_status()" || exit 1

CMD ["sh", "-c", "uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port ${APP_PORT}"]
