FROM python:3.13-slim@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962 AS deps

WORKDIR /app

# No apt layer: git was the sole install and no VCS dep remains.
COPY minilm-l6/requirements.txt .
# CPU-only service — torch enters the lock as a direct hashed cpu-wheel URL.
# pip goes once the lock is installed: nothing at runtime calls it, and its vendored
# msgpack/urllib3 were the only Python highs left after the 2026-10-26 sweep (#51).
RUN pip install --no-cache-dir --require-hashes -r requirements.txt && \
    pip uninstall -y pip

FROM deps AS runtime

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app /cache && chown -R app:app /app /cache /home/app

COPY --chown=app:app minilm-l6/app.py .

USER app

EXPOSE 8200

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8200/docs', timeout=5).status==200 else 1)" || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8200"]
