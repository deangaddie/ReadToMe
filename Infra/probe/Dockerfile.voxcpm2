# PROBE COPY of Dockerfile.voxcpm2 — smoke test for issue 10.
# Deltas: USER app (10001) replaces ubuntu (1000); gcc/g++ purged in the app stage
# (issue 09); healthcheck on stdlib urllib; server.py comes from probe/ (load_denoiser=False).
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime AS deps

WORKDIR /app

ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY voxcpm2/requirements.txt .

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu130 \
        torchaudio==2.11.0 && \
    pip install --no-cache-dir -r requirements.txt
RUN pip uninstall -y torchvision || true

FROM deps AS app

# Build tools are not runtime surface — purge them once the wheels are built.
RUN apt-get purge -y gcc g++ && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app/logs /uploads /cache && \
    chown -R app:app /app /uploads /cache /home/app

COPY --chown=app:app probe/server.py ./server.py

ENV HF_HOME=/cache
ENV UPLOAD_DIR=/uploads
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

USER app

EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8003/health', timeout=5)" || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8003"]
