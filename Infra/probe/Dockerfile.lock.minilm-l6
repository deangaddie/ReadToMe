# PROBE — issue 11: hashed-lock build for minilm-l6.
# Deltas vs probe/Dockerfile.minilm-l6: digest-pinned base, --require-hashes install.
FROM python:3.13-slim@sha256:bffeb7bd6a85767587059c6ba23e1e9122078e3aa3fa836099171b9bb5a9bb00 AS deps

WORKDIR /app

COPY probe/lock/minilm-l6/requirements.txt .
RUN pip install --no-cache-dir --require-hashes \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

FROM deps AS runtime

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app /cache && chown -R app:app /app /cache /home/app

COPY --chown=app:app minilm-l6/app.py .

USER app

EXPOSE 8200

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8200"]
