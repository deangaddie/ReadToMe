# PROBE — issue 11: hashed-lock build for chatterbox.
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime@sha256:f894dae26e1ee8557c544f9cfdb9dc011b1552bf3c1e656b422f2e221d380e40 AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY probe/lock/chatterbox/requirements.txt .

RUN pip install --no-cache-dir --require-hashes \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
        -r requirements.txt
RUN pip uninstall -y torchvision || true

FROM deps AS app

ARG APP_MODULE=app
ENV APP_MODULE=${APP_MODULE}

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app/logs /cache && \
    chown -R app:app /app /cache /home/app

COPY --chown=app:app chatterbox/app.py chatterbox/app_turbo.py ./

USER app

EXPOSE 8000

CMD uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port 8000
