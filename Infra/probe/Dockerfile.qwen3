# PROBE COPY of Dockerfile.qwen3 — smoke test for issue 10.
# Deltas: USER app (10001) replaces ubuntu (1000); healthcheck on stdlib urllib.
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime AS deps

WORKDIR /app

ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY qwen3/requirements.txt .

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu130 \
        torchaudio==2.11.0 && \
    pip install --no-cache-dir -r requirements.txt
RUN pip uninstall -y torchvision || true

FROM deps AS app

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app/logs /cache && \
    chown -R app:app /app /cache /home/app

ARG APP_MODULE=app
ARG APP_PORT=8100

COPY --chown=app:app probe/qwen3/app.py probe/qwen3/app_base.py ./

ENV APP_MODULE=${APP_MODULE}
ENV APP_PORT=${APP_PORT}

USER app

EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://localhost:'+os.environ['APP_PORT']+'/health', timeout=5)" || exit 1

CMD ["sh", "-c", "uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port ${APP_PORT}"]
