# PROBE COPY of Dockerfile.mpnet-base-v2 — smoke test for issue 10.
# Deltas: no git (issue 09 — vestigial); USER app (10001); urllib healthcheck.
FROM python:3.13-slim AS deps

WORKDIR /app

COPY mpnet-base-v2/requirements.txt .
# CPU-only service — the CPU wheel index keeps the CUDA runtime wheels out.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

FROM deps AS runtime

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app /cache && chown -R app:app /app /cache /home/app

COPY --chown=app:app mpnet-base-v2/app.py .

USER app

EXPOSE 8201

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8201/docs', timeout=5)" || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8201"]
