# PROBE COPY of Dockerfile.chatterbox — smoke test for issue 10.
# Deltas: USER app (10001) replaces appuser (1000); healthcheck on stdlib urllib.
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY chatterbox/requirements.txt .

RUN pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
        -r requirements.txt
RUN pip uninstall -y torchvision || true

FROM deps AS app

ARG APP_MODULE=app
ENV APP_MODULE=${APP_MODULE}

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app/logs /cache && \
    chown -R app:app /app /cache /home/app

COPY --chown=app:app chatterbox/app.py chatterbox/app_turbo.py ./

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

CMD uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port 8000
