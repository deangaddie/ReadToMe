# PROBE — issue 11 variant B for voxcpm2: PyPI-only index, direct hashed torch URLs,
# datasets override (voxcpm 2.0.3 vs its own `spaces` dep), and NO gcc/g++.
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime@sha256:bfbb4a2b4fdba0fefdb428ea737e626d61bb3daf74a16e1ff935bdb03aa7c3f0 AS deps

WORKDIR /app
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY probe/lock/voxcpm2/requirements-direct.txt ./requirements.txt

RUN pip install --no-cache-dir --require-hashes -r requirements.txt
RUN pip uninstall -y torchvision || true

FROM deps AS app

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app/logs /uploads /cache && \
    chown -R app:app /app /uploads /cache /home/app

COPY --chown=app:app probe/server.py ./server.py

ENV HF_HOME=/cache
ENV UPLOAD_DIR=/uploads
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

USER app

EXPOSE 8003

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8003"]
