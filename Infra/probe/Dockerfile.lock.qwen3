# PROBE — issue 11: hashed-lock build for qwen3.
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime@sha256:bfbb4a2b4fdba0fefdb428ea737e626d61bb3daf74a16e1ff935bdb03aa7c3f0 AS deps

WORKDIR /app
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg=7:* \
    libsndfile1=1.* \
    && rm -rf /var/lib/apt/lists/*

COPY probe/lock/qwen3/requirements.txt .

# One install, one index set. torch/torchaudio are pinned in the lock to the exact
# build the base image ships, so pip should report them already satisfied.
RUN pip install --no-cache-dir --require-hashes \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        -r requirements.txt
RUN pip uninstall -y torchvision || true

FROM deps AS app

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app/logs /cache && \
    chown -R app:app /app /cache /home/app

ARG APP_MODULE=app
ARG APP_PORT=8100

COPY --chown=app:app probe/qwen3/app.py probe/qwen3/app_base.py ./

ENV APP_MODULE=${APP_MODULE}
ENV APP_PORT=${APP_PORT}

USER app

EXPOSE ${APP_PORT}

CMD ["sh", "-c", "uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port ${APP_PORT}"]
