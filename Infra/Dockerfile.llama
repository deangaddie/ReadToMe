ARG UBUNTU_VERSION=24.04
ARG CUDA_VERSION=13.3.0
ARG BASE_CUDA_DEV_CONTAINER=nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}@sha256:ef2203909e80b8b976cfc672f7e2ae2b00bc0e25c404ee86d89e10a3802f1c52
ARG BASE_CUDA_RUN_CONTAINER=nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}@sha256:789e629e49401647e22b7054ae9c6c4f6427dba68010ba428deb4cc6b063676e

FROM ${BASE_CUDA_DEV_CONTAINER} AS builder

ARG CUDA_DOCKER_ARCH=default
ARG LLAMA_FORK_SHA=4503343ffc05c09f6b50c309c8ecbabb49c66ea2

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc-14 g++-14 build-essential cmake python3 python3-pip git libssl-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-14 CXX=g++-14 CUDAHOSTCXX=g++-14

WORKDIR /build

RUN git init . && \
    git remote add origin https://github.com/TheTom/llama-cpp-turboquant.git && \
    git fetch --depth=1 origin ${LLAMA_FORK_SHA} && \
    git checkout --detach FETCH_HEAD

# The embedded Web UI is skipped: the shallow clone has no build number, so the
# prebuilt-asset fetch resolves to a nonexistent version and fails the build.
# Only the OpenAI-compatible API is used here.
RUN if [ "${CUDA_DOCKER_ARCH}" != "default" ]; then \
        export CMAKE_ARGS="-DCMAKE_CUDA_ARCHITECTURES=${CUDA_DOCKER_ARCH}"; \
    fi && \
    cmake -B build \
        -DGGML_NATIVE=OFF \
        -DGGML_CUDA=ON \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_SERVER=ON \
        -DLLAMA_BUILD_UI=OFF \
        -DLLAMA_USE_PREBUILT_UI=OFF \
        -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
        -DCMAKE_BUILD_TYPE=Release \
        ${CMAKE_ARGS} . && \
    cmake --build build --config Release -j$(nproc) --target llama-server --target llama-bench && \
    mkdir -p /build/lib && \
    find build -name "*.so*" -exec cp -P {} /build/lib/ \;

FROM ${BASE_CUDA_RUN_CONTAINER} AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# python3 dropped from the runtime — nothing calls it (llama-server is a binary,
# the entrypoint is bash); an unused interpreter only widens the RCE surface.
# curl stays: the HEALTHCHECK uses it and the AI watchdog shells it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgomp1 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /build/build/bin/llama-bench /usr/local/bin/llama-bench
COPY --from=builder /build/lib/ /usr/local/lib/
COPY llama/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && ldconfig

RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -d /home/app -s /usr/sbin/nologin app && \
    mkdir -p /app /logs && chown -R app:app /app /logs /home/app

WORKDIR /app
VOLUME ["/models", "/config", "/logs"]
EXPOSE 8080

HEALTHCHECK CMD [ "curl", "-f", "http://localhost:8080/health" ]

USER app

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
