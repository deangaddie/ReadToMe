# Stage 1: deps — only rebuilds when requirements.txt changes
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY voxcpm2/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt && \
    pip uninstall -y torchvision || true

# Stage 2: app — rebuilds on server.py changes, deps layer reused
FROM deps AS app

RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/logs /uploads /cache && \
    chown -R appuser:appuser /app /uploads /cache

COPY --chown=appuser:appuser voxcpm2/server.py ./

ENV HF_HOME=/cache
ENV UPLOAD_DIR=/uploads
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

USER appuser

EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD python -c "import requests; requests.get('http://localhost:8003/health', timeout=5).raise_for_status()" || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8003"]
