<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore uses nuget.org only. <clear/> drops every feed from the machine and
  user NuGet config, and the package source mapping sends every package ID to
  nuget.org, so a feed added later fails restore until it is mapped on purpose.

  Deliberately absent (both reasons in #406):
  - No packages.lock.json: scripts/review-deps.ps1 reports transitive changes
    (its NuGet check is #417), and the SDK isn't pinned, so locked mode would
    break as package pruning shifts between SDK versions.
  - No trustedSigners: risk-accepted.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
